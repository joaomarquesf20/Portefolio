@model ShotsByMarques.Web.ViewModels.CheckoutIndexViewModel
@{
    ViewData["Title"] = SharedLocalizer["CheckoutTitle"];
    var ptPT = new System.Globalization.CultureInfo("pt-PT");
    var ids = string.Join(",", Model.Items.Select(i => i.PhotoId));
}

<section class="px-5 pb-24 pt-16 sm:px-8 lg:px-12">
    <div class="flex justify-center">
        <div class="w-full max-w-[42rem]">
            <div class="rv mb-10">
                <p class="inline-flex items-center gap-3 text-[11px] font-medium uppercase tracking-[0.4em] text-black/50">
                    <span class="rule inline-block h-px w-10"></span>
                    Carrinho
                </p>
                <h1 class="mt-5 font-display text-4xl font-bold tracking-[-0.04em] text-[#141414]">@SharedLocalizer["CheckoutTitle"]</h1>
            </div>

            @if (!Model.StripeConfigured)
            {
                <div class="rv border border-red-600/25 bg-red-600/[0.06] text-red-700 px-5 py-4 text-sm mb-8">
                    ◉ @SharedLocalizer["StripeNotConfigured"]
                </div>
            }

            @if (Model.Items.Count == 0)
            {
                <p class="rv text-black/50">@SharedLocalizer["CheckoutEmpty"]</p>
                <a href="/portfolio" class="btn-outline rv rv-d1 mt-6 inline-block">@SharedLocalizer["GoHome"]</a>
            }
            else
            {
                <div class="rv space-y-4 mb-8">
                    @foreach (var item in Model.Items)
                    {
                        <div class="card p-4 flex items-center gap-4 checkout-item" data-photo-id="@item.PhotoId">
                            <img src="@item.PreviewUrl" alt="@item.Title" class="w-20 h-14 object-cover rounded-lg" />
                            <div class="flex-1 min-w-0">
                                <p class="font-medium text-[#141414] text-sm truncate">@item.Title</p>
                                <p class="text-black/45 text-xs truncate">@item.GalleryTitle</p>
                            </div>
                            <span class="text-[#a1843f] font-semibold tabular-nums text-sm shrink-0">@item.Price.ToString("C", new System.Globalization.CultureInfo("pt-PT"))</span>
                            <button type="button" class="remove-item-btn text-red-700 transition hover:text-red-900 text-sm shrink-0"
                                    title="@SharedLocalizer["RemoveItem"]">✕</button>
                        </div>
                    }
                </div>

                <div class="card rv rv-d1 p-6 mb-8">
                    <div class="space-y-2">
                        <div class="flex justify-between text-sm">
                            <span class="text-black/55">@SharedLocalizer["Subtotal"] (@Model.Items.Count)</span>
                            <span class="tabular-nums">@Model.Subtotal.ToString("C", ptPT)</span>
                        </div>

                        @if (Model.Discount > 0)
                        {
                            <div class="flex justify-between text-sm text-emerald-700">
                                <span>Pack · @Model.PackName</span>
                                <span class="tabular-nums">−@Model.Discount.ToString("C", ptPT)</span>
                            </div>
                        }
                        else if (Model.MinPackPhotos.HasValue)
                        {
                            <p class="text-black/40 text-xs">@SharedLocalizer["PackHint"] @Model.MinPackPhotos+ @SharedLocalizer["PhotosCount"]</p>
                        }

                        <div id="promo-discount-row" class="hidden">
                            <div class="flex justify-between text-sm text-emerald-600">
                                <span><span>@SharedLocalizer["Discount"]</span> · <span id="promo-code-label"></span></span>
                                <span class="tabular-nums" id="promo-discount-value"></span>
                            </div>
                        </div>

                        <div class="border-t border-black/10 pt-3 flex justify-between text-lg font-semibold">
                            <span class="text-[#141414]">@SharedLocalizer["Total"]</span>
                            <span id="checkout-total" class="text-[#a1843f] font-display tabular-nums">@Model.Total.ToString("C", ptPT)</span>
                        </div>
                    </div>
                    <p class="text-black/40 text-xs mt-2">@SharedLocalizer["HighRes"] · @SharedLocalizer["FreeDelivery"]</p>

                    <form id="promo-form" asp-action="ValidateDiscount" method="post" class="mt-5 border-t border-black/10 pt-5"
                          data-base-price="@Model.Total.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="BasePrice"
                               value="@Model.Total.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" />
                        <label class="block text-xs font-semibold uppercase tracking-[0.16em] text-black/50"
                               for="promo-code">@SharedLocalizer["PromoCode"]</label>
                        <div class="mt-2 flex flex-col gap-2 sm:flex-row">
                            <input id="promo-code" name="Code" type="text" maxlength="50" autocomplete="off" required
                                   placeholder="@SharedLocalizer["PromoCode"]"
                                   class="flex-1 rounded-lg border border-black/10 bg-white px-4 py-2.5 text-sm text-[#141414] transition focus:border-[#a1843f] focus:outline-none focus:ring-2 focus:ring-[#a1843f]/20" />
                            <button type="submit" id="apply-promo-btn"
                                    class="rounded-xl bg-black px-6 py-2.5 text-sm font-semibold text-white transition duration-300 hover:bg-[#a1843f]">
                                @SharedLocalizer["Apply"]
                            </button>
                        </div>
                        <p class="mt-2 text-xs text-black/40">@SharedLocalizer["PromoCodeHint"]</p>
                        <p id="promo-feedback" class="hidden mt-2 text-sm" aria-live="polite"></p>
                    </form>
                </div>

                <div class="rv rv-d2 text-center mb-4">
                    <button type="button" id="empty-cart-btn" class="text-black/40 transition hover:text-red-700 text-sm underline underline-offset-4">
                        @SharedLocalizer["EmptyCart"]
                    </button>
                </div>

                <form asp-action="PlaceOrder" method="post" class="text-center">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ids" value="@ids" />
                    @* Mirrors the validated promo code so the server applies the
                       same discount as the summary shows (re-validated server-side). *@
                    <input type="hidden" name="promo" id="promo-payload" value="" />
                    <button type="submit" class="btn-primary w-full sm:w-auto sm:px-12" @(Model.StripeConfigured ? "" : "disabled style=opacity:.4;pointer-events:none")>
                        @SharedLocalizer["PayNow"] — <span id="pay-cta-total">@Model.Total.ToString("C", new System.Globalization.CultureInfo("pt-PT"))</span>
                    </button>
                </form>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var confirmEmpty = "@SharedLocalizer["ConfirmEmptyCart"]";

            // Remove a single photo from the localStorage cart and reload the
            // checkout with the remaining ids.
            document.querySelectorAll(".remove-item-btn").forEach(function (btn) {
                btn.addEventListener("click", function () {
                    var item = btn.closest(".checkout-item");
                    var photoId = Number(item.dataset.photoId);
                    removeFromCart(photoId);
                    var remaining = Array.from(document.querySelectorAll(".checkout-item"))
                        .filter(function (el) { return el !== item; })
                        .map(function (el) { return el.dataset.photoId; });
                    window.location.href = remaining.length
                        ? "/Checkout?ids=" + remaining.join(",")
                        : "/Checkout";
                });
            });

            // Empty the whole cart.
            var emptyBtn = document.getElementById("empty-cart-btn");
            if (emptyBtn) {
                emptyBtn.addEventListener("click", function () {
                    if (!confirm(confirmEmpty)) return;
                    clearCart();
                    window.location.href = "/Checkout";
                });
            }

            // Validate a promo code asynchronously and refresh the totals.
            var promoForm = document.getElementById("promo-form");
            var promoBtn = document.getElementById("apply-promo-btn");
            var promoInput = document.getElementById("promo-code");
            var promoFeedback = document.getElementById("promo-feedback");
            var promoRow = document.getElementById("promo-discount-row");
            var promoCodeLabel = document.getElementById("promo-code-label");
            var promoDiscountValue = document.getElementById("promo-discount-value");
            var totalElement = document.getElementById("checkout-total");
            var payCtaTotal = document.getElementById("pay-cta-total");
            var promoPayload = document.getElementById("promo-payload");

            var moneyFormatter = new Intl.NumberFormat("pt-PT", {
                style: "currency",
                currency: "EUR",
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
            var fallbackTotal = totalElement ? totalElement.textContent : "";

            if (!promoForm || !promoBtn || !promoInput || !promoFeedback || !promoRow || !promoCodeLabel || !promoDiscountValue || !totalElement) return;

            var applyTotals = function (finalPriceText, appliedCode) {
                totalElement.textContent = finalPriceText;
                if (payCtaTotal) payCtaTotal.textContent = finalPriceText;
                if (promoPayload) promoPayload.value = appliedCode || "";
            };

            var setFeedback = function (message, isSuccess) {
                if (!promoFeedback) return;
                promoFeedback.textContent = message;
                promoFeedback.classList.toggle("hidden", !message);
                promoFeedback.classList.toggle("text-emerald-700", isSuccess);
                promoFeedback.classList.toggle("text-red-700", !isSuccess);
            };

            var responseValue = function (payload, name) {
                if (!payload) return null;
                return payload[name] !== undefined ? payload[name] : payload[name.charAt(0).toUpperCase() + name.slice(1)];
            };

            var showPromoRow = function (show) {
                promoRow.classList.toggle("hidden", !show);
            };

            promoForm.addEventListener("submit", async function (event) {
                event.preventDefault();
                if (!promoInput.value.trim()) return;

                promoBtn.disabled = true;
                setFeedback("Validando código promocional...", true);
                try {
                    var response = await fetch(promoForm.action, {
                        method: "POST",
                        body: new FormData(promoForm)
                    });
                    if (!response.ok) {
                        showPromoRow(false);
                        applyTotals(fallbackTotal, "");
                        setFeedback("Não foi possível validar o código promocional. Tenta novamente.", false);
                        return;
                    }

                    var payload = await response.json();
                    var success = !!responseValue(payload, "success");
                    var message = responseValue(payload, "message") || "";
                    var finalPrice = Number(responseValue(payload, "finalPrice") ?? 0);
                    var discount = Number(responseValue(payload, "discountAmount") ?? 0);

                    showPromoRow(success && discount > 0);
                    if (success) {
                        promoCodeLabel.textContent = promoInput.value.trim().toUpperCase();
                        promoDiscountValue.textContent = "−" + moneyFormatter.format(discount);
                        applyTotals(moneyFormatter.format(finalPrice), promoInput.value.trim());
                    } else {
                        promoCodeLabel.textContent = "";
                        promoDiscountValue.textContent = "";
                        applyTotals(fallbackTotal, "");
                    }
                    setFeedback(message, success);
                } catch (error) {
                    showPromoRow(false);
                    applyTotals(fallbackTotal, "");
                    setFeedback("Não foi possível validar o código promocional. Tenta novamente.", false);
                } finally {
                    promoBtn.disabled = false;
                }
            });
        })();
    </script>
}
