@model ShotsByMarques.Web.ViewModels.CheckoutIndexViewModel
@{
    ViewData["Title"] = SharedLocalizer["Finalizar compra"];
    var ptPT = new System.Globalization.CultureInfo("pt-PT");
    var ids = string.Join(",", Model.Items.Select(i => i.PhotoId));
}

@* iOS Safari/WebKit: the cart shell must paint immediately on load —
   no reveal opacity/transition locks, no min-height locks. WebKit can leave
   elements with a pending opacity/transform transition blank until a manual
   scroll forces a reflow; keep this page transition-free. *@
<style>
    .cart-shell { min-height: auto; }
</style>

<section class="cart-shell px-5 pb-24 pt-16 sm:px-8 lg:px-12">
    <div class="flex justify-center">
        <div class="w-full max-w-[42rem]">
            <div class="mb-10">
                <p class="inline-flex items-center gap-3 text-[11px] font-medium uppercase tracking-[0.4em] text-black/50">
                    <span class="rule inline-block h-px w-10"></span>
                    Carrinho
                </p>
                <h1 class="mt-5 font-display text-4xl font-bold tracking-[-0.04em] text-[#141414]">@SharedLocalizer["Finalizar compra"]</h1>
            </div>

            @if (!Model.StripeConfigured)
            {
                <div class="border border-red-600/25 bg-red-600/[0.06] text-red-700 px-5 py-4 text-sm mb-8">
                    ◉ @SharedLocalizer["As chaves do Stripe ainda não estão configuradas. Adiciona-as em appsettings.json (modo de teste)."]
                </div>
            }

            <div id="cart-empty" class="@(Model.Items.Count == 0 ? "" : "hidden")">
                <p class="text-black/50">@SharedLocalizer["Não tens fotos selecionadas. Escolhe as tuas favoritas numa galeria."]</p>
                <a href="/portfolio" class="btn-outline mt-6 inline-block">@SharedLocalizer["Voltar ao início"]</a>
            </div>

            <div id="cart-content" class="@(Model.Items.Count == 0 ? "hidden" : "")">
                <div class="space-y-4 mb-8">
                    @foreach (var item in Model.Items)
                    {
                        <div class="card p-4 flex items-center gap-4 checkout-item" data-photo-id="@item.PhotoId">
                            <img src="@item.PreviewUrl" alt="@item.Title" class="w-20 h-14 object-cover rounded-lg" />
                            <div class="flex-1 min-w-0">
                                <p class="font-medium text-[#141414] text-sm truncate">@item.Title</p>
                                <p class="text-black/45 text-xs truncate">@item.GalleryTitle</p>
                            </div>
                            <span class="text-[#a1843f] font-semibold tabular-nums text-sm shrink-0">@item.Price.ToString("C", new System.Globalization.CultureInfo("pt-PT"))</span>
                            <button type="button" class="remove-item-btn text-red-700 transition hover:text-red-900 text-sm shrink-0"
                                    title="@SharedLocalizer["Remover"]">✕</button>
                        </div>
                    }
                </div>

                <div class="card p-6 mb-8">
                    <div class="space-y-2">
                        <div class="flex justify-between text-sm">
                            <span id="checkout-subtotal-text" data-label="@SharedLocalizer["Subtotal"]" class="text-black/55">@SharedLocalizer["Subtotal"] (@Model.Items.Count)</span>
                            <span id="checkout-subtotal" class="tabular-nums">@Model.Subtotal.ToString("C", ptPT)</span>
                        </div>

                        <div id="pack-discount-row" class="flex justify-between text-sm text-emerald-700 @(Model.Discount > 0 ? "" : "hidden")">
                            <span>Pack · <span id="pack-name">@Model.PackName</span></span>
                            <span class="tabular-nums" id="pack-discount-value">−@Model.Discount.ToString("C", ptPT)</span>
                        </div>
                        <p id="pack-hint" data-prefix="@SharedLocalizer["Compra"]" data-suffix="@SharedLocalizer["fotos"]"
                           class="text-black/40 text-xs @(Model.Discount > 0 ? "hidden" : "")">
                            @SharedLocalizer["Compra"] @Model.MinPackPhotos+ @SharedLocalizer["fotos"]
                        </p>

                        <div id="promo-discount-row" class="hidden">
                            <div class="flex justify-between text-sm text-emerald-600">
                                <span><span>@SharedLocalizer["Desconto"]</span> · <span id="promo-code-label"></span></span>
                                <span class="tabular-nums" id="promo-discount-value"></span>
                            </div>
                        </div>

                        <div class="border-t border-black/10 pt-3 flex justify-between text-lg font-semibold">
                            <span class="text-[#141414]">@SharedLocalizer["Total"]</span>
                            <span id="checkout-total" class="text-[#a1843f] font-display tabular-nums">@Model.Total.ToString("C", ptPT)</span>
                        </div>
                    </div>
                    <p class="text-black/40 text-xs mt-2">@SharedLocalizer["Alta resolução"] · @SharedLocalizer["Entrega digital"]</p>

                    <form id="promo-form" asp-action="ValidateDiscount" method="post" class="mt-5 border-t border-black/10 pt-5"
                          data-base-price="@Model.Total.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="promo-base-price" name="BasePrice"
                               value="@Model.Total.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" />
                        <label class="block text-xs font-semibold uppercase tracking-[0.16em] text-black/50"
                               for="promo-code">@SharedLocalizer["Código promocional"]</label>
                        <div class="mt-2 flex flex-col gap-2 sm:flex-row">
                            <input id="promo-code" name="Code" type="text" maxlength="50" autocomplete="off" required
                                   placeholder="@SharedLocalizer["Código promocional"]"
                                   class="flex-1 rounded-lg border border-black/10 bg-white px-4 py-2.5 text-sm text-[#141414] transition focus:border-[#a1843f] focus:outline-none focus:ring-2 focus:ring-[#a1843f]/20" />
                            <button type="submit" id="apply-promo-btn"
                                    class="rounded-xl bg-black px-6 py-2.5 text-sm font-semibold text-white transition duration-300 hover:bg-[#a1843f]">
                                @SharedLocalizer["Aplicar"]
                            </button>
                        </div>
                        <p class="mt-2 text-xs text-black/40">@SharedLocalizer["Experimenta o teu código promocional."]</p>
                        <p id="promo-feedback" class="hidden mt-2 text-sm" aria-live="polite"></p>
                    </form>
                </div>

                <div class="text-center mb-4">
                    <button type="button" id="empty-cart-btn" class="text-black/40 transition hover:text-red-700 text-sm underline underline-offset-4">
                        @SharedLocalizer["Esvaziar carrinho"]
                    </button>
                </div>

                <form asp-action="PlaceOrder" method="post" class="text-center">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="checkout-ids" name="ids" value="@ids" />
                    @* Mirrors the validated promo code so the server applies the
                       same discount as the summary shows (re-validated server-side). *@
                    <input type="hidden" name="promo" id="promo-payload" value="" />
                    <button type="submit" class="btn-primary w-full sm:w-auto sm:px-12" @(Model.StripeConfigured ? "" : "disabled style=opacity:.4;pointer-events:none")>
                        @SharedLocalizer["Pagar com cartão ou MB Way"] — <span id="pay-cta-total">@Model.Total.ToString("C", new System.Globalization.CultureInfo("pt-PT"))</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var confirmEmpty = "@SharedLocalizer["Tens a certeza que queres esvaziar o carrinho?"]";

            // Shared refs (dynamic totals + promo engine both use these).
            var moneyFormatter = new Intl.NumberFormat("pt-PT", {
                style: "currency",
                currency: "EUR",
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
            var byId = function (id) { return document.getElementById(id); };
            var contentEl = byId("cart-content");
            var emptyEl = byId("cart-empty");
            var subtotalTextEl = byId("checkout-subtotal-text");
            var subtotalEl = byId("checkout-subtotal");
            var packRow = byId("pack-discount-row");
            var packNameEl = byId("pack-name");
            var packValueEl = byId("pack-discount-value");
            var packHintEl = byId("pack-hint");
            var idsInput = byId("checkout-ids");
            var basePriceInput = byId("promo-base-price");
            var promoForm = document.getElementById("promo-form");
            var promoBtn = document.getElementById("apply-promo-btn");
            var promoInput = document.getElementById("promo-code");
            var promoFeedback = document.getElementById("promo-feedback");
            var promoRow = document.getElementById("promo-discount-row");
            var promoCodeLabel = document.getElementById("promo-code-label");
            var promoDiscountValue = document.getElementById("promo-discount-value");
            var totalElement = document.getElementById("checkout-total");
            var payCtaTotal = document.getElementById("pay-cta-total");
            var promoPayload = document.getElementById("promo-payload");
            var fallbackTotal = totalElement ? totalElement.textContent : "";

            var applyTotals = function (finalPriceText, appliedCode) {
                totalElement.textContent = finalPriceText;
                if (payCtaTotal) payCtaTotal.textContent = finalPriceText;
                if (promoPayload) promoPayload.value = appliedCode || "";
            };

            var setFeedback = function (message, isSuccess) {
                if (!promoFeedback) return;
                promoFeedback.textContent = message;
                promoFeedback.classList.toggle("hidden", !message);
                promoFeedback.classList.toggle("text-emerald-700", isSuccess);
                promoFeedback.classList.toggle("text-red-700", !isSuccess);
            };

            var responseValue = function (payload, name) {
                if (!payload) return null;
                return payload[name] !== undefined ? payload[name] : payload[name.charAt(0).toUpperCase() + name.slice(1)];
            };

            var showPromoRow = function (show) {
                promoRow.classList.toggle("hidden", !show);
            };

            // ----- Dynamic totals (no pricing math in JS: server truth) -----
            // Applies the summary payload served by /cart/remove (signed-in)
            // or Checkout/Summary (anonymous/fallback): { success, cartCount,
            // isEmpty, subtotal, discount, packName, minPackPhotos, totalAmount }.
            var applySummary = function (payload) {
                if (!payload || payload.success === false) return;
                var count = Number(responseValue(payload, "cartCount")) || 0;
                var totalAmount = Number(responseValue(payload, "totalAmount")) || 0;
                var discount = Number(responseValue(payload, "discount")) || 0;
                var totalText = moneyFormatter.format(totalAmount);

                if (subtotalTextEl) subtotalTextEl.textContent = subtotalTextEl.getAttribute("data-label") + " (" + count + ")";
                if (subtotalEl) subtotalEl.textContent = moneyFormatter.format(Number(responseValue(payload, "subtotal")) || 0);

                var packName = responseValue(payload, "packName");
                if (discount > 0 && packName) {
                    if (packRow) {
                        packRow.classList.remove("hidden");
                        if (packNameEl) packNameEl.textContent = packName;
                        if (packValueEl) packValueEl.textContent = "−" + moneyFormatter.format(discount);
                    }
                    if (packHintEl) packHintEl.classList.add("hidden");
                } else {
                    if (packRow) packRow.classList.add("hidden");
                    if (packHintEl) {
                        packHintEl.classList.remove("hidden");
                        var minPack = responseValue(payload, "minPackPhotos") || packHintEl.getAttribute("data-min") || "";
                        packHintEl.textContent = packHintEl.getAttribute("data-prefix") + " " + minPack + "+ " + packHintEl.getAttribute("data-suffix");
                    }
                }

                if (basePriceInput) basePriceInput.value = totalAmount.toFixed(2);
                if (promoForm) promoForm.setAttribute("data-base-price", totalAmount.toFixed(2));

                // A promo validated against the OLD total no longer matches —
                // clear its UI; the code can be re-applied for the new one.
                if (promoPayload) promoPayload.value = "";
                if (promoRow) promoRow.classList.add("hidden");
                if (promoFeedback) promoFeedback.classList.add("hidden");

                applyTotals(totalText, "");
                fallbackTotal = totalText;
                if (window.SBM && typeof window.SBM.forceRepaint === "function") window.SBM.forceRepaint();
            };

            var showEmptyState = function () {
                if (emptyEl) emptyEl.classList.remove("hidden");
                if (contentEl) contentEl.classList.add("hidden");
            };

            // ----- Dynamic removal (no page reload) -----
            document.querySelectorAll(".checkout-item").forEach(function (row) {
                var btn = row.querySelector(".remove-item-btn");
                if (!btn) return;
                btn.addEventListener("click", async function () {
                    if (btn.dataset.busy === "1") return;
                    btn.dataset.busy = "1";
                    var photoId = Number(row.dataset.photoId);
                    row.classList.add("removing");

                    // site.js: optimistic local removal + queued DB mutation.
                    // Signed-in callers resolve with the /cart/remove payload
                    // (totals included); null means anonymous or a missed POST.
                    var payload = await removeFromCart(photoId);
                    if (window.SBM && typeof window.SBM.forceRepaint === "function") window.SBM.forceRepaint();

                    var remainingIds = Array.prototype.map.call(
                        document.querySelectorAll(".checkout-item:not(.removing)"),
                        function (el) { return el.dataset.photoId; });
                    if (idsInput) idsInput.value = remainingIds.join(",");

                    if (!payload) {
                        try {
                            var response = await fetch("/Checkout/Summary?ids=" + encodeURIComponent(remainingIds.join(",")));
                            payload = response.ok ? await response.json() : null;
                        } catch (error) { payload = null; }
                    }
                    applySummary(payload);

                    var isEmptyNow = payload ? !!responseValue(payload, "isEmpty") : remainingIds.length === 0;
                    if (isEmptyNow) showEmptyState();

                    // Fade the row out, then physically drop it from the DOM.
                    row.style.transition = "opacity .22s ease, transform .22s ease";
                    row.style.opacity = "0";
                    row.style.transform = "translateY(6px)";
                    setTimeout(function () { row.remove(); }, 230);
                    btn.dataset.busy = "0";
                });
            });

            // Empty the whole cart dynamically (local + DB in site.js), then
            // swap to the empty-state block — no reload needed.
            var emptyBtn = document.getElementById("empty-cart-btn");
            if (emptyBtn) {
                emptyBtn.addEventListener("click", function () {
                    if (!confirm(confirmEmpty)) return;
                    clearCart();
                    showEmptyState();
                    if (window.SBM && typeof window.SBM.forceRepaint === "function") window.SBM.forceRepaint();
                });
            }

            // Validate a promo code asynchronously and refresh the totals.
            if (!promoForm || !promoBtn || !promoInput || !promoFeedback || !promoRow || !promoCodeLabel || !promoDiscountValue || !totalElement) return;

            promoForm.addEventListener("submit", async function (event) {
                event.preventDefault();
                if (!promoInput.value.trim()) return;

                promoBtn.disabled = true;
                setFeedback("Validando código promocional...", true);
                try {
                    var response = await fetch(promoForm.action, {
                        method: "POST",
                        body: new FormData(promoForm)
                    });
                    if (!response.ok) {
                        showPromoRow(false);
                        applyTotals(fallbackTotal, "");
                        setFeedback("Não foi possível validar o código promocional. Tenta novamente.", false);
                        return;
                    }

                    var payload = await response.json();
                    var success = !!responseValue(payload, "success");
                    var message = responseValue(payload, "message") || "";
                    var finalPrice = Number(responseValue(payload, "finalPrice") ?? 0);
                    var discount = Number(responseValue(payload, "discountAmount") ?? 0);

                    showPromoRow(success && discount > 0);
                    if (success) {
                        promoCodeLabel.textContent = promoInput.value.trim().toUpperCase();
                        promoDiscountValue.textContent = "−" + moneyFormatter.format(discount);
                        applyTotals(moneyFormatter.format(finalPrice), promoInput.value.trim());
                    } else {
                        promoCodeLabel.textContent = "";
                        promoDiscountValue.textContent = "";
                        applyTotals(fallbackTotal, "");
                    }
                    setFeedback(message, success);
                } catch (error) {
                    showPromoRow(false);
                    applyTotals(fallbackTotal, "");
                    setFeedback("Não foi possível validar o código promocional. Tenta novamente.", false);
                } finally {
                    promoBtn.disabled = false;
                }
            });
        })();
    </script>
}
