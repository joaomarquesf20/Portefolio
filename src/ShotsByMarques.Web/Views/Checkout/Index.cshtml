@model ShotsByMarques.Web.ViewModels.CheckoutIndexViewModel
@{
    ViewData["Title"] = SharedLocalizer["CheckoutTitle"];
    var ids = string.Join(",", Model.Items.Select(i => i.PhotoId));
}

<section class="px-5 pb-24 pt-16 sm:px-8 lg:px-12">
    <div class="flex justify-center">
        <div class="w-full max-w-[42rem]">
            <div class="rv mb-10">
                <p class="inline-flex items-center gap-3 text-[11px] font-medium uppercase tracking-[0.4em] text-black/50">
                    <span class="rule inline-block h-px w-10"></span>
                    Carrinho
                </p>
                <h1 class="mt-5 font-display text-4xl font-bold tracking-[-0.04em] text-[#141414]">@SharedLocalizer["CheckoutTitle"]</h1>
            </div>

            @if (!Model.StripeConfigured)
            {
                <div class="rv border border-red-600/25 bg-red-600/[0.06] text-red-700 px-5 py-4 text-sm mb-8">
                    ◉ @SharedLocalizer["StripeNotConfigured"]
                </div>
            }

            @if (Model.Items.Count == 0)
            {
                <p class="rv text-black/50">@SharedLocalizer["CheckoutEmpty"]</p>
                <a href="/portfolio" class="btn-outline rv rv-d1 mt-6 inline-block">@SharedLocalizer["GoHome"]</a>
            }
            else
            {
                <div class="rv space-y-4 mb-8">
                    @foreach (var item in Model.Items)
                    {
                        <div class="card p-4 flex items-center gap-4 checkout-item" data-photo-id="@item.PhotoId">
                            <img src="@item.PreviewUrl" alt="@item.Title" class="w-20 h-14 object-cover rounded-lg" />
                            <div class="flex-1 min-w-0">
                                <p class="font-medium text-[#141414] text-sm truncate">@item.Title</p>
                                <p class="text-black/45 text-xs truncate">@item.GalleryTitle</p>
                            </div>
                            <span class="text-[#a1843f] font-semibold tabular-nums text-sm shrink-0">@item.Price.ToString("C", new System.Globalization.CultureInfo("pt-PT"))</span>
                            <button type="button" class="remove-item-btn text-red-700 transition hover:text-red-900 text-sm shrink-0"
                                    title="@SharedLocalizer["RemoveItem"]">✕</button>
                        </div>
                    }
                </div>

                <div class="card rv rv-d1 p-6 mb-8">
                    <div class="space-y-2">
                        <div class="flex justify-between text-sm">
                            <span class="text-black/55">@SharedLocalizer["Subtotal"] (@Model.Items.Count)</span>
                            <span class="tabular-nums">@Model.Subtotal.ToString("C", new System.Globalization.CultureInfo("pt-PT"))</span>
                        </div>
                        @if (Model.Discount > 0)
                        {
                            <div class="flex justify-between text-sm text-emerald-700">
                                <span>Pack · @Model.PackName</span>
                                <span class="tabular-nums">−@Model.Discount.ToString("C", new System.Globalization.CultureInfo("pt-PT"))</span>
                            </div>
                        }
                        else if (Model.MinPackPhotos.HasValue)
                        {
                            <p class="text-black/40 text-xs">@SharedLocalizer["PackHint"] @Model.MinPackPhotos+ @SharedLocalizer["PhotosCount"]</p>
                        }
                        <div class="border-t border-black/10 pt-3 flex justify-between text-lg font-semibold">
                            <span class="text-[#141414]">@SharedLocalizer["Total"]</span>
                            <span class="text-[#a1843f] font-display tabular-nums">@Model.Total.ToString("C", new System.Globalization.CultureInfo("pt-PT"))</span>
                        </div>
                    </div>
                    <p class="text-black/40 text-xs mt-2">@SharedLocalizer["HighRes"] · @SharedLocalizer["FreeDelivery"]</p>
                </div>

                <div class="rv rv-d2 text-center mb-4">
                    <button type="button" id="empty-cart-btn" class="text-black/40 transition hover:text-red-700 text-sm underline underline-offset-4">
                        @SharedLocalizer["EmptyCart"]
                    </button>
                </div>

                <form asp-action="PlaceOrder" method="post" class="text-center">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ids" value="@ids" />
                    <button type="submit" class="btn-primary w-full sm:w-auto sm:px-12" @(Model.StripeConfigured ? "" : "disabled style=opacity:.4;pointer-events:none")>
                        @SharedLocalizer["PayNow"] — @Model.Total.ToString("C", new System.Globalization.CultureInfo("pt-PT"))
                    </button>
                </form>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var confirmEmpty = "@SharedLocalizer["ConfirmEmptyCart"]";

            // Remove a single photo from the localStorage cart and reload the
            // checkout with the remaining ids.
            document.querySelectorAll(".remove-item-btn").forEach(function (btn) {
                btn.addEventListener("click", function () {
                    var item = btn.closest(".checkout-item");
                    var photoId = Number(item.dataset.photoId);
                    removeFromCart(photoId);
                    var remaining = Array.from(document.querySelectorAll(".checkout-item"))
                        .filter(function (el) { return el !== item; })
                        .map(function (el) { return el.dataset.photoId; });
                    window.location.href = remaining.length
                        ? "/Checkout?ids=" + remaining.join(",")
                        : "/Checkout";
                });
            });

            // Empty the whole cart.
            var emptyBtn = document.getElementById("empty-cart-btn");
            if (emptyBtn) {
                emptyBtn.addEventListener("click", function () {
                    if (!confirm(confirmEmpty)) return;
                    clearCart();
                    window.location.href = "/Checkout";
                });
            }
        })();
    </script>
}
