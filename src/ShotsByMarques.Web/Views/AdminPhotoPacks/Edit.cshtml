@model ShotsByMarques.Web.Models.PhotoPack
@{
    ViewData["Title"] = SharedLocalizer["Edit"];
}

<section class="max-w-2xl mx-auto px-4 sm:px-6 py-12">
    <a href="/AdminPhotoPacks" class="text-white/50 hover:text-accent text-sm transition">← @SharedLocalizer["Back"]</a>
    <h1 class="font-display text-4xl mt-3 mb-8 fade-up">@SharedLocalizer["Edit"] — @Model.Name</h1>

    <form asp-action="Edit" method="post" class="card p-8 space-y-5 fade-up">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-red-400 text-sm"></div>

        <div>
            <label asp-for="Name" class="block text-sm font-medium mb-2"></label>
            <input asp-for="Name" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 focus:outline-none focus:border-accent transition" />
            <span asp-validation-for="Name" class="text-red-400 text-xs"></span>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label asp-for="MinPhotos" class="block text-sm font-medium mb-2">Mínimo de fotos</label>
                <input asp-for="MinPhotos" type="number" min="2" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 focus:outline-none focus:border-accent transition" />
                <span asp-validation-for="MinPhotos" class="text-red-400 text-xs"></span>
            </div>
            <div>
                <label asp-for="DiscountPercent" class="block text-sm font-medium mb-2">Desconto (%)</label>
                <input asp-for="DiscountPercent" type="number" step="0.5" min="1" max="90" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 focus:outline-none focus:border-accent transition" />
                <span asp-validation-for="DiscountPercent" class="text-red-400 text-xs"></span>
            </div>
        </div>

        <div>
            <label asp-for="SortOrder" class="block text-sm font-medium mb-2">Ordem</label>
            <input asp-for="SortOrder" type="number" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 focus:outline-none focus:border-accent transition" />
        </div>

        <div class="flex items-center gap-3">
            <input asp-for="IsActive" class="accent-[color:var(--accent)]" />
            <label asp-for="IsActive" class="text-sm">Ativo</label>
        </div>

        <button type="submit" class="btn-primary">@SharedLocalizer["Save"]</button>
    </form>
</section>
