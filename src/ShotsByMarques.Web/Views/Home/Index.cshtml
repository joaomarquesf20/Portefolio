@model ShotsByMarques.Web.ViewModels.PortfolioViewModel
@{
    ViewData["Title"] = "Início";

    var galleries = Model.Sessions.Concat(Model.Events).ToList();
    var heroGallery = galleries.FirstOrDefault();
    var heroCover = heroGallery?.CoverUrl() ?? "/sample-photos/cars-cover.svg";
    // Covers para as bandas full-bleed (evita repetir a mesma foto)
    var covers = galleries.Select(g => g.CoverUrl()).Where(c => !string.IsNullOrEmpty(c)).ToList();
    if (covers.Count == 0) covers.Add(heroCover);
    string Pick(int i) => covers.Count > i ? covers[i] : covers[^1];

    var featured = heroGallery;
    var rest = galleries.Skip(1).ToList();
    var collage = rest.Take(4).ToList();   // grelha assimétrica
    var strip = rest.Skip(4).ToList();     // filmstrip horizontal (restantes)
}

<!-- ============ HERO — imagem a ecrã inteiro, full-bleed ============ -->
<section class="relative h-[100svh] min-h-[620px] overflow-hidden">
    <img src="@(ViewData["BgHomeHero"] ?? heroCover)" alt="" class="kb absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-black/25"></div>
    <div class="grain absolute inset-0" aria-hidden="true"></div>

    <div class="relative z-[2] flex h-full flex-col justify-end px-5 pb-20 sm:px-8 sm:pb-24 lg:px-12">
        <p class="rv inline-flex items-center gap-3 text-[11px] font-medium uppercase tracking-[0.4em] text-white/70">
            <span class="rule inline-block h-px w-10"></span>
            Fotografia Automóvel · Portugal
        </p>
        <h1 class="rv rv-d1 mt-6 max-w-6xl font-display text-[clamp(3.4rem,10vw,9rem)] font-bold leading-[0.92] tracking-[-0.04em] text-white">
            @SharedLocalizer["HomeName"]
        </h1>
        <p class="rv rv-d2 mt-6 max-w-md text-base leading-relaxed text-white/70 sm:text-lg">@SharedLocalizer["HeroSubtitle"]</p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
            <a href="#portfolio" class="rv rv-d3 inline-flex items-center justify-center gap-3 bg-white px-8 py-4 text-sm font-semibold text-[#141414] transition duration-300 hover:bg-white/85">
                @SharedLocalizer["HeroCta"]
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m0 0l-6.75-6.75M12 19.5l6.75-6.75" /></svg>
            </a>
            <a href="/sessoes" class="rv rv-d4 inline-flex items-center justify-center gap-3 border border-white/40 px-8 py-4 text-sm font-medium text-white transition duration-300 hover:bg-white/10 hover:border-white/70">
                @SharedLocalizer["NavSessions"]
            </a>
        </div>
    </div>

    <span class="absolute right-8 top-1/2 z-[2] hidden -translate-y-1/2 text-[10px] uppercase tracking-[0.45em] text-white/40 [writing-mode:vertical-rl] lg:block">
        Lisboa&nbsp; ·&nbsp; Portugal&nbsp; ·&nbsp; @@shots.by.marques
    </span>

    <div class="absolute bottom-8 left-1/2 z-[2] hidden -translate-x-1/2 flex-col items-center gap-3 sm:flex">
        <span class="text-[9px] uppercase tracking-[0.35em] text-white/50">Scroll</span>
        <span class="cue"></span>
    </div>
</section>

<!-- ============ TICKER (papel) ============ -->
<div class="marquee border-y border-black/10 bg-[#faf9f7] py-5" aria-hidden="true">
    <div class="marquee-track">
        @for (var i = 0; i < 2; i++)
        {
            <div class="flex shrink-0 items-center">
                @foreach (var word in new[] { "Car Shows", "Track Days", "Night Runs", "Stands & Dealers", "Encontros", "Rolling Shots", "Detalhe", "Eventos" })
                {
                    <span class="mx-8 flex items-center gap-16 whitespace-nowrap font-display text-sm font-medium uppercase tracking-[0.3em] text-black/45">
                        @word
                        <span class="inline-block h-1 w-1 rotate-45 bg-[#a1843f]"></span>
                    </span>
                }
            </div>
        }
    </div>
</div>

<!-- ============ PORTFOLIO — grelha assimétrica, sem caixas, edge-to-edge ============ -->
<section id="portfolio" class="scroll-mt-16 pt-16 sm:pt-24">
    <div class="rv flex flex-wrap items-end justify-between gap-6 px-5 pb-10 sm:px-8 lg:px-12">
        <div>
            <p class="text-[11px] font-medium uppercase tracking-[0.4em] text-black/45">Trabalho em destaque</p>
            <h2 class="mt-4 font-display text-[clamp(2.4rem,5vw,4.4rem)] font-bold leading-[0.95] tracking-[-0.03em] text-[#141414]">
                @SharedLocalizer["NavPortfolio"]
            </h2>
        </div>
        <a href="/portfolio" class="u-link group hidden items-center gap-3 text-[11px] font-medium uppercase tracking-[0.3em] text-black/50 transition hover:text-black sm:inline-flex">
            @SharedLocalizer["LearnMore"]
            <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
        </a>
    </div>

    @if (featured is not null)
    {
        var wide = rest.Count == 0;
        var fSpan = wide ? "col-span-12 aspect-[4/3] md:aspect-[21/9]" : "col-span-12 aspect-[4/3] md:col-span-8 md:aspect-[16/10]";

        <!-- Grelha fotográfica: fotos nuas, legendas tipográficas, gutter fino -->
        <div class="grid grid-cols-12 gap-[6px]">
            <a href="/galeria/@featured.Id" class="rv group relative block overflow-hidden @fSpan">
                <img src="@featured.CoverUrl()" alt="@featured.Title" class="h-full w-full object-cover transition duration-[1200ms] ease-out group-hover:scale-[1.04]" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/10 to-transparent opacity-90"></div>
                <span class="absolute left-5 top-5 font-display text-xs tabular-nums text-white/70">01</span>
                <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 p-5 sm:p-8">
                    <div>
                        <p class="text-[10px] uppercase tracking-[0.3em] text-white/60">@(featured.IsSession ? "Sessão" : "Evento") · @featured.Photos.Count @SharedLocalizer["PhotosCount"]</p>
                        <h3 class="mt-2 font-display text-2xl font-bold tracking-[-0.02em] text-white sm:text-4xl">@featured.Title</h3>
                    </div>
                    <span class="hidden h-12 w-12 shrink-0 items-center justify-center rounded-full border border-white/40 text-lg text-white transition duration-300 group-hover:bg-white group-hover:text-[#141414] sm:flex">→</span>
                </div>
            </a>

            @if (rest.Count > 0)
            {
                var second = rest[0];
                <a href="/galeria/@second.Id" class="rv rv-d1 group relative block overflow-hidden col-span-12 aspect-[4/5] md:col-span-4">
                    <img src="@second.CoverUrl()" alt="@second.Title" loading="lazy" class="h-full w-full object-cover transition duration-[1200ms] ease-out group-hover:scale-[1.04]" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/10 to-transparent opacity-90"></div>
                    <span class="absolute left-5 top-5 font-display text-xs tabular-nums text-white/70">02</span>
                    <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 p-5 sm:p-6">
                        <div>
                            <p class="text-[10px] uppercase tracking-[0.3em] text-white/60">@(second.IsSession ? "Sessão" : "Evento") · @second.Photos.Count @SharedLocalizer["PhotosCount"]</p>
                            <h3 class="mt-2 font-display text-lg font-bold tracking-[-0.02em] text-white sm:text-xl">@second.Title</h3>
                        </div>
                        <span class="hidden h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/40 text-white transition duration-300 group-hover:bg-white group-hover:text-[#141414] sm:flex">→</span>
                    </div>
                </a>
            }

            @{
                var patterns = new[]
                {
                    "col-span-6 aspect-square md:col-span-4 md:aspect-[4/5]",
                    "col-span-6 aspect-square md:col-span-4 md:aspect-[4/5]",
                    "col-span-12 aspect-[4/3] md:col-span-4 md:aspect-[4/5]"
                };
                var ci = 0;
            }
            @foreach (var gallery in collage.Skip(1))
            {
                ci++;
                <a href="/galeria/@gallery.Id" class="rv @(ci % 2 == 0 ? "rv-d1" : "") group relative block overflow-hidden @patterns[ci - 1]">
                    <img src="@gallery.CoverUrl()" alt="@gallery.Title" loading="lazy" class="h-full w-full object-cover transition duration-[1200ms] ease-out group-hover:scale-[1.04]" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/10 to-transparent opacity-90"></div>
                    <span class="absolute left-5 top-5 font-display text-xs tabular-nums text-white/70">@((ci + 2).ToString("00"))</span>
                    <div class="absolute inset-x-0 bottom-0 p-5 sm:p-6">
                        <p class="text-[10px] uppercase tracking-[0.3em] text-white/60">@(gallery.IsSession ? "Sessão" : "Evento") · @gallery.Photos.Count @SharedLocalizer["PhotosCount"]</p>
                        <h3 class="mt-2 font-display text-lg font-bold tracking-[-0.02em] text-white sm:text-xl">@gallery.Title</h3>
                    </div>
                </a>
            }
        </div>

        @if (strip.Any())
        {
            <!-- Filmstrip horizontal: resto das galerias, edge-to-edge -->
            <div class="no-scrollbar mt-[6px] flex snap-x snap-mandatory gap-[6px] overflow-x-auto">
                @{ var si = 0; }
                @foreach (var gallery in strip)
                {
                    si++;
                    <a href="/galeria/@gallery.Id" class="group relative block h-[52vh] w-[76vw] shrink-0 snap-start overflow-hidden sm:h-[60vh] sm:w-[44vw] md:w-[30vw]">
                        <img src="@gallery.CoverUrl()" alt="@gallery.Title" loading="lazy" class="h-full w-full object-cover transition duration-[1200ms] ease-out group-hover:scale-[1.04]" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/10 to-transparent opacity-90"></div>
                        <span class="absolute left-5 top-5 font-display text-xs tabular-nums text-white/70">@((si + 5).ToString("00"))</span>
                        <div class="absolute inset-x-0 bottom-0 p-5">
                            <p class="text-[10px] uppercase tracking-[0.3em] text-white/60">@(gallery.IsSession ? "Sessão" : "Evento") · @gallery.Photos.Count @SharedLocalizer["PhotosCount"]</p>
                            <h3 class="mt-2 font-display text-lg font-bold tracking-[-0.02em] text-white sm:text-xl">@gallery.Title</h3>
                        </div>
                    </a>
                }
            </div>
        }
    }
    else
    {
        <p class="rv py-24 text-center font-display text-2xl text-black/40">Sem galerias publicadas.</p>
    }
</section>

<!-- ============ MANIFESTO — banda preta full-bleed ============ -->
<section class="bg-[#141414] px-5 py-28 sm:px-8 sm:py-40 lg:px-12">
    <figure class="mx-auto max-w-5xl text-center">
        <div class="rv mx-auto flex justify-center"><span class="rule h-px w-16 opacity-90"></span></div>
        <blockquote class="rv rv-d1 mt-8 font-display text-[clamp(1.8rem,4.5vw,3.8rem)] font-bold leading-[1.12] tracking-[-0.03em] text-white">
            “Metal, luz e ocasião — capturados com intenção.”
        </blockquote>
        <figcaption class="rv rv-d2 mt-8 text-[10px] font-medium uppercase tracking-[0.35em] text-white/40">Shots By Marques</figcaption>
    </figure>
</section>

<!-- ============ SERVIÇOS — linhas editoriais full-width, invert on hover ============ -->
<section id="servicos" class="scroll-mt-16 pt-16 sm:pt-24">
    <div class="rv flex flex-wrap items-end justify-between gap-6 px-5 pb-10 sm:px-8 lg:px-12">
        <div>
            <p class="text-[11px] font-medium uppercase tracking-[0.4em] text-black/45">O que faço</p>
            <h2 class="mt-4 font-display text-[clamp(2.4rem,5vw,4.4rem)] font-bold leading-[0.95] tracking-[-0.03em] text-[#141414]">
                @SharedLocalizer["NavServices"]
            </h2>
            <p class="mt-4 max-w-xl text-black/50">@SharedLocalizer["ServicesSubtitle"]</p>
        </div>
        <a href="/servicos" class="u-link group hidden items-center gap-3 text-[11px] font-medium uppercase tracking-[0.3em] text-black/50 transition hover:text-black sm:inline-flex">
            @SharedLocalizer["LearnMore"]
            <span class="inline-block">→</span>
        </a>
    </div>

    <div class="rv rv-d1 border-b border-black/10">
        <a href="/portfolio#eventos" class="group grid grid-cols-12 gap-x-6 gap-y-3 border-t border-black/10 px-5 py-9 transition-colors duration-500 hover:bg-[#141414] sm:px-8 sm:py-12 lg:px-12">
            <span class="col-span-2 font-display text-2xl tabular-nums text-black/20 transition-colors duration-500 group-hover:text-[#a1843f] md:col-span-1">01</span>
            <div class="col-span-10 md:col-span-7">
                <h3 class="font-display text-lg font-bold uppercase tracking-[-0.01em] text-[#141414] transition-colors duration-500 group-hover:text-white sm:text-2xl">@SharedLocalizer["Nr01Title"]</h3>
                <p class="mt-2 max-w-2xl text-sm leading-relaxed text-black/45 transition-colors duration-500 group-hover:text-white/55 sm:text-[15px]">@SharedLocalizer["Nr01Desc"]</p>
            </div>
            <div class="col-span-12 flex items-center justify-between self-start pl-2 md:col-span-4 md:justify-end md:gap-10 md:pl-0">
                <span class="text-sm font-semibold tabular-nums text-[#141414] transition-colors duration-500 group-hover:text-white sm:text-base">@SharedLocalizer["Nr01Price"]</span>
                <span class="hidden items-center gap-3 text-[10px] font-medium uppercase tracking-[0.25em] text-black/40 transition-colors duration-500 group-hover:text-white/75 md:flex">
                    @SharedLocalizer["Nr01Cta"]
                    <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
                </span>
            </div>
        </a>

        <a href="/sessoes" class="group grid grid-cols-12 gap-x-6 gap-y-3 border-t border-black/10 px-5 py-9 transition-colors duration-500 hover:bg-[#141414] sm:px-8 sm:py-12 lg:px-12">
            <span class="col-span-2 font-display text-2xl tabular-nums text-black/20 transition-colors duration-500 group-hover:text-[#a1843f] md:col-span-1">02</span>
            <div class="col-span-10 md:col-span-7">
                <h3 class="font-display text-lg font-bold uppercase tracking-[-0.01em] text-[#141414] transition-colors duration-500 group-hover:text-white sm:text-2xl">@SharedLocalizer["Nr02Title"]</h3>
                <p class="mt-2 max-w-2xl text-sm leading-relaxed text-black/45 transition-colors duration-500 group-hover:text-white/55 sm:text-[15px]">@SharedLocalizer["Nr02Desc"]</p>
            </div>
            <div class="col-span-12 flex items-center justify-between self-start pl-2 md:col-span-4 md:justify-end md:gap-10 md:pl-0">
                <span class="text-sm font-semibold tabular-nums text-[#141414] transition-colors duration-500 group-hover:text-white sm:text-base">@SharedLocalizer["Nr02Price"]</span>
                <span class="hidden items-center gap-3 text-[10px] font-medium uppercase tracking-[0.25em] text-black/40 transition-colors duration-500 group-hover:text-white/75 md:flex">
                    @SharedLocalizer["Nr02Cta"]
                    <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
                </span>
            </div>
        </a>

        <a href="mailto:marquesphotography06@gmail.com?subject=Orçamento%20—%20Stands" class="group grid grid-cols-12 gap-x-6 gap-y-3 border-t border-black/10 px-5 py-9 transition-colors duration-500 hover:bg-[#141414] sm:px-8 sm:py-12 lg:px-12">
            <span class="col-span-2 font-display text-2xl tabular-nums text-black/20 transition-colors duration-500 group-hover:text-[#a1843f] md:col-span-1">03</span>
            <div class="col-span-10 md:col-span-7">
                <h3 class="font-display text-lg font-bold uppercase tracking-[-0.01em] text-[#141414] transition-colors duration-500 group-hover:text-white sm:text-2xl">@SharedLocalizer["Nr03Title"]</h3>
                <p class="mt-2 max-w-2xl text-sm leading-relaxed text-black/45 transition-colors duration-500 group-hover:text-white/55 sm:text-[15px]">@SharedLocalizer["Nr03Desc"]</p>
            </div>
            <div class="col-span-12 flex items-center justify-between self-start pl-2 md:col-span-4 md:justify-end md:gap-10 md:pl-0">
                <span class="text-sm font-semibold tabular-nums text-[#141414] transition-colors duration-500 group-hover:text-white sm:text-base">@SharedLocalizer["Nr03Price"]</span>
                <span class="hidden items-center gap-3 text-[10px] font-medium uppercase tracking-[0.25em] text-black/40 transition-colors duration-500 group-hover:text-white/75 md:flex">
                    @SharedLocalizer["Nr03Cta"]
                    <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
                </span>
            </div>
        </a>
    </div>
</section>

<!-- ============ CONTACTO — foto full-bleed, lavagem de luz ============ -->
<section id="contacto" class="relative scroll-mt-16 overflow-hidden">
    <img src="@(ViewData["BgHomeContact"] ?? Pick(3))" alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-[#faf9f7]/85"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_35%,rgba(250,249,247,0.9)_100%)]"></div>

    <div class="relative z-[2] mx-auto max-w-4xl px-5 py-28 text-center sm:px-8 sm:py-40">
        <p class="rv inline-flex items-center gap-3 text-[11px] font-medium uppercase tracking-[0.4em] text-black/50">
            <span class="rule inline-block h-px w-8"></span>
            Contacto
            <span class="rule inline-block h-px w-8"></span>
        </p>
        <h2 class="rv rv-d1 mt-6 font-display text-[clamp(2.4rem,5.5vw,4.5rem)] font-bold leading-[1.05] tracking-[-0.03em] text-[#141414]">
            @SharedLocalizer["ContactTitle"]
        </h2>
        <p class="rv rv-d2 mt-5 text-lg text-black/55">@SharedLocalizer["GetInTouch"]</p>

        <div class="rv rv-d3 mt-10">
            <a href="mailto:marquesphotography06@gmail.com" class="inline-flex items-center justify-center gap-3 bg-[#141414] px-8 py-4 text-sm font-semibold text-white transition duration-300 hover:-translate-y-0.5 hover:opacity-90">
                @SharedLocalizer["ContactCta"]
            </a>
        </div>

        <p class="rv rv-d4 mt-12 text-sm text-black/40">
            Instagram:
            <a href="https://www.instagram.com/shots.by.marques/" target="_blank" rel="noopener" class="u-link ml-1 text-black/70 transition hover:text-[#a1843f]">@@shots.by.marques</a>
        </p>
    </div>
</section>
