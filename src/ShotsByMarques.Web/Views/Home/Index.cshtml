@model ShotsByMarques.Web.ViewModels.PortfolioViewModel
@{
    ViewData["Title"] = "Início";

    var galleries = Model.Sessions.Cast<ShotsByMarques.Web.Models.Gallery>().Concat(Model.Events).ToList();
    var heroGallery = galleries.FirstOrDefault();
    var heroCover = heroGallery?.CoverUrl() ?? "/sample-photos/cars-cover.svg";
    // Covers para as secções full-bleed (evita repetir a mesma foto)
    var covers = galleries.Select(g => g.CoverUrl()).Where(c => !string.IsNullOrEmpty(c)).ToList();
    if (covers.Count == 0) covers.Add(heroCover);
    string Pick(int i) => covers.Count > i ? covers[i] : covers[^1];

    var featured = heroGallery;
    var rest = galleries.Skip(1).ToList();
}

<!-- ============ HERO — full-bleed cinematográfico ============ -->
<section class="relative flex h-[100svh] min-h-[640px] items-end overflow-hidden">
    <img src="@(ViewData["BgHomeHero"] ?? heroCover)" alt="" class="kb absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-[#08090b] via-[#08090b]/20 to-black/50"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-transparent to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0 h-44 bg-gradient-to-t from-[#08090b] to-transparent"></div>
    <div class="grain absolute inset-0" aria-hidden="true"></div>

    <div class="relative z-[2] mx-auto w-full max-w-7xl px-5 pb-28 sm:px-6 sm:pb-32 lg:px-10">
        <p class="rv inline-flex items-center gap-3 text-[11px] font-medium uppercase tracking-[0.4em] text-white/55">
            <span class="inline-block h-px w-10 bg-gold"></span>
            Shots By Marques · Fotografia Automóvel · Portugal
        </p>
        <h1 class="rv rv-d1 mt-6 max-w-4xl font-display text-[clamp(3.2rem,9vw,8rem)] font-bold leading-[0.94] tracking-[-0.035em] text-white">
            @SharedLocalizer["HomeName"]
        </h1>
        <p class="rv rv-d2 mt-7 max-w-xl text-lg leading-relaxed text-white/65">@SharedLocalizer["HeroSubtitle"]</p>

        <div class="rv rv-d3 mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
            <a href="/portfolio" class="inline-flex items-center justify-center gap-3 rounded-full bg-gold px-8 py-4 text-sm font-semibold text-ink transition duration-300 hover:-translate-y-0.5 hover:brightness-110 hover:shadow-[0_14px_40px_-14px_rgba(216,169,91,0.55)]">
                @SharedLocalizer["HeroCta"]
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12l-7.5 7.5M21 12H3" /></svg>
            </a>
            <a href="/sessoes" class="inline-flex items-center justify-center gap-3 rounded-full border border-white/20 px-8 py-4 text-sm font-medium text-white transition duration-300 hover:-translate-y-0.5 hover:border-white/50 hover:bg-white/[0.05]">
                @SharedLocalizer["NavSessions"]
            </a>
        </div>
    </div>

    <!-- scroll cue -->
    <div class="absolute bottom-8 left-1/2 z-[2] hidden -translate-x-1/2 flex-col items-center gap-3 sm:flex">
        <span class="text-[9px] uppercase tracking-[0.35em] text-white/35">Scroll</span>
        <span class="cue"></span>
    </div>
</section>

<!-- ============ MARQUEE ============ -->
<div class="marquee border-y border-white/[0.08] bg-[#0a0b0e] py-4" aria-hidden="true">
    <div class="marquee-track">
        @for (var i = 0; i < 2; i++)
        {
            <div class="flex shrink-0 items-center">
                @foreach (var word in new[] { "Car Shows", "Track Days", "Night Runs", "Stands & Dealers", "Encontros", "Rolling Shots", "Detalhe", "Eventos" })
                {
                    <span class="mx-7 flex items-center gap-14 whitespace-nowrap font-display text-sm font-medium uppercase tracking-[0.3em] text-white/40">
                        @word
                        <span class="inline-block h-1 w-1 rotate-45 bg-gold/70"></span>
                    </span>
                }
            </div>
        }
    </div>
</div>

<!-- ============ PORTFOLIO ============ -->
<section id="portfolio" class="relative mx-auto max-w-7xl px-5 pt-24 sm:px-6 sm:pt-32 lg:px-10">
    <div class="rv flex flex-wrap items-end justify-between gap-6">
        <div>
            <p class="text-[11px] font-medium uppercase tracking-[0.4em] text-white/45">Trabalho em destaque</p>
            <h2 class="mt-4 font-display text-4xl font-bold tracking-[-0.03em] text-white sm:text-5xl">@SharedLocalizer["NavPortfolio"]</h2>
            <p class="mt-3 max-w-xl text-white/50">@SharedLocalizer["PortfolioSubtitle"]</p>
        </div>
        <a href="/portfolio" class="group hidden items-center gap-2 text-[12px] font-medium uppercase tracking-[0.25em] text-white/55 transition hover:text-white sm:inline-flex">
            @SharedLocalizer["LearnMore"]
            <span class="inline-block transition-transform duration-300 group-hover:translate-x-1.5">→</span>
        </a>
    </div>

    @if (featured is not null)
    {
        <!-- Card destaque (full-width, editorial) -->
        <a href="/galeria/@featured.Id" class="rv group relative mt-14 block overflow-hidden rounded-2xl border border-white/[0.08] bg-panel">
            <div class="relative aspect-[16/10] overflow-hidden sm:aspect-[21/9]">
                <img src="@featured.CoverUrl()" alt="@featured.Title" class="h-full w-full object-cover transition duration-[1200ms] ease-out group-hover:scale-[1.04]" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent"></div>
                <span class="absolute left-6 top-6 font-display text-sm text-white/70 tabular-nums">01</span>
                <span class="absolute right-6 top-6 rounded-full border border-white/25 px-3 py-1 text-[10px] font-medium uppercase tracking-[0.22em] text-white/75 backdrop-blur-sm">@(featured.IsSession ? "Sessão" : "Evento")</span>
                <div class="absolute inset-x-0 bottom-0 flex flex-wrap items-end justify-between gap-6 p-6 sm:p-10">
                    <div class="max-w-2xl">
                        <h3 class="font-display text-3xl font-bold tracking-[-0.03em] text-white sm:text-5xl">@featured.Title</h3>
                        @if (!string.IsNullOrEmpty(featured.Subtitle))
                        {
                            <p class="mt-2 text-white/60 sm:text-lg">@featured.Subtitle</p>
                        }
                        <p class="mt-4 text-[11px] uppercase tracking-[0.28em] text-white/45">@featured.Photos.Count @SharedLocalizer["PhotosCount"]</p>
                    </div>
                    <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full border border-white/25 text-xl text-white/80 transition duration-300 group-hover:border-gold group-hover:bg-gold group-hover:text-ink">→</span>
                </div>
            </div>
        </a>
    }

    @if (rest.Any())
    {
        var i = 0;
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var gallery in rest)
            {
                i++;
                <a href="/galeria/@gallery.Id" class="rv @(i % 2 == 0 ? "rv-d1" : "") group relative block overflow-hidden rounded-xl border border-white/[0.08] bg-panel">
                    <div class="relative aspect-[4/5] overflow-hidden">
                        <img src="@gallery.CoverUrl()" alt="@gallery.Title" loading="lazy" class="h-full w-full object-cover transition duration-[1100ms] ease-out group-hover:scale-[1.06]" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent"></div>
                        <span class="absolute left-5 top-5 font-display text-xs text-white/60 tabular-nums">@((i + 1).ToString("00"))</span>
                        <span class="absolute right-5 top-5 rounded-full border border-white/20 px-2.5 py-1 text-[9px] font-medium uppercase tracking-[0.2em] text-white/70 backdrop-blur-sm">@(gallery.IsSession ? "Sessão" : "Evento")</span>
                        <div class="absolute inset-x-0 bottom-0 p-5 sm:p-6">
                            <h3 class="font-display text-xl font-bold tracking-[-0.02em] text-white sm:text-2xl">@gallery.Title</h3>
                            @if (!string.IsNullOrEmpty(gallery.Subtitle))
                            {
                                <p class="mt-1 line-clamp-1 text-sm text-white/55">@gallery.Subtitle</p>
                            }
                            <div class="mt-4 flex items-center justify-between">
                                <span class="text-[10px] uppercase tracking-[0.25em] text-white/45">@gallery.Photos.Count @SharedLocalizer["PhotosCount"]</span>
                                <span class="flex h-10 w-10 items-center justify-center rounded-full border border-white/20 text-white/70 transition duration-300 group-hover:border-gold group-hover:bg-gold group-hover:opacity-100 group-hover:text-ink">→</span>
                            </div>
                        </div>
                    </div>
                </a>
            }
        </div>
    }

    @if (featured is null)
    {
        <p class="rv py-20 text-center text-white/45">Sem galerias publicadas.</p>
    }
</section>

<!-- ============ QUOTE — full-bleed ============ -->
<section class="grain relative mt-24 overflow-hidden py-28 sm:mt-32 sm:py-44">
    <img src="@Pick(2)" alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-[#08090b]/80"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_30%,rgba(8,9,11,0.75)_100%)]"></div>

    <figure class="relative z-[2] mx-auto max-w-4xl px-6 text-center">
        <div class="rv mx-auto flex w-24 justify-center"><span class="h-px w-16 bg-gold"></span></div>
        <blockquote class="rv rv-d1 mt-8 font-display text-[clamp(1.7rem,4vw,3.2rem)] font-bold leading-[1.15] tracking-[-0.03em] text-white">
            “Metal, luz e ocasião — capturados com intenção.”
        </blockquote>
        <figcaption class="rv rv-d2 mt-7 text-[10px] font-medium uppercase tracking-[0.35em] text-white/45">Shots By Marques</figcaption>
    </figure>
</section>

<!-- ============ SERVIÇOS — lista editorial numerada ============ -->
<section id="servicos" class="relative bg-[#0b0c0f]">
    <div class="mx-auto max-w-7xl px-5 py-24 sm:px-6 sm:py-32 lg:px-10">
        <div class="rv flex flex-wrap items-end justify-between gap-6">
            <div>
                <p class="text-[11px] font-medium uppercase tracking-[0.4em] text-white/45">O que faço</p>
                <h2 class="mt-4 font-display text-4xl font-bold tracking-[-0.03em] text-white sm:text-5xl">@SharedLocalizer["NavServices"]</h2>
                <p class="mt-3 max-w-xl text-white/50">@SharedLocalizer["ServicesSubtitle"]</p>
            </div>
            <a href="/servicos" class="group hidden items-center gap-2 text-[12px] font-medium uppercase tracking-[0.25em] text-white/55 transition hover:text-white sm:inline-flex">
                @SharedLocalizer["LearnMore"]
                <span class="inline-block transition-transform duration-300 group-hover:translate-x-1.5">→</span>
            </a>
        </div>

        <div class="rv rv-d1 mt-14 border-t border-white/10">
            <a href="/portfolio#eventos" class="group relative grid grid-cols-[auto_minmax(0,1fr)_auto] items-start gap-x-6 gap-y-3 border-b border-white/10 px-2 py-9 transition duration-300 hover:bg-white/[0.03] sm:items-center sm:gap-x-10 sm:px-4 sm:py-11">
                <span class="font-display text-2xl text-white/20 transition duration-300 group-hover:text-gold tabular-nums">01</span>
                <div>
                    <h3 class="font-display text-lg font-bold uppercase tracking-[-0.01em] text-white sm:text-2xl">@SharedLocalizer["Nr01Title"]</h3>
                    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-white/50 sm:text-[15px]">@SharedLocalizer["Nr01Desc"]</p>
                </div>
                <div class="flex items-center gap-6 self-start sm:self-center sm:gap-10">
                    <span class="text-sm font-semibold text-white tabular-nums sm:text-base">@SharedLocalizer["Nr01Price"]</span>
                    <span class="hidden items-center gap-3 text-[10px] font-medium uppercase tracking-[0.25em] text-white/45 transition group-hover:text-white sm:flex">
                        @SharedLocalizer["Nr01Cta"]
                        <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
                    </span>
                </div>
            </a>

            <a href="/sessoes" class="group relative grid grid-cols-[auto_minmax(0,1fr)_auto] items-start gap-x-6 gap-y-3 border-b border-white/10 px-2 py-9 transition duration-300 hover:bg-white/[0.03] sm:items-center sm:gap-x-10 sm:px-4 sm:py-11">
                <span class="font-display text-2xl text-white/20 transition duration-300 group-hover:text-gold tabular-nums">02</span>
                <div>
                    <h3 class="font-display text-lg font-bold uppercase tracking-[-0.01em] text-white sm:text-2xl">@SharedLocalizer["Nr02Title"]</h3>
                    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-white/50 sm:text-[15px]">@SharedLocalizer["Nr02Desc"]</p>
                </div>
                <div class="flex items-center gap-6 self-start sm:self-center sm:gap-10">
                    <span class="text-sm font-semibold text-white tabular-nums sm:text-base">@SharedLocalizer["Nr02Price"]</span>
                    <span class="hidden items-center gap-3 text-[10px] font-medium uppercase tracking-[0.25em] text-white/45 transition group-hover:text-white sm:flex">
                        @SharedLocalizer["Nr02Cta"]
                        <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
                    </span>
                </div>
            </a>

            <a href="mailto:marquesphotography06@gmail.com?subject=Orçamento%20—%20Stands" class="group relative grid grid-cols-[auto_minmax(0,1fr)_auto] items-start gap-x-6 gap-y-3 border-b border-white/10 px-2 py-9 transition duration-300 hover:bg-white/[0.03] sm:items-center sm:gap-x-10 sm:px-4 sm:py-11">
                <span class="font-display text-2xl text-white/20 transition duration-300 group-hover:text-gold tabular-nums">03</span>
                <div>
                    <h3 class="font-display text-lg font-bold uppercase tracking-[-0.01em] text-white sm:text-2xl">@SharedLocalizer["Nr03Title"]</h3>
                    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-white/50 sm:text-[15px]">@SharedLocalizer["Nr03Desc"]</p>
                </div>
                <div class="flex items-center gap-6 self-start sm:self-center sm:gap-10">
                    <span class="text-sm font-semibold text-white tabular-nums sm:text-base">@SharedLocalizer["Nr03Price"]</span>
                    <span class="hidden items-center gap-3 text-[10px] font-medium uppercase tracking-[0.25em] text-white/45 transition group-hover:text-white sm:flex">
                        @SharedLocalizer["Nr03Cta"]
                        <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
                    </span>
                </div>
            </a>
        </div>
    </div>
</section>

<!-- ============ CONTACTO — CTA final ============ -->
<section id="contacto" class="grain relative overflow-hidden">
    <img src="@(ViewData["BgHomeContact"] ?? Pick(3))" alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-[#08090b]/[0.84]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_20%,rgba(8,9,11,0.8)_100%)]"></div>

    <div class="relative z-[2] mx-auto max-w-5xl px-6 py-28 text-center sm:py-40">
        <p class="rv inline-flex items-center gap-3 text-[11px] font-medium uppercase tracking-[0.4em] text-white/55">
            <span class="inline-block h-px w-8 bg-gold"></span>
            Contacto
            <span class="inline-block h-px w-8 bg-gold"></span>
        </p>
        <h2 class="rv rv-d1 mt-6 font-display text-[clamp(2.4rem,5.5vw,4.6rem)] font-bold leading-[1.05] tracking-[-0.03em] text-white">
            @SharedLocalizer["ContactTitle"]
        </h2>
        <p class="rv rv-d2 mt-5 text-lg text-white/60">@SharedLocalizer["GetInTouch"]</p>

        <div class="rv rv-d3 mt-10">
            <a href="mailto:marquesphotography06@gmail.com" class="inline-flex items-center justify-center gap-3 rounded-full bg-gold px-8 py-4 text-sm font-semibold text-ink transition duration-300 hover:-translate-y-0.5 hover:brightness-110 hover:shadow-[0_14px_40px_-14px_rgba(216,169,91,0.55)]">
                @SharedLocalizer["ContactCta"]
            </a>
        </div>

        <p class="rv rv-d4 mt-12 text-sm text-white/40">
            Instagram:
            <a href="https://www.instagram.com/shots.by.marques/" target="_blank" rel="noopener" class="u-link ml-1 text-white/80 transition hover:text-gold">@@shots.by.marques</a>
        </p>
    </div>
</section>
