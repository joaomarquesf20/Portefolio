@{
    ViewData["Title"] = SharedLocalizer["NavServices"];
}

<!-- ============ HERO — banda cinematográfica ============ -->
<section class="relative overflow-hidden">
    <img src="@(ViewData["BgServices"] ?? "/sample-photos/cars-cover.svg")" alt="" class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-[#08090b] via-[#08090b]/75 to-black/45"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-black/50 via-transparent to-transparent"></div>
    <div class="grain absolute inset-0" aria-hidden="true"></div>

    <div class="relative z-[2] mx-auto max-w-7xl px-5 pb-16 pt-28 sm:px-6 sm:pb-20 sm:pt-36 lg:px-10">
        <p class="rv inline-flex items-center gap-3 text-[11px] font-medium uppercase tracking-[0.4em] text-white/55">
            <span class="inline-block h-px w-10 bg-gold"></span>
            Shots By Marques · Serviços
        </p>
        <h1 class="rv rv-d1 mt-6 max-w-3xl font-display text-[clamp(2.8rem,6vw,5.5rem)] font-bold leading-[0.96] tracking-[-0.03em] text-white">
            @SharedLocalizer["ServicesPageTitle"]
        </h1>
        <p class="rv rv-d2 mt-6 max-w-xl text-lg leading-relaxed text-white/65">@SharedLocalizer["ServicesIntro"]</p>

        <div class="rv rv-d3 mt-12 max-w-2xl border-l-2 border-gold/70 pl-6 sm:pl-8">
            <blockquote class="font-display text-xl leading-relaxed text-white/80 sm:text-2xl">
                "@SharedLocalizer["ServicesQuote"]"
            </blockquote>
            <p class="mt-4 text-[10px] font-semibold uppercase tracking-[0.3em] text-gold">@SharedLocalizer["ServicesQuoteAuthor"]</p>
        </div>
    </div>
</section>

<!-- ============ PREÇOS — linhas editoriais numeradas ============ -->
<section class="bg-[#0b0c0f]">
    <div class="mx-auto max-w-7xl px-5 py-24 sm:px-6 sm:py-32 lg:px-10">
        <div class="rv">
            <p class="text-[11px] font-medium uppercase tracking-[0.4em] text-white/45">Planos & pacotes</p>
            <h2 class="mt-4 font-display text-4xl font-bold tracking-[-0.03em] text-white sm:text-5xl">@SharedLocalizer["PricingTitle"]</h2>
        </div>

        <div class="rv rv-d1 mt-14 border-t border-white/10">
            <!-- NR 01 -->
            <a href="/portfolio#eventos" class="group grid grid-cols-[auto_minmax(0,1fr)_auto] items-start gap-x-6 gap-y-3 border-b border-white/10 px-2 py-9 transition duration-300 hover:bg-white/[0.03] sm:items-center sm:gap-x-10 sm:px-4 sm:py-11">
                <span class="font-display text-2xl tabular-nums text-white/20 transition duration-300 group-hover:text-gold">01</span>
                <div>
                    <h3 class="font-display text-lg font-bold uppercase tracking-[-0.01em] text-white sm:text-2xl">@SharedLocalizer["Nr01Title"]</h3>
                    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-white/50 sm:text-[15px]">@SharedLocalizer["Nr01Desc"]</p>
                </div>
                <div class="flex items-center gap-6 self-start sm:self-center sm:gap-10">
                    <span class="tabular-nums text-sm font-semibold text-white sm:text-base">@SharedLocalizer["Nr01Price"]</span>
                    <span class="hidden items-center gap-3 text-[10px] font-medium uppercase tracking-[0.25em] text-white/45 transition group-hover:text-white sm:flex">
                        @SharedLocalizer["Nr01Cta"]
                        <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
                    </span>
                </div>
            </a>

            <!-- NR 02 -->
            <a href="/sessoes" class="group grid grid-cols-[auto_minmax(0,1fr)_auto] items-start gap-x-6 gap-y-3 border-b border-white/10 px-2 py-9 transition duration-300 hover:bg-white/[0.03] sm:items-center sm:gap-x-10 sm:px-4 sm:py-11">
                <span class="font-display text-2xl tabular-nums text-white/20 transition duration-300 group-hover:text-gold">02</span>
                <div>
                    <h3 class="font-display text-lg font-bold uppercase tracking-[-0.01em] text-white sm:text-2xl">@SharedLocalizer["Nr02Title"]</h3>
                    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-white/50 sm:text-[15px]">@SharedLocalizer["Nr02Desc"]</p>
                </div>
                <div class="flex items-center gap-6 self-start sm:self-center sm:gap-10">
                    <span class="tabular-nums text-sm font-semibold text-white sm:text-base">@SharedLocalizer["Nr02Price"]</span>
                    <span class="hidden items-center gap-3 text-[10px] font-medium uppercase tracking-[0.25em] text-white/45 transition group-hover:text-white sm:flex">
                        @SharedLocalizer["Nr02Cta"]
                        <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
                    </span>
                </div>
            </a>

            <!-- NR 03 -->
            <a href="mailto:marquesphotography06@gmail.com?subject=Orçamento%20—%20Stands" class="group grid grid-cols-[auto_minmax(0,1fr)_auto] items-start gap-x-6 gap-y-3 border-b border-white/10 px-2 py-9 transition duration-300 hover:bg-white/[0.03] sm:items-center sm:gap-x-10 sm:px-4 sm:py-11">
                <span class="font-display text-2xl tabular-nums text-white/20 transition duration-300 group-hover:text-gold">03</span>
                <div>
                    <h3 class="font-display text-lg font-bold uppercase tracking-[-0.01em] text-white sm:text-2xl">@SharedLocalizer["Nr03Title"]</h3>
                    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-white/50 sm:text-[15px]">@SharedLocalizer["Nr03Desc"]</p>
                </div>
                <div class="flex items-center gap-6 self-start sm:self-center sm:gap-10">
                    <span class="tabular-nums text-sm font-semibold text-white sm:text-base">@SharedLocalizer["Nr03Price"]</span>
                    <span class="hidden items-center gap-3 text-[10px] font-medium uppercase tracking-[0.25em] text-white/45 transition group-hover:text-white sm:flex">
                        @SharedLocalizer["Nr03Cta"]
                        <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
                    </span>
                </div>
            </a>
        </div>
    </div>
</section>

<!-- ============ MARQUEE ============ -->
<div class="marquee border-y border-white/[0.08] bg-[#0a0b0e] py-4" aria-hidden="true">
    <div class="marquee-track">
        @for (var i = 0; i < 2; i++)
        {
            <div class="flex shrink-0 items-center">
                @foreach (var word in new[] { "Car Shows", "Track Days", "Night Runs", "Stands & Dealers", "Encontros", "Rolling Shots", "Detalhe", "Eventos" })
                {
                    <span class="mx-7 flex items-center gap-14 whitespace-nowrap font-display text-sm font-medium uppercase tracking-[0.3em] text-white/40">
                        @word
                        <span class="inline-block h-1 w-1 rotate-45 bg-gold/70"></span>
                    </span>
                }
            </div>
        }
    </div>
</div>

<!-- ============ TRABALHO RECENTE — CTA final ============ -->
<section class="relative overflow-hidden bg-[radial-gradient(60%_55%_at_50%_0%,rgba(216,169,91,0.07),transparent)]">
    <div class="mx-auto max-w-7xl px-5 py-24 text-center sm:px-6 sm:py-32 lg:px-10">
        <p class="rv inline-flex items-center gap-3 text-[11px] font-medium uppercase tracking-[0.4em] text-white/55">
            <span class="inline-block h-px w-8 bg-gold"></span>
            Portefólio
            <span class="inline-block h-px w-8 bg-gold"></span>
        </p>
        <h2 class="rv rv-d1 mt-6 font-display text-[clamp(2rem,4.5vw,3.8rem)] font-bold tracking-[-0.03em] text-white">
            @SharedLocalizer["LatestWorkTitle"]
        </h2>
        <div class="rv rv-d2 mt-10">
            <a href="/portfolio" class="inline-flex items-center justify-center gap-3 rounded-full bg-gold px-8 py-4 text-sm font-semibold text-ink transition duration-300 hover:-translate-y-0.5 hover:brightness-110 hover:shadow-[0_14px_40px_-14px_rgba(216,169,91,0.55)]">
                @SharedLocalizer["SeeMore"]
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12l-7.5 7.5M21 12H3" /></svg>
            </a>
        </div>
    </div>
</section>
