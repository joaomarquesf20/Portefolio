@model ShotsByMarques.Web.Models.DiscountCode
@{
    ViewData["Title"] = "Novo código";
}

<section class="max-w-2xl mx-auto px-4 sm:px-6 py-12">
    <a href="/AdminDiscountCodes" class="text-white/50 hover:text-accent text-sm transition">← @SharedLocalizer["Back"]</a>
    <h1 class="font-display text-4xl mt-3 mb-8 fade-up">Novo código de desconto</h1>

    <form asp-action="Create" method="post" class="card p-8 space-y-5 fade-up">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-red-400 text-sm"></div>

        <div>
            <label asp-for="Code" class="block text-sm font-medium mb-2">Código</label>
            <input asp-for="Code" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 uppercase tracking-widest focus:outline-none focus:border-accent transition" placeholder="NATAL26" />
            <span asp-validation-for="Code" class="text-red-400 text-xs"></span>
        </div>

        <div>
            <label class="block text-sm font-medium mb-2">Tipo de desconto</label>
            <div class="flex flex-wrap gap-3">
                <label class="flex items-center gap-2 rounded-xl border border-[color:var(--border)] px-4 py-3 text-sm cursor-pointer">
                    <input asp-for="DiscountType" type="radio" value="Percentage" id="dt-percentage" class="accent-[color:var(--accent)]" />
                    <span>Percentagem (%)</span>
                </label>
                <label class="flex items-center gap-2 rounded-xl border border-[color:var(--border)] px-4 py-3 text-sm cursor-pointer">
                    <input asp-for="DiscountType" type="radio" value="FixedAmount" id="dt-fixed" class="accent-[color:var(--accent)]" />
                    <span>Valor fixo (€)</span>
                </label>
            </div>
        </div>

        <div>
            <label asp-for="Value" class="block text-sm font-medium mb-2">Valor</label>
            <input asp-for="Value" type="number" step="0.01" min="0.01" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 focus:outline-none focus:border-accent transition" placeholder="20" />
            <p class="mt-1 text-xs text-white/40">Percentagem entre 1 e 90 (ex.: 20 = −20%) ou montante fixo (ex.: 5 = −5 €), conforme o tipo escolhido.</p>
            <span asp-validation-for="Value" class="text-red-400 text-xs"></span>
        </div>

        <div>
            <label asp-for="ExpiryDate" class="block text-sm font-medium mb-2">Validade (opcional)</label>
            <input asp-for="ExpiryDate" type="date" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 focus:outline-none focus:border-accent transition" />
            <p class="mt-1 text-xs text-white/40">Deixa vazio para um código sem limite de validade.</p>
            <span asp-validation-for="ExpiryDate" class="text-red-400 text-xs"></span>
        </div>

        <div class="flex items-center gap-3">
            <input asp-for="IsActive" class="accent-[color:var(--accent)]" />
            <label asp-for="IsActive" class="text-sm">Ativo</label>
        </div>

        <button type="submit" class="btn-primary">@SharedLocalizer["Save"]</button>
    </form>
</section>
