@{
    var path = Context.Request.Path.Value ?? string.Empty;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    bool IsActive(string target, params string[] aliases)
    {
        if (path.Equals(target, StringComparison.OrdinalIgnoreCase)) return true;
        return aliases.Any(alias => controller.Equals(alias, StringComparison.OrdinalIgnoreCase));
    }
}

<aside class="admin-sidebar" aria-label="Navegação do painel">
    <div class="admin-sidebar-inner">
        <div class="admin-sidebar-head">
            <div>
                <p class="admin-kicker">Área reservada</p>
                <p class="admin-brand">Painel Admin</p>
            </div>
            <span class="admin-status-dot" title="Sessão de administrador ativa"></span>
        </div>

        <nav class="admin-nav">
            <p class="admin-nav-label">Operação</p>
            <a href="/admin" class="admin-nav-link @(IsActive("/admin", "Admin") ? "active" : "")">
                <span class="admin-nav-icon">⌂</span><span>Resumo</span>
            </a>
            <a href="/AdminBookings" class="admin-nav-link @(IsActive("/AdminBookings", "AdminBookings") ? "active" : "")">
                <span class="admin-nav-icon">◷</span><span>Marcações</span>
            </a>
            <a href="/AdminAvailability" class="admin-nav-link @(IsActive("/AdminAvailability", "AdminAvailability") ? "active" : "")">
                <span class="admin-nav-icon">▦</span><span>Disponibilidade</span>
            </a>

            <p class="admin-nav-label">Conteúdo</p>
            <a href="/AdminGalleries" class="admin-nav-link @(IsActive("/AdminGalleries", "AdminGalleries") ? "active" : "")">
                <span class="admin-nav-icon">▧</span><span>Galerias</span>
            </a>
            <a href="/AdminSessionTypes" class="admin-nav-link @(IsActive("/AdminSessionTypes", "AdminSessionTypes") ? "active" : "")">
                <span class="admin-nav-icon">◇</span><span>Tipos de sessão</span>
            </a>
            <a href="/AdminSiteImages" class="admin-nav-link @(IsActive("/AdminSiteImages", "AdminSiteImages") ? "active" : "")">
                <span class="admin-nav-icon">▨</span><span>Imagens do site</span>
            </a>

            <p class="admin-nav-label">Comércio</p>
            <a href="/AdminOrders" class="admin-nav-link @(IsActive("/AdminOrders", "AdminOrders") ? "active" : "")">
                <span class="admin-nav-icon">▤</span><span>Encomendas</span>
            </a>
            <a href="/AdminPhotoPacks" class="admin-nav-link @(IsActive("/AdminPhotoPacks", "AdminPhotoPacks") ? "active" : "")">
                <span class="admin-nav-icon">▥</span><span>Packs de fotos</span>
            </a>
        </nav>

        <div class="admin-sidebar-foot">
            <a href="/" class="admin-site-link"><span>↗</span> Ver site público</a>
            <span class="admin-user-label">@User.Identity?.Name</span>
        </div>
    </div>
</aside>
