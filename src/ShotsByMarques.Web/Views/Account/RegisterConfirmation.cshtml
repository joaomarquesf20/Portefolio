@{
    ViewData["Title"] = "Confirma o teu email";
    var email = ViewData["Email"] as string;
}

<section class="relative flex min-h-screen flex-col justify-center overflow-hidden px-5 pb-24 pt-24 sm:px-8">
    <div class="flex justify-center">
        <div class="w-full max-w-[27rem]">
            <div class="rv mb-10">
                <p class="inline-flex items-center gap-3 text-[11px] font-medium uppercase tracking-[0.4em] text-black/50">
                    <span class="rule inline-block h-px w-10"></span>
                    Shots By Marques
                </p>
                <h1 class="mt-5 font-display text-4xl font-bold tracking-[-0.04em] text-[#141414]">Verifica o teu email</h1>
            </div>

            <div class="rv rv-d1 card p-8">
                @if (TempData["ConfirmationEmailError"] is string error)
                {
                    <div class="mb-5 rounded-md border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-700">@error</div>
                }
                @if (TempData["ConfirmationEmailSent"] is string sent)
                {
                    <div class="mb-5 rounded-md border border-green-300 bg-green-50 px-4 py-3 text-sm text-green-800">@sent</div>
                }

                <p class="text-sm leading-6 text-black/65">
                    Enviámos um link de confirmação para
                    <strong class="font-semibold text-[#141414]">@email</strong>.
                    Abre esse link para ativares a tua conta antes de iniciares sessão.
                </p>
                <p class="mt-4 text-xs leading-5 text-black/45">
                    Não recebeste o email? Verifica a pasta de spam ou pede um novo link.
                </p>

                <form asp-action="ResendConfirmationEmail" method="post" class="mt-6">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="email" value="@email" />
                    <button type="submit" class="btn-primary w-full text-center">Reenviar email de confirmação</button>
                </form>

                <p class="mt-7 text-center text-sm text-black/50">
                    <a asp-action="Login" class="font-medium text-[#a1843f] transition hover:text-[#8a7034] hover:underline">Voltar ao login</a>
                </p>
            </div>
        </div>
    </div>
</section>
