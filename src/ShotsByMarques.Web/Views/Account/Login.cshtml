@model ShotsByMarques.Web.ViewModels.LoginViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    ViewData["Title"] = SharedLocalizer["LoginTitle"];
}

<section class="relative flex min-h-screen flex-col justify-center overflow-hidden px-5 pb-24 pt-24 sm:px-8">
    <div class="flex justify-center">
        <div class="w-full max-w-[27rem]">
            <div class="rv mb-10">
                <p class="inline-flex items-center gap-3 text-[11px] font-medium uppercase tracking-[0.4em] text-black/50">
                    <span class="rule inline-block h-px w-10"></span>
                    Shots By Marques
                </p>
                <h1 class="mt-5 font-display text-4xl font-bold tracking-[-0.04em] text-[#141414]">@SharedLocalizer["LoginTitle"]</h1>
            </div>

            <div class="rv rv-d1 card p-8">
                @if (TempData["ExternalLoginError"] is string externalError)
                {
                    <div class="mb-5 rounded-md border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-700">@externalError</div>
                }

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="text-red-700 text-sm mb-4"></div>

                    <div class="mb-5">
                        <label asp-for="Email" class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.14em] text-black/50">@SharedLocalizer["Email"]</label>
                        <input asp-for="Email" class="w-full rounded-md border border-black/15 bg-white px-4 py-3 text-sm text-[#141414] outline-none transition placeholder:text-black/25 focus:border-[#a1843f] focus:shadow-[0_0_0_3px_rgba(161,132,63,0.12)]" />
                        <span asp-validation-for="Email" class="text-red-700 text-xs"></span>
                    </div>

                    <div class="mb-6">
                        <label asp-for="Password" class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.14em] text-black/50">@SharedLocalizer["Password"]</label>
                        <input asp-for="Password" class="w-full rounded-md border border-black/15 bg-white px-4 py-3 text-sm text-[#141414] outline-none transition placeholder:text-black/25 focus:border-[#a1843f] focus:shadow-[0_0_0_3px_rgba(161,132,63,0.12)]" />
                        <span asp-validation-for="Password" class="text-red-700 text-xs"></span>
                    </div>

                    <label class="mb-7 flex items-center gap-3 text-sm text-black/60">
                        <input asp-for="RememberMe" class="accent-[#a1843f]" /> Lembrar-me
                    </label>

                    <button type="submit" class="btn-primary w-full text-center">@SharedLocalizer["NavLogin"]</button>
                </form>

                @if (!string.IsNullOrWhiteSpace(Config["Authentication:Google:ClientId"]) && !string.IsNullOrWhiteSpace(Config["Authentication:Google:ClientSecret"]))
                {
                    <div class="my-7 flex items-center gap-4">
                        <span class="h-px flex-1 bg-black/10"></span>
                        <span class="text-[11px] uppercase tracking-[0.14em] text-black/40">ou</span>
                        <span class="h-px flex-1 bg-black/10"></span>
                    </div>
                    <form asp-action="ExternalLogin" method="post">
                        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                        <button type="submit" name="provider" value="Google"
                                class="flex w-full items-center justify-center gap-3 rounded-md border border-black/15 bg-white px-4 py-3 text-sm font-medium text-[#141414] transition hover:border-black/35 hover:bg-black/[0.02]">
                            <svg width="20" height="20" viewBox="0 0 48 48" aria-hidden="true">
                                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                            </svg>
                            Entrar com Google
                        </button>
                    </form>
                }

                <p class="mt-7 text-center text-sm text-black/50">
                    Ainda não tens conta?
                    <a asp-action="Register" class="font-medium text-[#a1843f] transition hover:text-[#8a7034] hover:underline">@SharedLocalizer["NavRegister"]</a>
                </p>
            </div>
        </div>
    </div>
</section>
