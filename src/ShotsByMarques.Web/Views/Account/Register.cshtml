@model ShotsByMarques.Web.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = SharedLocalizer["RegisterTitle"];
}

<section class="relative flex min-h-screen flex-col justify-center overflow-hidden px-5 pb-24 pt-24 sm:px-8">
    <div class="flex justify-center">
        <div class="w-full max-w-[27rem]">
            <div class="rv mb-10">
                <p class="inline-flex items-center gap-3 text-[11px] font-medium uppercase tracking-[0.4em] text-black/50">
                    <span class="rule inline-block h-px w-10"></span>
                    Shots By Marques
                </p>
                <h1 class="mt-5 font-display text-4xl font-bold tracking-[-0.04em] text-[#141414]">@SharedLocalizer["RegisterTitle"]</h1>
            </div>

            <div class="rv rv-d1 card p-8">
                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-red-700 text-sm mb-4"></div>

                    <div class="mb-5 grid grid-cols-2 gap-4">
                        <div>
                            <label asp-for="FirstName" class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.14em] text-black/50"></label>
                            <input asp-for="FirstName" class="w-full rounded-md border border-black/15 bg-white px-4 py-3 text-sm text-[#141414] outline-none transition placeholder:text-black/25 focus:border-[#a1843f] focus:shadow-[0_0_0_3px_rgba(161,132,63,0.12)]" />
                            <span asp-validation-for="FirstName" class="text-red-700 text-xs"></span>
                        </div>
                        <div>
                            <label asp-for="LastName" class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.14em] text-black/50"></label>
                            <input asp-for="LastName" class="w-full rounded-md border border-black/15 bg-white px-4 py-3 text-sm text-[#141414] outline-none transition placeholder:text-black/25 focus:border-[#a1843f] focus:shadow-[0_0_0_3px_rgba(161,132,63,0.12)]" />
                            <span asp-validation-for="LastName" class="text-red-700 text-xs"></span>
                        </div>
                    </div>

                    <div class="mb-5">
                        <label asp-for="Email" class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.14em] text-black/50">@SharedLocalizer["Email"]</label>
                        <input asp-for="Email" class="w-full rounded-md border border-black/15 bg-white px-4 py-3 text-sm text-[#141414] outline-none transition placeholder:text-black/25 focus:border-[#a1843f] focus:shadow-[0_0_0_3px_rgba(161,132,63,0.12)]" />
                        <span asp-validation-for="Email" class="text-red-700 text-xs"></span>
                    </div>

                    <div class="mb-5">
                        <label asp-for="Password" class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.14em] text-black/50"></label>
                        <div class="relative">
                            <input asp-for="Password" class="w-full rounded-md border border-black/15 bg-white px-4 py-3 pr-12 text-sm text-[#141414] outline-none transition placeholder:text-black/25 focus:border-[#a1843f] focus:shadow-[0_0_0_3px_rgba(161,132,63,0.12)]" />
                            <button type="button" data-password-toggle aria-controls="Password" aria-pressed="false" aria-label="Mostrar palavra-passe"
                                    class="absolute inset-y-0 right-0 flex w-12 items-center justify-center text-black/35 transition hover:text-[#a1843f] focus:outline-none">
                                <svg data-eye-show xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                                <svg data-eye-hide xmlns="http://www.w3.org/2000/svg" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-red-700 text-xs"></span>
                    </div>

                    <div class="mb-7">
                        <label asp-for="ConfirmPassword" class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.14em] text-black/50"></label>
                        <div class="relative">
                            <input asp-for="ConfirmPassword" class="w-full rounded-md border border-black/15 bg-white px-4 py-3 pr-12 text-sm text-[#141414] outline-none transition placeholder:text-black/25 focus:border-[#a1843f] focus:shadow-[0_0_0_3px_rgba(161,132,63,0.12)]" />
                            <button type="button" data-password-toggle aria-controls="ConfirmPassword" aria-pressed="false" aria-label="Mostrar palavra-passe"
                                    class="absolute inset-y-0 right-0 flex w-12 items-center justify-center text-black/35 transition hover:text-[#a1843f] focus:outline-none">
                                <svg data-eye-show xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                                <svg data-eye-hide xmlns="http://www.w3.org/2000/svg" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-red-700 text-xs"></span>
                    </div>

                    <button type="submit" class="btn-primary w-full text-center">@SharedLocalizer["NavRegister"]</button>
                </form>

                <p class="mt-7 text-center text-sm text-black/50">
                    Já tens conta?
                    <a asp-action="Login" class="font-medium text-[#a1843f] transition hover:text-[#8a7034] hover:underline">@SharedLocalizer["NavLogin"]</a>
                </p>
            </div>
        </div>
    </div>
</section>
