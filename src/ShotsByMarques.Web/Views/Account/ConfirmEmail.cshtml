@{
    ViewData["Title"] = "Confirmação de email";
    var confirmed = ViewData["Confirmed"] as bool? ?? false;
    var message = ViewData["ConfirmationMessage"] as string ?? "Não foi possível confirmar o email.";
}

<section class="relative flex min-h-screen flex-col justify-center overflow-hidden px-5 pb-24 pt-24 sm:px-8">
    <div class="flex justify-center">
        <div class="w-full max-w-[27rem]">
            <div class="rv mb-10">
                <p class="inline-flex items-center gap-3 text-[11px] font-medium uppercase tracking-[0.4em] text-black/50">
                    <span class="rule inline-block h-px w-10"></span>
                    Shots By Marques
                </p>
                <h1 class="mt-5 font-display text-4xl font-bold tracking-[-0.04em] text-[#141414]">Confirmação de email</h1>
            </div>

            <div class="rv rv-d1 card p-8 text-center">
                <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-full @(confirmed ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700")">
                    @if (confirmed)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                        </svg>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0 3.75h.008v.008H12v-.008zM10.34 3.94l-8.4 14.54A1.5 1.5 0 003.24 21h17.52a1.5 1.5 0 001.3-2.52l-8.4-14.54a1.5 1.5 0 00-2.6 0z" />
                        </svg>
                    }
                </div>

                <p class="text-sm leading-6 text-black/65">@message</p>

                <a asp-action="Login" class="btn-primary mt-7 inline-block w-full text-center">Ir para o login</a>
            </div>
        </div>
    </div>
</section>
