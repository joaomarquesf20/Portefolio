@model ShotsByMarques.Web.ViewModels.GalleryDetailViewModel
@{
    ViewData["Title"] = Model.Gallery.Title;
    // Session galleries (private, tied to a booking) are already paid with the
    // session — photos are ALWAYS included, never shown with a price, even if
    // they were uploaded with one before the gallery became private.
    var isSessionGallery = Model.Gallery.IsSession || Model.Gallery.BookingId.HasValue;
    var hasForSalePhotos = !isSessionGallery && Model.Photos.Any(p => p.IsForSale);
    var gridClass = hasForSalePhotos ? "gallery-grid pb-28" : "gallery-grid";
    var packs = ViewData["PhotoPacks"] as List<ShotsByMarques.Web.Models.PhotoPack> ?? new();
    var isSessionOwner = User.Identity!.IsAuthenticated
        && Model.Gallery.IsPrivate
        && Model.Gallery.Booking?.ClientUserId == User.FindFirstValue(System.Security.Claims.ClaimTypes.NameIdentifier);
    var isAdmin = User.IsInRole("Admin");
    var canDownload = isSessionOwner || isAdmin;
}

<section class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <div class="mb-10 fade-up">
        <a href="/portfolio" class="text-white/50 hover:text-accent text-sm transition">← @SharedLocalizer["Back"]</a>
        <h1 class="font-display text-4xl sm:text-5xl mt-3">@Model.Gallery.Title</h1>
        @if (!string.IsNullOrEmpty(Model.Gallery.Subtitle))
        {
            <p class="text-white/60 mt-2 text-lg">@Model.Gallery.Subtitle</p>
        }
        @if (!string.IsNullOrEmpty(Model.Gallery.Description))
        {
            <p class="text-white/40 mt-3 max-w-2xl">@Model.Gallery.Description</p>
        }
        @if (hasForSalePhotos)
        {
            <p class="text-white/40 text-xs mt-4 uppercase tracking-wide">@SharedLocalizer["WatermarkNote"]</p>
            @if (packs.Any())
            {
                <div class="flex flex-wrap gap-2 mt-4">
                    @foreach (var pack in packs)
                    {
                        <span class="rounded-full border border-emerald-500/40 bg-emerald-500/10 text-emerald-300 text-xs px-3 py-1.5">
                            🎉 @pack.Name — −@pack.DiscountPercent.ToString("0.#")% (@SharedLocalizer["PackFrom"] @pack.MinPhotos+ @SharedLocalizer["PhotosCount"])
                        </span>
                    }
                </div>
            }
        }
        else if (isSessionGallery && Model.Photos.Count > 0)
        {
            <p class="text-white/40 text-xs mt-4 uppercase tracking-wide">@SharedLocalizer["SessionPhotosIncluded"]</p>
        }
    </div>

    <div class="@gridClass">
        @foreach (var photo in Model.Photos)
        {
            var photoIsForSale = isSessionGallery ? false : photo.IsForSale;
            var photoPrice = photoIsForSale ? photo.Price.ToString("C", new System.Globalization.CultureInfo("pt-PT")) : string.Empty;
            <div class="gallery-item fade-up" data-gallery-id="@Model.Gallery.Id" data-photo-id="@photo.Id"
                 data-title="@photo.Title" data-price="@photoPrice" data-sale="@photoIsForSale.ToString().ToLowerInvariant()">
                <img src="@photo.PreviewUrl()" alt="@photo.Title" loading="lazy" />
                @if (photoIsForSale)
                {
                    <span class="selection-chip">✓</span>
                }
                else
                {
                    <span class="included-chip">@SharedLocalizer["IncludedInSession"]</span>
                }
                <div class="photo-overlay">
                    @if (photoIsForSale)
                    {
                        <div class="flex items-end justify-between gap-2">
                            <div>
                                <p class="font-medium text-sm">@photo.Title</p>
                                <p class="text-accent text-sm font-semibold">@photoPrice</p>
                            </div>
                            <button type="button" data-toggle
                                    data-add-text="+ @SharedLocalizer["AddToSelection"]"
                                    data-remove-text="✓ @SharedLocalizer["RemoveFromSelection"]"
                                    class="text-xs font-semibold rounded-full px-3 py-1.5 transition"
                                    style="background: var(--accent); color: #17130a;">
                                + @SharedLocalizer["AddToSelection"]
                            </button>
                        </div>
                    }
                    else if (canDownload)
                    {
                        <div class="flex items-end justify-between gap-2">
                            <div>
                                <p class="font-medium text-sm">@photo.Title</p>
                                <p class="text-white/60 text-xs mt-1">@SharedLocalizer["IncludedInSession"]</p>
                            </div>
                            <form asp-controller="Downloads" asp-action="SessionPhoto" asp-route-photoId="@photo.Id" method="post" data-session-download>
                                @Html.AntiForgeryToken()
                                <button class="text-xs font-semibold rounded-full px-3 py-1.5 transition"
                                        style="background: var(--accent); color: #17130a;">↓ @SharedLocalizer["Download"]</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div>
                            <p class="font-medium text-sm">@photo.Title</p>
                            <p class="text-white/60 text-xs mt-1">@SharedLocalizer["IncludedInSession"]</p>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    @if (Model.Photos.Count == 0)
    {
        <p class="text-center text-white/50 py-16">Esta galeria ainda não tem fotos.</p>
    }
</section>

@if (hasForSalePhotos)
{
    <!-- Sticky checkout bar (só em galerias com fotos à venda) -->
    <div class="bottom-bar max-w-3xl mx-auto px-4" data-checkout-container>
        <div class="card px-6 py-4 flex items-center justify-between gap-4">
            <div>
                <p class="text-sm text-white/60"><span data-cart-count>0</span> @SharedLocalizer["SelectedCount"]</p>
                <div class="flex items-center gap-4 mt-1">
                    <button data-select-all class="text-xs text-white/60 hover:text-accent transition">☑ @SharedLocalizer["SelectAll"]</button>
                    <button data-clear-cart class="text-xs text-white/40 hover:text-accent transition">@SharedLocalizer["ClearSelection"]</button>
                </div>
            </div>
            <button data-checkout-continue class="btn-primary hidden">@SharedLocalizer["ContinueCheckout"] →</button>
        </div>
    </div>
}

@if (Model.Gallery.IsSession && canDownload && Model.Photos.Count > 0)
{
    <!-- Download all button for session owners (photos already paid with the session) -->
    <div class="bottom-bar max-w-3xl mx-auto px-4">
        <div class="card px-6 py-4 flex items-center justify-between gap-4">
            <div>
                <p class="text-sm text-white/60">@SharedLocalizer["SessionPhotosHint"]</p>
            </div>
            <button data-download-all data-done-text="@SharedLocalizer["DownloadAll"]" class="btn-primary">↓ @SharedLocalizer["DownloadAll"]</button>
        </div>
    </div>
}
