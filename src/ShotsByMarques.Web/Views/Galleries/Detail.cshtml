@model ShotsByMarques.Web.ViewModels.GalleryDetailViewModel
@{
    ViewData["Title"] = Model.Gallery.Title;
    // Session galleries (private, tied to a booking) are already paid with the
    // session — photos are ALWAYS included, never shown with a price, even if
    // they were uploaded with one before the gallery became private.
    var isSessionGallery = Model.Gallery.IsSession || Model.Gallery.BookingId.HasValue;
    var hasForSalePhotos = !isSessionGallery && Model.Photos.Any(p => p.IsForSale);
    var gridClass = hasForSalePhotos ? "gallery-grid pb-28" : "gallery-grid";
    var packs = ViewData["PhotoPacks"] as List<ShotsByMarques.Web.Models.PhotoPack> ?? new();
    var isSessionOwner = User.Identity!.IsAuthenticated
        && Model.Gallery.IsPrivate
        && Model.Gallery.Booking?.ClientUserId == User.FindFirstValue(System.Security.Claims.ClaimTypes.NameIdentifier);
    var isAdmin = User.IsInRole("Admin");
    var canDownload = isSessionOwner || isAdmin;
}

<style>
    /* ============================================================
       Detalhe da galeria — linguagem editorial CLARA (papel/tinta/camel).
       Grelha controlada pelo utilizador, 3 vistas + contador de colunas:
         justified "Formato Original" — linhas justificadas Flickr/Pixieset,
                                        proporções nativas (sem crop)
         squares "Quadrados" — grelha de quadrados; nº de colunas escolhido
                               pelo cliente (2 a 5, preferência gravada em
                               sbm_gcols; limite 3 no telemóvel)
         large "Coluna Grande" — coluna editorial grande (proporção nativa)
       Contratos do site.js preservados: .gallery-item, data-*, chips,
       .photo-overlay, .bottom-bar, data-toggle, data-cart-count, etc.
       (O site.js lê os .gallery-item por querySelectorAll no momento do
       clique: reempacotar em .gd-row NÃO muda a ordem do lightbox.)
       ============================================================ */

    /* ---------- grelha: base flex; as vistas por atributo data-layout ---------- */
    #gd .gallery-grid {
        columns: auto;
        column-gap: 6px;
        overflow-x: hidden;
        transition: opacity .22s ease;
    }

    /* espera calibrada: invisível até a primeira vista estar montada
       (rede de segurança: a animação força opacidade mesmo sem JS) */
    #gd .gallery-grid[data-ready="0"] {
        opacity: 0;
        animation: gdReady .45s ease 2.4s forwards;
    }

    @@keyframes gdReady {
        to { opacity: 1; }
    }

    /* ---------- vista JUSTIFICADA (linhas de altura homogénea) ---------- */
    #gd .gallery-grid[data-layout="justified"] {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    #gd .gd-row {
        display: flex;
        justify-content: flex-start;
        width: 100%;
    }

    #gd [data-layout="justified"] .gallery-item {
        margin-bottom: 0;
        flex: none;
    }

    #gd .gd-row .gallery-item img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover; /* wrapper com a proporção exata: só corta sub-pixel */
    }

    /* ---------- vista QUADRADOS (varrimento rápido, com crop assumido) ---------- */
    #gd .gallery-grid[data-layout="squares"] {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
        gap: 6px;
    }

    #gd [data-layout="squares"] .gallery-item {
        margin-bottom: 0;
        aspect-ratio: 1 / 1;
    }

    #gd [data-layout="squares"] .gallery-item img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* ---------- vista COLUNA GRANDE (editorial, proporção nativa) ---------- */
    #gd .gallery-grid[data-layout="large"] {
        display: block;
        max-width: 62rem;
    }

    #gd [data-layout="large"] .gallery-item {
        margin-bottom: clamp(1.5rem, 3.5vw, 2.75rem);
    }

    #gd [data-layout="large"] .gallery-item img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover; /* aspect-ratio é imposto por JS = proporção exata */
    }

    /* ---------- item: foto nua sobre papel ---------- */
    #gd .gallery-item {
        margin-bottom: 6px;
        border: none;
        border-radius: 0;
        background: transparent;
    }

    #gd .gallery-item:hover {
        border-color: transparent;
    }

    #gd .gallery-item img {
        transition: transform 1.1s cubic-bezier(.16, 1, .3, 1);
    }

    #gd .gallery-item:hover img {
        transform: scale(1.045);
    }

    /* seleção: anel camel crocante (contraste total no tema claro) */
    #gd .gallery-item.selected {
        outline: 2px solid #a1843f;
        outline-offset: -2px;
    }

    #gd .photo-overlay {
        background: linear-gradient(to top, rgba(0, 0, 0, .58), rgba(0, 0, 0, .06) 46%, transparent 62%);
    }

    /* chip de seleção: camel sólido com ✓ branco */
    #gd .selection-chip {
        background: #a1843f;
        color: #fff;
    }

    /* anti-theft "ghost": transparent div fully covering each photo —
       right-click / inspect targets the empty div, not the <img>.
       Layering keeps site.js working: ghost (1) < overlay+buttons (2) < chips (3). */
    #gd .gallery-ghost {
        position: absolute;
        inset: 0;
        z-index: 1;
    }

    #gd .photo-overlay {
        z-index: 2;
    }

    /* chip "incluído na sessão": vidro claro frosted */
    #gd .included-chip {
        z-index: 3;
        border-color: rgba(20, 20, 20, .12);
        background: rgba(250, 249, 247, .78);
        color: rgba(20, 20, 20, .65);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
    }

    /* botão de seleção: pill branca → camel no hover e quando selecionada */
    #gd [data-toggle] {
        background: #ffffff;
        color: #141414;
        transition: background-color .25s ease, color .25s ease;
    }

    #gd [data-toggle]:hover,
    #gd .gallery-item.selected [data-toggle] {
        background: #a1843f;
        color: #fff;
    }

    /* downloads do dono da sessão: pill camel */
    #gd [data-session-download] button {
        background: #a1843f;
        color: #fff;
        transition: filter .25s ease;
    }

    #gd [data-session-download] button:hover {
        filter: brightness(1.08);
    }

    /* ---------- barra de vistas + contador de colunas (editorial) ---------- */
    #gd .gd-layout-btn,
    #gd .gd-cols-btn {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .1rem 0 .35rem;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: rgba(20, 20, 20, .38);
        border-bottom: 2px solid transparent;
        transition: color .2s ease, border-color .2s ease;
    }

    #gd .gd-layout-btn:hover,
    #gd .gd-cols-btn:hover {
        color: #141414;
    }

    #gd .gd-layout-btn[aria-pressed="true"],
    #gd .gd-cols-btn[aria-pressed="true"] {
        color: #141414;
        border-color: #a1843f;
    }

    #gd .gd-layout-btn svg {
        width: 14px;
        height: 14px;
        display: block;
    }

    /* seletor de colunas: desligado nas vistas que ditam o próprio fluxo */
    #gd [data-cols-off] {
        opacity: .3;
        pointer-events: none;
        transition: opacity .2s ease;
    }

    #gd .gd-col-dot {
        font-size: 11px;
        line-height: 1;
        color: rgba(20, 20, 20, .22);
        cursor: default;
    }

    /* telemóvel: sem hover — legendas e botão sempre visíveis (como na Home) */
    @@media (max-width: 640px) {
        #gd .gallery-grid[data-layout="squares"] {
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 5px;
        }

        #gd .gallery-grid[data-layout="justified"] {
            gap: 5px;
        }

        #gd .photo-overlay {
            opacity: 1;
        }
    }
</style>

<section id="gd" class="pb-16 pt-10 sm:pt-14 sm:pb-24">

    <!-- ============ CABEÇALHO (papel, tipografia) ============ -->
    <div class="px-5 sm:px-8 lg:px-12">
        <div class="rv flex flex-wrap items-center gap-x-4 gap-y-2">
            <a href="/portfolio" class="group inline-flex items-center gap-2 text-[11px] font-medium uppercase tracking-[0.3em] text-black/45 transition hover:text-[#141414]">
                <span class="inline-block transition-transform duration-300 group-hover:-translate-x-1">←</span>
                @SharedLocalizer["Back"]
            </a>
            <span class="h-px w-6 bg-black/15"></span>
            <span class="text-[11px] font-medium uppercase tracking-[0.3em] text-[#a1843f]">@(Model.Gallery.IsSession ? "Sessão" : "Evento")</span>
        </div>

        <h1 class="rv rv-d1 mt-6 font-display text-[clamp(2.6rem,6vw,5rem)] font-bold leading-[0.98] tracking-[-0.03em] text-[#141414]">
            @Model.Gallery.Title
        </h1>
        <span class="rule mt-6 block h-px w-16"></span>

        @if (!string.IsNullOrEmpty(Model.Gallery.Subtitle))
        {
            <p class="rv mt-5 max-w-2xl text-lg leading-relaxed text-black/60">@Model.Gallery.Subtitle</p>
        }
        @if (!string.IsNullOrEmpty(Model.Gallery.Description))
        {
            <p class="rv rv-d1 mt-3 max-w-2xl leading-relaxed text-black/45">@Model.Gallery.Description</p>
        }

        <div class="rv rv-d2 mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
            <span class="text-[10px] font-medium uppercase tracking-[0.28em] text-black/45">@Model.Photos.Count @SharedLocalizer["PhotosCount"]</span>
            @if (hasForSalePhotos)
            {
                <span class="text-[10px] font-medium uppercase tracking-[0.28em] text-black/30">@SharedLocalizer["WatermarkNote"]</span>
            }
            else if (isSessionGallery && Model.Photos.Count > 0)
            {
                <span class="inline-flex items-center gap-2 text-[10px] font-medium uppercase tracking-[0.28em] text-[#a1843f]">
                    <span class="inline-block h-1 w-1 rotate-45 bg-[#a1843f]"></span>
                    @SharedLocalizer["SessionPhotosIncluded"]
                </span>
            }
        </div>

        @if (hasForSalePhotos && packs.Any())
        {
            <div class="rv rv-d2 mt-6 flex flex-wrap gap-2">
                @foreach (var pack in packs)
                {
                    <span class="inline-flex items-center gap-2.5 rounded-full border border-black/10 bg-white/70 px-4 py-2 text-[11px] font-medium tracking-wide text-black/60 backdrop-blur">
                        <span class="inline-block h-1 w-1 rotate-45 bg-[#a1843f]"></span>
                        @pack.Name — −@pack.DiscountPercent.ToString("0.#")% (@SharedLocalizer["PackFrom"] @pack.MinPhotos+ @SharedLocalizer["PhotosCount"])
                    </span>
                }
            </div>
        }
    </div>

    <!-- ============ BARRA DE VISTAS (grelha controlada pelo cliente) ============ -->
    <div class="rv mt-10 px-5 sm:mt-14 sm:px-8 lg:px-12">
        <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-b border-black/10 pb-3">
            <span class="text-[10px] font-semibold uppercase tracking-[0.28em] text-black/35">Vista</span>
            <div class="flex flex-wrap items-center gap-x-5 gap-y-2 sm:gap-x-7">
                <div class="flex items-center gap-5 sm:gap-7" role="group" aria-label="Vista da galeria">
                    <button type="button" data-layout-btn="justified" aria-pressed="true" class="gd-layout-btn" title="Proporções nativas, sem cortes">
                        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M1 2h9.5v5H1zM12 2h3v5h-3zM1 9h4v5H1zM6.5 9H15v5H6.5z"/></svg>
                        <span>Formato Original</span>
                    </button>
                    <button type="button" data-layout-btn="squares" aria-pressed="false" class="gd-layout-btn" title="Quadrados, varrimento rápido">
                        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M1 1h6v6H1zM9 1h6v6H9zM1 9h6v6H1zM9 9h6v6H9z"/></svg>
                        <span>Quadrados</span>
                    </button>
                    <button type="button" data-layout-btn="large" aria-pressed="false" class="gd-layout-btn" title="Coluna grande, detalhada">
                        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 1h8v14H4z"/></svg>
                        <span>Coluna grande</span>
                    </button>
                </div>
                <span class="hidden h-4 w-px bg-black/10 sm:block" aria-hidden="true"></span>
                <div class="flex items-center gap-2.5 sm:gap-3" role="group" data-cols-group aria-label="Colunas da vista em quadrados">
                    <span class="text-[10px] font-semibold uppercase tracking-[0.28em] text-black/35">Colunas:</span>
                    <button type="button" data-cols-btn="2" aria-pressed="false" class="gd-cols-btn" title="2 fotos por linha">2</button>
                    <span class="gd-col-dot" aria-hidden="true">·</span>
                    <button type="button" data-cols-btn="3" aria-pressed="true" class="gd-cols-btn" title="3 fotos por linha">3</button>
                    <span class="gd-col-dot" aria-hidden="true">·</span>
                    <button type="button" data-cols-btn="4" aria-pressed="false" class="gd-cols-btn" title="4 fotos por linha">4</button>
                    <span class="gd-col-dot" aria-hidden="true">·</span>
                    <button type="button" data-cols-btn="5" aria-pressed="false" class="gd-cols-btn" title="5 fotos por linha">5</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ GRELHA (IDs/classes usados pelo site.js — não alterar) ============ -->
    <div id="gd-grid" class="@gridClass mt-6 sm:mt-8" data-layout="justified" data-ready="0">
        @foreach (var photo in Model.Photos)
        {
            var photoIsForSale = isSessionGallery ? false : photo.IsForSale;
            var photoPrice = photoIsForSale ? photo.Price.ToString("C", new System.Globalization.CultureInfo("pt-PT")) : string.Empty;
            <div class="gallery-item rv" data-gallery-id="@Model.Gallery.Id" data-photo-id="@photo.Id"
                 data-title="@photo.Title" data-price="@photoPrice" data-sale="@photoIsForSale.ToString().ToLowerInvariant()"
                 data-secure-src="@photo.LargePreviewUrl()">
                <img src="@photo.ThumbUrl()" alt="@photo.Title" loading="lazy" />
                <div class="gallery-ghost" aria-hidden="true"></div>
                @if (photoIsForSale)
                {
                    <span class="selection-chip">✓</span>
                }
                else
                {
                    <span class="included-chip">@SharedLocalizer["IncludedInSession"]</span>
                }
                <div class="photo-overlay">
                    @if (photoIsForSale)
                    {
                        <div class="flex items-end justify-between gap-2">
                            <div class="min-w-0">
                                <p class="truncate font-display text-sm font-bold text-white">@photo.Title</p>
                                <p class="mt-0.5 text-[11px] font-semibold uppercase tracking-[0.2em] text-white/75">@photoPrice</p>
                            </div>
                            <button type="button" data-toggle
                                    data-add-text="+ @SharedLocalizer["AddToSelection"]"
                                    data-remove-text="✓ @SharedLocalizer["RemoveFromSelection"]"
                                    class="shrink-0 rounded-full px-3 py-1.5 text-xs font-semibold">
                                + @SharedLocalizer["AddToSelection"]
                            </button>
                        </div>
                    }
                    else if (canDownload)
                    {
                        <div class="flex items-end justify-between gap-2">
                            <div class="min-w-0">
                                <p class="truncate font-display text-sm font-bold text-white">@photo.Title</p>
                                <p class="mt-0.5 text-xs text-white/65">@SharedLocalizer["IncludedInSession"]</p>
                            </div>
                            <form asp-controller="Downloads" asp-action="SessionPhoto" asp-route-photoId="@photo.Id" method="post" data-session-download>
                                @Html.AntiForgeryToken()
                                <button class="shrink-0 rounded-full px-3 py-1.5 text-xs font-semibold">↓ @SharedLocalizer["Download"]</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="min-w-0">
                            <p class="truncate font-display text-sm font-bold text-white">@photo.Title</p>
                            <p class="mt-0.5 text-xs text-white/65">@SharedLocalizer["IncludedInSession"]</p>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    @if (Model.Photos.Count == 0)
    {
        <p class="px-5 py-24 text-center font-display text-2xl text-black/35">Esta galeria ainda não tem fotos.</p>
    }
</section>

@if (hasForSalePhotos)
{
    <!-- Barra sticky de checkout (só em galerias com fotos à venda) — vidro claro full-width -->
    <div class="bottom-bar" data-checkout-container>
        <div class="border-t border-black/10 bg-[#faf9f7]/90 px-5 py-4 shadow-[0_-14px_44px_-26px_rgba(20,20,20,0.4)] backdrop-blur-xl sm:px-8 lg:px-12">
            <div class="flex items-center justify-between gap-4">
                <div class="min-w-0">
                    <p class="flex items-baseline gap-2 text-sm text-black/55">
                        <span data-cart-count class="font-display text-xl font-bold tabular-nums text-[#a1843f]">0</span>
                        @SharedLocalizer["SelectedCount"]
                    </p>
                    <div class="mt-1.5 flex items-center gap-4">
                        <button data-select-all class="text-[11px] font-medium uppercase tracking-[0.16em] text-black/50 transition hover:text-[#a1843f]">☑ @SharedLocalizer["SelectAll"]</button>
                        <button data-clear-cart class="text-[11px] font-medium uppercase tracking-[0.16em] text-black/40 transition hover:text-[#a1843f]">@SharedLocalizer["ClearSelection"]</button>
                    </div>
                </div>
                <button data-checkout-continue class="hidden shrink-0 rounded-full bg-[#141414] px-6 py-3.5 text-sm font-semibold text-white transition duration-300 hover:-translate-y-0.5 hover:bg-[#a1843f]">@SharedLocalizer["ContinueCheckout"] →</button>
            </div>
        </div>
    </div>
}

@if (Model.Gallery.IsSession && canDownload && Model.Photos.Count > 0)
{
    <!-- Download all button for session owners (photos already paid with the session) -->
    <div class="bottom-bar">
        <div class="border-t border-black/10 bg-[#faf9f7]/90 px-5 py-4 shadow-[0_-14px_44px_-26px_rgba(20,20,20,0.4)] backdrop-blur-xl sm:px-8 lg:px-12">
            <div class="flex items-center justify-between gap-4">
                <p class="min-w-0 text-sm text-black/55">@SharedLocalizer["SessionPhotosHint"]</p>
                <button data-download-all data-done-text="@SharedLocalizer["DownloadAll"]" class="shrink-0 rounded-full bg-[#a1843f] px-6 py-3.5 text-sm font-semibold text-white transition duration-300 hover:-translate-y-0.5 hover:brightness-110">↓ @SharedLocalizer["DownloadAll"]</button>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // ============================================================
        // Vistas da grelha (view-local): justified / squares / large.
        // Nunca toca no site.js — todos os elementos preservam os seus
        // listeners (reparenting de nós mantém handlers e ordem DOM).
        // ============================================================
        var gdToggle = function () {
            var grid = document.getElementById("gd-grid");
            if (!grid || grid.dataset.gdInit) return;
            grid.dataset.gdInit = "1";

            var KEY = "sbm_glayout";
            var MODES = ["justified", "squares", "large"];
            var items = Array.prototype.slice.apply(grid.querySelectorAll(".gallery-item"));
            var ratios = {};
            var mode = null;
            var lastW = grid.clientWidth;
            var resizeTimer = null;

            // colunas preferidas (2 a 5; usado só pela vista de quadrados)
            var COLS_KEY = "sbm_gcols";
            var cols = 3;
            try {
                var savedCols = parseInt(localStorage.getItem(COLS_KEY), 10);
                if (savedCols >= 2 && savedCols <= 5) cols = savedCols;
            } catch (e) { /* storage opcional */ }

            function keyOf(item) { return item.getAttribute("data-photo-id"); }
            function gap() { return window.innerWidth < 640 ? 5 : 6; }
            function rowTarget() {
                var vw = window.innerWidth;
                return vw < 640 ? 205 : vw < 1024 ? 265 : 320;
            }

            // mede a proporção REAL de cada thumb (cache por photo id).
            // Se a medida falhar, assume 3:2 — placeholder seguro.
            function measure(item) {
                var id = keyOf(item);
                if (ratios[id]) return Promise.resolve(ratios[id]);
                var img = item.querySelector("img");
                var src = img ? img.getAttribute("src") : "";
                return new Promise(function (resolve) {
                    if (!src) { ratios[id] = 1.5; resolve(1.5); return; }
                    var probe = new Image();
                    var settled = false;
                    var finish = function (r) { if (!settled) { settled = true; resolve(r); } };
                    probe.onload = function () {
                        ratios[id] = probe.naturalWidth > 0 ? probe.naturalWidth / probe.naturalHeight : 1.5;
                        finish(ratios[id]);
                    };
                    probe.onerror = function () { ratios[id] = 1.5; finish(1.5); };
                    probe.src = src;
                    setTimeout(function () { finish(typeof ratios[id] === "number" ? ratios[id] : 1.5); }, 4000);
                });
            }
            function measureAll() { return Promise.all(items.map(measure)); }

            // volta a colocar os itens diretamente na grelha (ordem preservada)
            function clearRows() {
                if ("replaceChildren" in grid) {
                    grid.replaceChildren.apply(grid, items);
                } else {
                    grid.textContent = "";
                    items.forEach(function (it) { grid.appendChild(it); });
                }
                items.forEach(function (it) {
                    it.style.removeProperty("width");
                    it.style.removeProperty("aspect-ratio");
                });
            }

            // ---- JUSTIFICADA: linhas com altura homogénea, sem cortes ----
            function buildJustified() {
                var W = grid.clientWidth || window.innerWidth;
                var g = gap();
                var target = rowTarget();
                var rows = [];
                var cur = [];
                var sumR = 0;
                var i;
                for (i = 0; i < items.length; i++) {
                    cur.push(items[i]);
                    sumR += ratios[keyOf(items[i])];
                    var h = (W - g * (cur.length - 1)) / sumR;
                    if (h <= target) {
                        rows.push({ list: cur.slice(), sum: sumR, h: h });
                        cur = []; sumR = 0;
                    }
                }
                if (cur.length > 0) {
                    var hl = (W - g * (cur.length - 1)) / sumR;
                    rows.push({ list: cur.slice(), sum: sumR, h: Math.min(target, hl) });
                }

                grid.textContent = "";
                rows.forEach(function (row) {
                    var rowEl = document.createElement("div");
                    rowEl.className = "gd-row";
                    var rowH = Math.round(row.h);
                    rowEl.style.height = rowH + "px";
                    var widths = row.list.map(function (it) {
                        return Math.floor(ratios[keyOf(it)] * rowH);
                    });
                    // correção anti-arredondamento: a última foto fecha a linha em W
                    var used = widths.reduce(function (a, b) { return a + b; }, 0) + g * (row.list.length - 1);
                    widths[widths.length - 1] += (W - used);
                    row.list.forEach(function (it, j) {
                        it.style.width = widths[j] + "px";
                        rowEl.appendChild(it);
                    });
                    grid.appendChild(rowEl);
                });
                grid.dataset.ready = "1";
            }

            // ---- outro item grande: largura total, proporção nativa ----
            function buildLarge() {
                clearRows();
                items.forEach(function (it) {
                    var r = ratios[keyOf(it)] || 1.5;
                    it.style.aspectRatio = r.toFixed(4);
                });
                grid.dataset.ready = "1";
            }

            // ---- colunas personalizadas: só a vista QUADRADOS as usa. No
            // telemóvel limita a 3 para os quadrados não ficarem minúsculos.
            function applyCols() {
                if (mode !== "squares") return;
                var eff = window.innerWidth < 640 ? Math.min(cols, 3) : cols;
                grid.style.gridTemplateColumns = "repeat(" + eff + ", 1fr)";
            }

            // o seletor desliga-se nas vistas que ditam o próprio fluxo
            function updateColsBar() {
                var off = mode !== "squares";
                var g = document.querySelector("[data-cols-group]");
                if (g) {
                    if (off) { g.setAttribute("data-cols-off", "1"); } else { g.removeAttribute("data-cols-off"); }
                }
                document.querySelectorAll("[data-cols-btn]").forEach(function (b) {
                    var n = Number(b.getAttribute("data-cols-btn"));
                    b.setAttribute("aria-disabled", off ? "true" : "false");
                    b.setAttribute("aria-pressed", (!off && n === cols) ? "true" : "false");
                });
            }

            function setMode(m, persist) {
                if (MODES.indexOf(m) < 0) m = "justified";
                mode = m;
                grid.dataset.layout = m;
                grid.dataset.ready = "0";
                document.querySelectorAll("[data-layout-btn]").forEach(function (b) {
                    b.setAttribute("aria-pressed", b.getAttribute("data-layout-btn") === m ? "true" : "false");
                });
                if (persist) { try { localStorage.setItem(KEY, m); } catch (e) { /* storage opcional */ } }
                if (m === "squares") {
                    clearRows();
                    applyCols();
                    grid.dataset.ready = "1";
                } else {
                    grid.style.removeProperty("grid-template-columns");
                    measureAll().then(function () {
                        if (mode !== m) return; // o utilizador trocou de vista entretanto
                        if (m === "justified") { buildJustified(); } else { buildLarge(); }
                    });
                }
                updateColsBar();
            }

            document.querySelectorAll("[data-layout-btn]").forEach(function (b) {
                b.addEventListener("click", function () {
                    var m = b.getAttribute("data-layout-btn");
                    if (m !== mode) setMode(m, true);
                });
            });

            // seletor de colunas (ativo só na vista de quadrados)
            document.querySelectorAll("[data-cols-btn]").forEach(function (b) {
                b.addEventListener("click", function () {
                    if (mode !== "squares") return;
                    var n = Number(b.getAttribute("data-cols-btn"));
                    if (!(n >= 2 && n <= 5) || n === cols) return;
                    cols = n;
                    try { localStorage.setItem(COLS_KEY, String(n)); } catch (e) { /* storage opcional */ }
                    updateColsBar();
                    applyCols(); // pure CSS reflow — não é preciso remontar a grelha
                });
            });

            // re-justifica / re-aplica colunas quando a largura muda de verdade
            if ("ResizeObserver" in window) {
                new ResizeObserver(function () {
                    var w = grid.clientWidth;
                    var changed = Math.abs(w - lastW) >= 24;
                    lastW = w;
                    if (!changed) return;
                    clearTimeout(resizeTimer);
                    if (mode === "justified") {
                        resizeTimer = setTimeout(buildJustified, 160);
                    } else if (mode === "squares") {
                        resizeTimer = setTimeout(applyCols, 160); // recalcular o limite móvel
                    }
                }).observe(grid);
            } else {
                // navegador sem ResizeObserver: reage em resize de janela
                window.addEventListener("resize", function () {
                    if (mode !== "justified" && mode !== "squares") return;
                    clearTimeout(resizeTimer);
                    resizeTimer = setTimeout(mode === "squares" ? applyCols : buildJustified, 160);
                }, { passive: true });
            }

            try {
                var saved = null;
                try { saved = localStorage.getItem(KEY); } catch (e) { /* storage opcional */ }
                setMode(MODES.indexOf(saved) >= 0 ? saved : "justified", false);
            } catch (e) {
                clearRows();
                grid.dataset.ready = "1";
            }
        };
        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", gdToggle);
        } else {
            gdToggle();
        }
    </script>
}
