@model ShotsByMarques.Web.ViewModels.GalleryDetailViewModel
@{
    ViewData["Title"] = Model.Gallery.Title;
    // Session galleries (private, tied to a booking) are already paid with the
    // session — photos are ALWAYS included, never shown with a price, even if
    // they were uploaded with one before the gallery became private.
    var isSessionGallery = Model.Gallery.IsSession || Model.Gallery.BookingId.HasValue;
    var hasForSalePhotos = !isSessionGallery && Model.Photos.Any(p => p.IsForSale);
    var gridClass = hasForSalePhotos ? "gallery-grid pb-28" : "gallery-grid";
    var packs = ViewData["PhotoPacks"] as List<ShotsByMarques.Web.Models.PhotoPack> ?? new();
    var isSessionOwner = User.Identity!.IsAuthenticated
        && Model.Gallery.IsPrivate
        && Model.Gallery.Booking?.ClientUserId == User.FindFirstValue(System.Security.Claims.ClaimTypes.NameIdentifier);
    var isAdmin = User.IsInRole("Admin");
    var canDownload = isSessionOwner || isAdmin;
}

<style>
    /* Restyle do detalhe — compatível com site.css (masonry + lightbox + cart) mas
       no visual da nova linguagem (painéis escuros, hairlines, dourado). */
    #gd .gallery-grid { column-gap: .85rem; }
    #gd .gallery-item {
        margin-bottom: .85rem;
        border-radius: .9rem;
        border-color: rgba(255, 255, 255, .07);
        background: #0d0f12;
        transition: border-color .3s ease;
    }
    #gd .gallery-item img { transition: transform 1s cubic-bezier(.16, 1, .3, 1); }
    #gd .gallery-item:hover img { transform: scale(1.05); }
    #gd .gallery-item:hover { border-color: rgba(255, 255, 255, .16); }
    #gd .gallery-item.selected {
        outline: none;
        border-color: rgba(216, 169, 91, .9);
        box-shadow: 0 0 0 1px rgba(216, 169, 91, .9);
    }
    #gd .photo-overlay {
        background: linear-gradient(to top, rgba(8, 9, 11, .9), rgba(8, 9, 11, 0) 55%);
        transition: opacity .35s ease;
    }
    #gd .selection-chip { background: var(--accent); color: #17130a; }
    #gd .included-chip {
        top: .7rem;
        right: .7rem;
        border-color: rgba(255, 255, 255, .18);
        background: rgba(8, 9, 11, .55);
        color: rgba(255, 255, 255, .72);
    }
    @@media (max-width: 640px) {
        #gd .gallery-grid { columns: 2 190px; column-gap: .6rem; }
        #gd .gallery-item { margin-bottom: .6rem; border-radius: .7rem; }
    }
</style>

<section id="gd" class="mx-auto max-w-7xl px-5 pb-20 pt-14 sm:px-6 sm:pt-20 lg:px-10">

    <!-- ============ CABEÇALHO ============ -->
    <div class="rv">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
            <a href="/portfolio" class="group inline-flex items-center gap-2 text-[11px] font-medium uppercase tracking-[0.3em] text-white/45 transition hover:text-white">
                <span class="inline-block transition-transform duration-300 group-hover:-translate-x-1">←</span>
                @SharedLocalizer["Back"]
            </a>
            <span class="h-px w-6 bg-white/15"></span>
            <span class="text-[11px] font-medium uppercase tracking-[0.3em] text-gold">@(Model.Gallery.IsSession ? "Sessão" : "Evento")</span>
        </div>

        <h1 class="mt-6 font-display text-[clamp(2.6rem,6vw,5rem)] font-bold leading-[0.98] tracking-[-0.03em] text-white">
            @Model.Gallery.Title
        </h1>
        <div class="mt-6 inline-block h-px w-16 bg-gold"></div>

        @if (!string.IsNullOrEmpty(Model.Gallery.Subtitle))
        {
            <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/65">@Model.Gallery.Subtitle</p>
        }
        @if (!string.IsNullOrEmpty(Model.Gallery.Description))
        {
            <p class="mt-3 max-w-2xl leading-relaxed text-white/45">@Model.Gallery.Description</p>
        }

        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
            <span class="text-[10px] font-medium uppercase tracking-[0.28em] text-white/45">@Model.Photos.Count @SharedLocalizer["PhotosCount"]</span>
            @if (hasForSalePhotos)
            {
                <span class="text-[10px] font-medium uppercase tracking-[0.28em] text-white/30">@SharedLocalizer["WatermarkNote"]</span>
            }
            else if (isSessionGallery && Model.Photos.Count > 0)
            {
                <span class="inline-flex items-center gap-2 text-[10px] font-medium uppercase tracking-[0.28em] text-gold">
                    <span class="inline-block h-1 w-1 rotate-45 bg-gold/80"></span>
                    @SharedLocalizer["SessionPhotosIncluded"]
                </span>
            }
        </div>

        @if (hasForSalePhotos && packs.Any())
        {
            <div class="rv rv-d1 mt-6 flex flex-wrap gap-2">
                @foreach (var pack in packs)
                {
                    <span class="inline-flex items-center gap-2.5 rounded-full border border-gold/30 bg-gold/[0.08] px-4 py-2 text-[11px] font-medium tracking-wide text-gold">
                        <span class="inline-block h-1 w-1 rotate-45 bg-gold/80"></span>
                        @pack.Name — −@pack.DiscountPercent.ToString("0.#")% (@SharedLocalizer["PackFrom"] @pack.MinPhotos+ @SharedLocalizer["PhotosCount"])
                    </span>
                }
            </div>
        }
    </div>

    <!-- ============ GRELHA MASONRY (IDs/classes usados pelo site.js — não alterar) ============ -->
    <div class="@gridClass mt-14">
        @foreach (var photo in Model.Photos)
        {
            var photoIsForSale = isSessionGallery ? false : photo.IsForSale;
            var photoPrice = photoIsForSale ? photo.Price.ToString("C", new System.Globalization.CultureInfo("pt-PT")) : string.Empty;
            <div class="gallery-item rv" data-gallery-id="@Model.Gallery.Id" data-photo-id="@photo.Id"
                 data-title="@photo.Title" data-price="@photoPrice" data-sale="@photoIsForSale.ToString().ToLowerInvariant()">
                <img src="@photo.PreviewUrl()" alt="@photo.Title" loading="lazy" />
                @if (photoIsForSale)
                {
                    <span class="selection-chip">✓</span>
                }
                else
                {
                    <span class="included-chip">@SharedLocalizer["IncludedInSession"]</span>
                }
                <div class="photo-overlay">
                    @if (photoIsForSale)
                    {
                        <div class="flex items-end justify-between gap-2">
                            <div>
                                <p class="text-sm font-semibold text-white">@photo.Title</p>
                                <p class="text-sm font-semibold text-gold">@photoPrice</p>
                            </div>
                            <button type="button" data-toggle
                                    data-add-text="+ @SharedLocalizer["AddToSelection"]"
                                    data-remove-text="✓ @SharedLocalizer["RemoveFromSelection"]"
                                    class="shrink-0 rounded-full bg-gold px-3 py-1.5 text-xs font-semibold text-ink transition hover:brightness-110">
                                + @SharedLocalizer["AddToSelection"]
                            </button>
                        </div>
                    }
                    else if (canDownload)
                    {
                        <div class="flex items-end justify-between gap-2">
                            <div>
                                <p class="text-sm font-semibold text-white">@photo.Title</p>
                                <p class="mt-1 text-xs text-white/60">@SharedLocalizer["IncludedInSession"]</p>
                            </div>
                            <form asp-controller="Downloads" asp-action="SessionPhoto" asp-route-photoId="@photo.Id" method="post" data-session-download>
                                @Html.AntiForgeryToken()
                                <button class="shrink-0 rounded-full bg-gold px-3 py-1.5 text-xs font-semibold text-ink transition hover:brightness-110">↓ @SharedLocalizer["Download"]</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div>
                            <p class="text-sm font-semibold text-white">@photo.Title</p>
                            <p class="mt-1 text-xs text-white/60">@SharedLocalizer["IncludedInSession"]</p>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    @if (Model.Photos.Count == 0)
    {
        <p class="py-24 text-center font-display text-2xl text-white/40">Esta galeria ainda não tem fotos.</p>
    }
</section>

@if (hasForSalePhotos)
{
    <!-- Barra sticky de checkout (só em galerias com fotos à venda) -->
    <div class="bottom-bar" data-checkout-container>
        <div class="mx-auto max-w-3xl px-4 sm:px-6">
            <div class="flex items-center justify-between gap-4 rounded-2xl border border-white/10 bg-[#101319]/95 px-5 py-4 shadow-[0_24px_70px_-24px_rgba(0,0,0,0.9)] backdrop-blur-xl">
                <div class="min-w-0">
                    <p class="flex items-baseline gap-2 text-sm text-white/60">
                        <span data-cart-count class="font-display text-xl font-bold tabular-nums text-white">0</span>
                        @SharedLocalizer["SelectedCount"]
                    </p>
                    <div class="mt-1.5 flex items-center gap-4">
                        <button data-select-all class="text-[11px] font-medium uppercase tracking-[0.16em] text-white/50 transition hover:text-gold">☑ @SharedLocalizer["SelectAll"]</button>
                        <button data-clear-cart class="text-[11px] font-medium uppercase tracking-[0.16em] text-white/40 transition hover:text-gold">@SharedLocalizer["ClearSelection"]</button>
                    </div>
                </div>
                <button data-checkout-continue class="btn-primary hidden shrink-0">@SharedLocalizer["ContinueCheckout"] →</button>
            </div>
        </div>
    </div>
}

@if (Model.Gallery.IsSession && canDownload && Model.Photos.Count > 0)
{
    <!-- Download all button for session owners (photos already paid with the session) -->
    <div class="bottom-bar">
        <div class="mx-auto max-w-3xl px-4 sm:px-6">
            <div class="flex items-center justify-between gap-4 rounded-2xl border border-white/10 bg-[#101319]/95 px-5 py-4 shadow-[0_24px_70px_-24px_rgba(0,0,0,0.9)] backdrop-blur-xl">
                <p class="text-sm text-white/55">@SharedLocalizer["SessionPhotosHint"]</p>
                <button data-download-all data-done-text="@SharedLocalizer["DownloadAll"]" class="btn-primary shrink-0">↓ @SharedLocalizer["DownloadAll"]</button>
            </div>
        </div>
    </div>
}
