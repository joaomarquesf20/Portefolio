@model ShotsByMarques.Web.ViewModels.PortfolioViewModel
@{
    ViewData["Title"] = SharedLocalizer["NavPortfolio"];

    var pageCover = Model.Sessions.Concat(Model.Events)
        .Select(g => g.CoverUrl())
        .FirstOrDefault(c => !string.IsNullOrEmpty(c)) ?? "/sample-photos/cars-cover.svg";
    var totalPhotos = Model.Sessions.Sum(g => g.Photos.Count) + Model.Events.Sum(g => g.Photos.Count);
    var gi = 0; // índice contínuo das galerias (numeração editorial)
}

<!-- ============ HERO DA PÁGINA — banda cinematográfica ============ -->
<section class="relative overflow-hidden">
    <img src="@(ViewData["BgPortfolio"] ?? pageCover)" alt="" class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-[#08090b] via-[#08090b]/70 to-black/45"></div>
    <div class="grain absolute inset-0" aria-hidden="true"></div>

    <div class="relative z-[2] mx-auto max-w-7xl px-5 pb-14 pt-28 sm:px-6 sm:pb-20 sm:pt-36 lg:px-10">
        <p class="rv inline-flex items-center gap-3 text-[11px] font-medium uppercase tracking-[0.4em] text-white/55">
            <span class="inline-block h-px w-10 bg-gold"></span>
            Shots By Marques · Portefólio
        </p>
        <h1 class="rv rv-d1 mt-6 max-w-3xl font-display text-[clamp(2.8rem,6vw,5.5rem)] font-bold leading-[0.96] tracking-[-0.03em] text-white">
            @SharedLocalizer["NavPortfolio"]
        </h1>
        <p class="rv rv-d2 mt-6 max-w-xl text-lg leading-relaxed text-white/60">@SharedLocalizer["PortfolioSubtitle"]</p>

        <div class="rv rv-d3 mt-9 flex flex-wrap gap-x-10 gap-y-2 text-[10px] font-medium uppercase tracking-[0.3em] text-white/40">
            <span><span class="font-display text-base font-bold tabular-nums text-white">@Model.Sessions.Count</span>&nbsp;&nbsp;Sessões</span>
            <span><span class="font-display text-base font-bold tabular-nums text-white">@Model.Events.Count</span>&nbsp;&nbsp;Eventos</span>
            <span><span class="font-display text-base font-bold tabular-nums text-white">@totalPhotos</span>&nbsp;&nbsp;@SharedLocalizer["PhotosCount"]</span>
        </div>
    </div>
</section>

<!-- ============ SESSÕES ============ -->
@if (Model.Sessions.Any())
{
    <section id="sessoes" class="mx-auto max-w-7xl scroll-mt-24 px-5 pt-20 sm:px-6 sm:pt-28 lg:px-10">
        <div class="rv flex flex-wrap items-end justify-between gap-6 border-b border-white/[0.08] pb-6">
            <h2 class="font-display text-3xl font-bold tracking-[-0.02em] text-white sm:text-4xl">@SharedLocalizer["SessionsTitle"]</h2>
            <span class="text-[10px] font-medium uppercase tracking-[0.3em] text-white/40 tabular-nums">@Model.Sessions.Count galerias</span>
        </div>

        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var gallery in Model.Sessions)
            {
                gi++;
                <a href="/galeria/@gallery.Id" class="rv @(gi % 2 == 0 ? "rv-d1" : "") group relative block overflow-hidden rounded-xl border border-white/[0.08] bg-panel">
                    <div class="relative aspect-[4/5] overflow-hidden">
                        <img src="@gallery.CoverUrl()" alt="@gallery.Title" loading="lazy" class="h-full w-full object-cover transition duration-[1100ms] ease-out group-hover:scale-[1.06]" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent"></div>
                        <span class="absolute left-5 top-5 font-display text-xs text-white/60 tabular-nums">@(gi.ToString("00"))</span>
                        <span class="absolute right-5 top-5 rounded-full border border-white/20 px-2.5 py-1 text-[9px] font-medium uppercase tracking-[0.2em] text-white/70 backdrop-blur-sm">Sessão</span>
                        <div class="absolute inset-x-0 bottom-0 p-5 sm:p-6">
                            <h3 class="font-display text-xl font-bold tracking-[-0.02em] text-white sm:text-2xl">@gallery.Title</h3>
                            @if (!string.IsNullOrEmpty(gallery.Subtitle))
                            {
                                <p class="mt-1 line-clamp-1 text-sm text-white/55">@gallery.Subtitle</p>
                            }
                            <div class="mt-4 flex items-center justify-between">
                                <span class="text-[10px] uppercase tracking-[0.25em] text-white/45">@gallery.Photos.Count @SharedLocalizer["PhotosCount"]</span>
                                <span class="flex h-10 w-10 items-center justify-center rounded-full border border-white/20 text-white/70 transition duration-300 group-hover:border-gold group-hover:bg-gold group-hover:text-ink">→</span>
                            </div>
                        </div>
                    </div>
                </a>
            }
        </div>
    </section>
}

<!-- ============ EVENTOS ============ -->
@if (Model.Events.Any())
{
    <section id="eventos" class="mx-auto max-w-7xl scroll-mt-24 px-5 pt-20 sm:px-6 sm:pt-28 lg:px-10">
        <div class="rv flex flex-wrap items-end justify-between gap-6 border-b border-white/[0.08] pb-6">
            <h2 class="font-display text-3xl font-bold tracking-[-0.02em] text-white sm:text-4xl">@SharedLocalizer["EventsTitle"]</h2>
            <span class="text-[10px] font-medium uppercase tracking-[0.3em] text-white/40 tabular-nums">@Model.Events.Count galerias</span>
        </div>

        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var gallery in Model.Events)
            {
                gi++;
                <a href="/galeria/@gallery.Id" class="rv @(gi % 2 == 0 ? "rv-d1" : "") group relative block overflow-hidden rounded-xl border border-white/[0.08] bg-panel">
                    <div class="relative aspect-[4/5] overflow-hidden">
                        <img src="@gallery.CoverUrl()" alt="@gallery.Title" loading="lazy" class="h-full w-full object-cover transition duration-[1100ms] ease-out group-hover:scale-[1.06]" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent"></div>
                        <span class="absolute left-5 top-5 font-display text-xs text-white/60 tabular-nums">@(gi.ToString("00"))</span>
                        <span class="absolute right-5 top-5 rounded-full border border-white/20 px-2.5 py-1 text-[9px] font-medium uppercase tracking-[0.2em] text-white/70 backdrop-blur-sm">Evento</span>
                        <div class="absolute inset-x-0 bottom-0 p-5 sm:p-6">
                            <h3 class="font-display text-xl font-bold tracking-[-0.02em] text-white sm:text-2xl">@gallery.Title</h3>
                            @if (!string.IsNullOrEmpty(gallery.Subtitle))
                            {
                                <p class="mt-1 line-clamp-1 text-sm text-white/55">@gallery.Subtitle</p>
                            }
                            <div class="mt-4 flex items-center justify-between">
                                <span class="text-[10px] uppercase tracking-[0.25em] text-white/45">@gallery.Photos.Count @SharedLocalizer["PhotosCount"]</span>
                                <span class="flex h-10 w-10 items-center justify-center rounded-full border border-white/20 text-white/70 transition duration-300 group-hover:border-gold group-hover:bg-gold group-hover:text-ink">→</span>
                            </div>
                        </div>
                    </div>
                </a>
            }
        </div>
    </section>
}

@if (!Model.Sessions.Any() && !Model.Events.Any())
{
    <section class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-10">
        <p class="rv py-24 text-center font-display text-2xl text-white/40">Sem galerias publicadas.</p>
    </section>
}
