@model ShotsByMarques.Web.ViewModels.PortfolioViewModel
@{
    ViewData["Title"] = SharedLocalizer["NavPortfolio"];

    var sessions = Model.Sessions.ToList();
    var events = Model.Events.ToList();
    var totalPhotos = sessions.Sum(g => g.Photos.Count) + events.Sum(g => g.Photos.Count);
    var gi = 0; // numeração editorial contínua

    // Foto de fundo do cabeçalho: imagem definida no admin (ou a primeira capa publicada)
    var pageCover = sessions.Concat(events)
        .Select(g => g.CoverUrl())
        .FirstOrDefault(c => !string.IsNullOrEmpty(c)) ?? "/sample-photos/cars-cover.svg";

    // Padrão editorial de colunas — fecha sempre a linha em curso, para qualquer quantidade de galerias.
    // Ciclo base: 8+4 / 4+4+4 / 12 (panorâmica). A última célula é alargada se a linha não fechar.
    string TileClass(int i, int n)
    {
        if (n == 1) return "col-span-12 aspect-[21/9]";
        if (i == n - 1)
        {
            var r = (n - 1) % 6;
            if (r is 0 or 2) return "col-span-12 aspect-[21/9]";
            if (r == 3) return "col-span-12 md:col-span-8 aspect-[16/10] md:aspect-[8/5]";
        }
        return (i % 6) switch
        {
            0 => "col-span-12 aspect-[4/3] md:col-span-8 md:aspect-[16/10]",
            1 => "col-span-12 aspect-[4/5] md:col-span-4",
            2 => "col-span-6 aspect-square md:col-span-4 md:aspect-[4/5]",
            3 => "col-span-6 aspect-square md:col-span-4 md:aspect-[4/5]",
            4 => "col-span-12 aspect-[4/3] md:col-span-4 md:aspect-[4/5]",
            _ => "col-span-12 aspect-[21/9]"
        };
    }
}

<!-- ============ CABEÇALHO — foto lavada de luz, ecrã inteiro ============ -->
<section class="relative overflow-hidden">
    <img src="@(ViewData["BgPortfolio"] ?? pageCover)" alt="" class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-[#faf9f7]/80"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-[#faf9f7]/90 via-transparent to-[#faf9f7]"></div>
    <div class="grain absolute inset-0" aria-hidden="true"></div>

    <div class="relative z-[2] flex flex-wrap items-end justify-between gap-10 px-5 pb-16 pt-24 sm:px-8 sm:pt-32 lg:px-12">
        <div>
            <p class="rv inline-flex items-center gap-3 text-[11px] font-medium uppercase tracking-[0.4em] text-black/50">
                <span class="rule inline-block h-px w-10"></span>
                Shots By Marques · Portefólio
            </p>
            <h1 class="rv rv-d1 mt-5 font-display text-[clamp(2.8rem,7vw,6rem)] font-bold leading-[0.95] tracking-[-0.04em] text-[#141414]">
                @SharedLocalizer["NavPortfolio"]
            </h1>
            <p class="rv rv-d2 mt-5 max-w-xl text-lg leading-relaxed text-black/55">@SharedLocalizer["PortfolioSubtitle"]</p>
        </div>

        <div class="rv rv-d2 flex gap-10 sm:gap-14">
            <div>
                <span class="block font-display text-3xl font-bold tabular-nums text-[#141414] sm:text-4xl">@sessions.Count</span>
                <span class="mt-1 block text-[10px] font-medium uppercase tracking-[0.3em] text-black/40">Sessões</span>
            </div>
            <div>
                <span class="block font-display text-3xl font-bold tabular-nums text-[#141414] sm:text-4xl">@events.Count</span>
                <span class="mt-1 block text-[10px] font-medium uppercase tracking-[0.3em] text-black/40">Eventos</span>
            </div>
            <div>
                <span class="block font-display text-3xl font-bold tabular-nums text-[#141414] sm:text-4xl">@totalPhotos</span>
                <span class="mt-1 block text-[10px] font-medium uppercase tracking-[0.3em] text-black/40">@SharedLocalizer["PhotosCount"]</span>
            </div>
        </div>
    </div>
</section>

<!-- ============ SESSÕES — grelha fotográfica nua, edge-to-edge ============ -->
@if (sessions.Any())
{
    <section id="sessoes" class="scroll-mt-16">
        <div class="rv flex flex-wrap items-end justify-between gap-6 px-5 pb-7 pt-14 sm:px-8 sm:pt-24 lg:px-12">
            <div>
                <p class="inline-flex items-center gap-3 text-[11px] font-medium uppercase tracking-[0.4em] text-black/45">
                    <span class="rule inline-block h-px w-8"></span>
                    01
                </p>
                <h2 class="mt-3 font-display text-[clamp(1.9rem,4vw,3.2rem)] font-bold leading-[0.95] tracking-[-0.03em] text-[#141414]">
                    @SharedLocalizer["SessionsTitle"]
                </h2>
            </div>
            <span class="text-[10px] font-medium uppercase tracking-[0.3em] text-black/40 tabular-nums">@sessions.Count galerias</span>
        </div>

        <div class="grid grid-cols-12 gap-[6px]">
            @for (var ti = 0; ti < sessions.Count; ti++)
            {
                var gallery = sessions[ti];
                gi++;
                var big = (ti % 6) is 0 or 5;
                <a href="/galeria/@gallery.Id" class="rv @(gi % 2 == 0 ? "rv-d1" : "") group relative block overflow-hidden @TileClass(ti, sessions.Count)">
                    <img src="@gallery.CoverUrl()" alt="@gallery.Title" loading="lazy" class="h-full w-full object-cover transition duration-[1100ms] ease-out group-hover:scale-[1.04]" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/10 to-transparent"></div>
                    <span class="absolute left-4 top-4 font-display text-xs tabular-nums text-white/70">@(gi.ToString("00"))</span>
                    <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 p-5 sm:p-7">
                        <div class="min-w-0">
                            <p class="text-[10px] uppercase tracking-[0.3em] text-white/60">@gallery.Photos.Count @SharedLocalizer["PhotosCount"]</p>
                            <h3 class="mt-2 truncate font-display font-bold tracking-[-0.02em] text-white @(big ? "text-2xl sm:text-4xl" : "text-lg sm:text-2xl")">@gallery.Title</h3>
                            @if (!string.IsNullOrEmpty(gallery.Subtitle))
                            {
                                <p class="mt-1 truncate text-sm text-white/60">@gallery.Subtitle</p>
                            }
                        </div>
                        @if (big)
                        {
                            <span class="hidden h-12 w-12 shrink-0 items-center justify-center rounded-full border border-white/40 text-lg text-white transition duration-300 group-hover:bg-white group-hover:text-[#141414] sm:flex">→</span>
                        }
                    </div>
                </a>
            }
        </div>
    </section>
}

<!-- ============ EVENTOS — grelha fotográfica nua, edge-to-edge ============ -->
@if (events.Any())
{
    <section id="eventos" class="scroll-mt-16">
        <div class="rv flex flex-wrap items-end justify-between gap-6 px-5 pb-7 pt-14 sm:px-8 sm:pt-24 lg:px-12">
            <div>
                <p class="inline-flex items-center gap-3 text-[11px] font-medium uppercase tracking-[0.4em] text-black/45">
                    <span class="rule inline-block h-px w-8"></span>
                    02
                </p>
                <h2 class="mt-3 font-display text-[clamp(1.9rem,4vw,3.2rem)] font-bold leading-[0.95] tracking-[-0.03em] text-[#141414]">
                    @SharedLocalizer["EventsTitle"]
                </h2>
            </div>
            <span class="text-[10px] font-medium uppercase tracking-[0.3em] text-black/40 tabular-nums">@events.Count galerias</span>
        </div>

        <div class="grid grid-cols-12 gap-[6px]">
            @for (var ti = 0; ti < events.Count; ti++)
            {
                var gallery = events[ti];
                gi++;
                var big = (ti % 6) is 0 or 5;
                <a href="/galeria/@gallery.Id" class="rv @(gi % 2 == 0 ? "rv-d1" : "") group relative block overflow-hidden @TileClass(ti, events.Count)">
                    <img src="@gallery.CoverUrl()" alt="@gallery.Title" loading="lazy" class="h-full w-full object-cover transition duration-[1100ms] ease-out group-hover:scale-[1.04]" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/10 to-transparent"></div>
                    <span class="absolute left-4 top-4 font-display text-xs tabular-nums text-white/70">@(gi.ToString("00"))</span>
                    <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 p-5 sm:p-7">
                        <div class="min-w-0">
                            <p class="text-[10px] uppercase tracking-[0.3em] text-white/60">@gallery.Photos.Count @SharedLocalizer["PhotosCount"]</p>
                            <h3 class="mt-2 truncate font-display font-bold tracking-[-0.02em] text-white @(big ? "text-2xl sm:text-4xl" : "text-lg sm:text-2xl")">@gallery.Title</h3>
                            @if (!string.IsNullOrEmpty(gallery.Subtitle))
                            {
                                <p class="mt-1 truncate text-sm text-white/60">@gallery.Subtitle</p>
                            }
                        </div>
                        @if (big)
                        {
                            <span class="hidden h-12 w-12 shrink-0 items-center justify-center rounded-full border border-white/40 text-lg text-white transition duration-300 group-hover:bg-white group-hover:text-[#141414] sm:flex">→</span>
                        }
                    </div>
                </a>
            }
        </div>
    </section>
}

@if (!sessions.Any() && !events.Any())
{
    <p class="rv px-5 pb-28 pt-10 text-center font-display text-2xl text-black/35">Sem galerias ainda publicadas.</p>
}

<div class="h-16 sm:h-28"></div>
