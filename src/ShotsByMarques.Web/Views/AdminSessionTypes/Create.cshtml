@model ShotsByMarques.Web.Models.SessionType
@{
    ViewData["Title"] = SharedLocalizer["NewSessionType"];
}

<section class="max-w-2xl mx-auto px-4 sm:px-6 py-12">
    <a href="/AdminSessionTypes" class="text-white/50 hover:text-accent text-sm transition">← @SharedLocalizer["Back"]</a>
    <h1 class="font-display text-4xl mt-3 mb-8 fade-up">@SharedLocalizer["NewSessionType"]</h1>

    <form asp-action="Create" method="post" class="card p-8 space-y-5 fade-up">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-red-400 text-sm"></div>

        <div>
            <label asp-for="Name" class="block text-sm font-medium mb-2"></label>
            <input asp-for="Name" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 focus:outline-none focus:border-accent transition" />
            <span asp-validation-for="Name" class="text-red-400 text-xs"></span>
        </div>

        <div>
            <label asp-for="Description" class="block text-sm font-medium mb-2"></label>
            <textarea asp-for="Description" rows="3" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 focus:outline-none focus:border-accent transition"></textarea>
        </div>

        <div>
            <label asp-for="Price" class="block text-sm font-medium mb-2">@SharedLocalizer["Price"] (€)</label>
            <input asp-for="Price" type="number" step="0.01" min="0" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 focus:outline-none focus:border-accent transition" />
        </div>

        <div>
            <label asp-for="SortOrder" class="block text-sm font-medium mb-2">Ordem</label>
            <input asp-for="SortOrder" type="number" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 focus:outline-none focus:border-accent transition" />
        </div>

        <div>
            <label asp-for="ImagePath" class="block text-sm font-medium mb-2">Imagem (URL, opcional)</label>
            <input asp-for="ImagePath" placeholder="/sample-photos/cars-cover.svg" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 focus:outline-none focus:border-accent transition" />
        </div>

        <button type="submit" class="btn-primary">@SharedLocalizer["Save"]</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
