@model ShotsByMarques.Web.ViewModels.BookingCreateViewModel
@{
    ViewData["Title"] = "Reservar sessão";
    var fmt = new System.Globalization.CultureInfo("pt-PT");
    var first = new DateTime(Model.Year, Model.Month, 1);
    var previous = first.AddMonths(-1);
    var next = first.AddMonths(1);
}

@functions {
    string CalendarClass(ShotsByMarques.Web.ViewModels.CalendarDay day)
    {
        if (!day.InMonth) return "booking-day outside";
        if (day.IsPast) return "booking-day past";
        return day.Status switch
        {
            ShotsByMarques.Web.Models.DayStatus.Available => "booking-day available",
            ShotsByMarques.Web.Models.DayStatus.Event => "booking-day event",
            ShotsByMarques.Web.Models.DayStatus.Maybe => "booking-day maybe",
            ShotsByMarques.Web.Models.DayStatus.Unavailable => "booking-day unavailable",
            _ => "booking-day undefined"
        };
    }
}

<section class="booking-page">
    <div class="booking-hero">
        <a href="/sessoes" class="booking-back">← Voltar às sessões</a>
        <div class="booking-hero-content">
            <div class="booking-service-image">
                <img src="@Model.SessionType!.ImagePath.ToWebPath("/sample-photos/cars-cover.svg")" alt="@Model.SessionType.Name" />
            </div>
            <div class="booking-service-copy">
                <p class="booking-eyebrow">SHOTS BY MARQUES · ANCEDE</p>
                <h1>@Model.SessionType.Name</h1>
                <p>@Model.SessionType.Description</p>
                <div class="booking-service-price"><strong>@Model.SessionType.Price.ToString("C", fmt)</strong><span>sessão fotográfica</span></div>
            </div>
        </div>
    </div>

    @if (!User.Identity!.IsAuthenticated)
    {
        <div class="booking-login-note">
            <span>Para finalizar a marcação precisas de iniciar sessão.</span>
            <a asp-controller="Account" asp-action="Login"
               asp-route-returnUrl="@Url.Action("Create", "Bookings", new { id = Model.SessionTypeId, year = Model.Year, month = Model.Month })">Iniciar sessão →</a>
        </div>
    }

    <form asp-action="Create" method="post" id="booking-form"
          data-session-type-id="@Model.SessionTypeId"
          data-mini-price="@Model.MiniPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
          data-mini-label="Reservar mini sessão"
          class="booking-layout">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="SessionTypeId" />
        <div asp-validation-summary="ModelOnly" class="booking-errors"></div>

        <main class="booking-flow">
            <section class="booking-step active" data-step="1">
                <div class="booking-step-heading">
                    <span class="booking-step-number">01</span>
                    <div><h2>Escolhe o dia</h2><p>Mostro apenas os dias em que tenho disponibilidade para sessões.</p></div>
                </div>
                <div class="booking-month-bar">
                    <a href="/sessoes/marcar/@Model.SessionTypeId?year=@previous.Year&month=@previous.Month" aria-label="Mês anterior">‹</a>
                    <strong>@fmt.DateTimeFormat.GetMonthName(Model.Month) @Model.Year</strong>
                    <a href="/sessoes/marcar/@Model.SessionTypeId?year=@next.Year&month=@next.Month" aria-label="Mês seguinte">›</a>
                </div>
                <div class="booking-weekdays">
                    @foreach (var weekday in new[] { "Seg", "Ter", "Qua", "Qui", "Sex", "Sáb", "Dom" })
                    {
                        <span>@weekday</span>
                    }
                </div>
                <div class="booking-calendar-grid">
                    @foreach (var day in Model.Days)
                    {
                        var selectable = day.InMonth && !day.IsPast && day.Status == ShotsByMarques.Web.Models.DayStatus.Available;
                        <button type="button"
                                data-cal-day
                                data-date="@day.Date.ToString("yyyy-MM-dd")"
                                data-available="@(selectable ? "true" : "false")"
                                data-status="@((int?)day.Status ?? 0)"
                                data-zone="@(day.Zone ?? "")"
                                data-location="@(day.Location ?? "")"
                                class="@CalendarClass(day)"
                                @if (!selectable) { <text>disabled</text> }>
                            <b>@day.Date.Day</b>
                            @if (day.InMonth && day.Status == ShotsByMarques.Web.Models.DayStatus.Available)
                            {
                                <small>@(day.WindowStart is not null ? $"{day.WindowStart:hh\\:mm}–{day.WindowEnd:hh\\:mm}" : "Disponível")</small>
                            }
                            else if (day.InMonth && day.Status == ShotsByMarques.Web.Models.DayStatus.Event)
                            {
                                <small>Evento</small>
                            }
                        </button>
                    }
                </div>
                <div class="booking-calendar-legend">
                    <span><i class="available"></i> Disponível</span>
                    <span><i class="event"></i> Evento</span>
                    <span><i class="closed"></i> Indisponível</span>
                </div>
                <input type="hidden" name="Date" id="Date" value="@(Model.Date == default ? "" : Model.Date.ToString("yyyy-MM-dd"))" />
                <span asp-validation-for="Date" class="booking-field-error"></span>
            </section>

            <section id="time-section" class="booking-step hidden" data-step="2">
                <div class="booking-step-heading">
                    <span class="booking-step-number">02</span>
                    <div><h2>Escolhe o horário</h2><p>Seleciona uma hora disponível para a tua sessão.</p></div>
                </div>
                <div id="selected-day-label" class="booking-selection-label"></div>
                <div id="slots" class="booking-slot-panel" data-hint="Escolhe um horário"></div>
                <p id="no-slots" class="hidden booking-empty-choice">Não há horários livres neste dia. Escolhe outro dia no calendário.</p>
                <input type="hidden" asp-for="TimeSlot" id="TimeSlot" />
                <span asp-validation-for="TimeSlot" class="booking-field-error"></span>
            </section>

            <section id="location-section" class="booking-step hidden" data-step="3">
                <div class="booking-step-heading">
                    <span class="booking-step-number">03</span>
                    <div><h2>Onde será a sessão?</h2><p>Indica o local onde queres a sessão. A base é em Ancede.</p></div>
                </div>

                <!-- Cobertura padrão: deslocação incluída na região base -->
                <div class="booking-coverage-note">
                    <span class="booking-coverage-icon">📍</span>
                    <div>
                        <strong>Deslocação incluída na região de Baião / Vila Real (raio padrão)</strong>
                        <small>Sessões até @Model.Travel.FreeKm km desde Ancede já contam no preço da sessão.</small>
                    </div>
                </div>

                <!-- Zona fixa do dia (definida pelo fotógrafo no calendário) — apenas informativa -->
                <div id="zone-fixed" class="booking-fixed-place hidden"><span>📍</span><div><small>Zona definida para este dia</small><strong id="zone-fixed-name"></strong></div></div>

                <div class="booking-location-grid">
                    <label>Local pretendido
                        <input asp-for="Location" id="Location" type="text" list="local-cities" autocomplete="off"
                               placeholder="Local pretendido (Ex: Parque da Cidade, Senhora da Graça, etc.)" />
                    </label>
                    <datalist id="local-cities">
                        @foreach (var city in Model.Cities)
                        {
                            <option value="@city.Name"></option>
                        }
                    </datalist>
                </div>

                <!-- Fora da área padrão: pedir orçamento dedicado -->
                <div class="booking-out-of-area">
                    <div>
                        <strong>A tua localização fica fora da área de cobertura padrão?</strong>
                        <small>Sessões mais distantes da base pedem uma avaliação dedicada de deslocação.</small>
                    </div>
                    <a href="/#contact" class="booking-out-of-area-link">Pedir Orçamento Personalizado</a>
                </div>

                <span asp-validation-for="Location" class="booking-field-error"></span>
            </section>

            <section class="booking-how-it-works">
                <div><span>01</span><b>Escolhes o horário</b><small>Vês apenas a minha disponibilidade real.</small></div>
                <div><span>02</span><b>Pagas 50% para reservar</b><small>O depósito confirma o teu lugar.</small></div>
                <div><span>03</span><b>Recebes as fotografias</b><small>O saldo é pago na entrega da galeria.</small></div>
            </section>
        </main>

        <aside class="booking-summary">
            <div class="booking-summary-inner">
                <p class="booking-eyebrow">RESUMO DA MARCAÇÃO</p>
                <h2>@Model.SessionType.Name</h2>
                <div class="booking-summary-line"><span>Dia</span><strong id="summary-date">Por escolher</strong></div>
                <div class="booking-summary-line"><span>Horário</span><strong id="summary-time">Por escolher</strong></div>
                <div class="booking-summary-line"><span>Local</span><strong id="summary-location">Por escolher</strong></div>
                <div class="booking-summary-total">
                    <div><span>Total da sessão</span><strong id="sum-total">@Model.TotalPrice.ToString("C", fmt)</strong></div>
                    <div><span>Deslocação</span><strong id="sum-travel">@Model.TravelFee.ToString("C", fmt)</strong></div>
                </div>
                <div class="booking-payment-split">
                    <div><small>Pagas agora</small><strong id="sum-deposit">@Model.DepositAmount.ToString("C", fmt)</strong><span>depósito de 50%</span></div>
                    <div><small>Na entrega</small><strong id="sum-balance">@Model.BalanceAmount.ToString("C", fmt)</strong><span>saldo restante</span></div>
                </div>
                <p id="travel-note" class="hidden booking-warning">Localidade não reconhecida. O valor final será confirmado antes da sessão.</p>
                <button type="submit" class="booking-submit" id="submit-btn" disabled><span id="submit-label">Confirmar marcação</span><small>Depósito: <b id="submit-deposit">@Model.DepositAmount.ToString("C", fmt)</b></small></button>
                <p class="booking-secure-note">Pagamento seguro através do Stripe</p>
            </div>
        </aside>
    </form>
</section>

<style>
    /* ==== Tema claro do fluxo de marcação (só nesta página) ==== */
    .booking-page { color: #141414; }
    .booking-page a.booking-back { color: rgba(20,20,20,.5); }
    .booking-page a.booking-back:hover { color: #a1843f; }
    .booking-hero { border-bottom-color: rgba(20,20,20,.1); }
    .booking-service-image { background: #ffffff; border-color: rgba(20,20,20,.1); }
    .booking-eyebrow { color: rgba(20,20,20,.45); }
    .booking-service-copy h1 { color: #141414; }
    .booking-page .booking-service-copy > p:not(.booking-eyebrow) { color: rgba(20,20,20,.55); }
    .booking-service-price strong { color: #a1843f; }
    .booking-service-price span { color: rgba(20,20,20,.45); }
    .booking-login-note { border-color: rgba(161,132,63,.35); background: rgba(161,132,63,.08); color: rgba(20,20,20,.65); }
    .booking-login-note a { color: #a1843f; }
    .booking-step { border-color: rgba(20,20,20,.1); background: #ffffff; }
    .booking-step-number { color: rgba(20,20,20,.35); }
    .booking-step-heading h2 { color: #141414; }
    .booking-page .booking-step-heading p { color: rgba(20,20,20,.5); }
    .booking-step.complete { border-color: rgba(161,132,63,.5); }
    .booking-month-bar strong { color: #141414; }
    .booking-month-bar a { border-color: rgba(20,20,20,.12); color: rgba(20,20,20,.6); }
    .booking-month-bar a:hover { border-color: rgba(20,20,20,.4); color: #141414; }
    .booking-weekdays { color: rgba(20,20,20,.35); }
    .booking-day { border-color: rgba(20,20,20,.1); background: rgba(20,20,20,.02); color: #141414; }
    .booking-page .booking-day small { color: rgba(20,20,20,.45); }
    .booking-day.available { border-color: rgba(161,132,63,.5); background: rgba(161,132,63,.1); color: #6d5420; }
    .booking-day.available:hover, .booking-day.available.selected { border-color: #a1843f; background: rgba(161,132,63,.16); box-shadow: 0 0 0 2px rgba(161,132,63,.18); }
    .booking-day.event { border-color: rgba(20,20,20,.22); background: rgba(20,20,20,.05); color: rgba(20,20,20,.6); }
    .booking-day.maybe { border-color: rgba(161,132,63,.35); color: #6d5420; }
    .booking-day.unavailable { border-color: rgba(20,20,20,.08); color: rgba(20,20,20,.3); text-decoration: line-through; }
    .booking-day.undefined { color: rgba(20,20,20,.3); }
    .booking-calendar-legend { color: rgba(20,20,20,.45); }
    .booking-calendar-legend i { background: rgba(20,20,20,.2); }
    .booking-calendar-legend i.available { background: #a1843f; }
    .booking-calendar-legend i.event { background: rgba(20,20,20,.4); }
    .booking-selection-label { color: rgba(20,20,20,.5); }
    .booking-loading, .booking-empty-choice { color: rgba(20,20,20,.45); }
    .booking-field-error, .booking-errors { color: #b42318; }
    .booking-location-grid label { color: rgba(20,20,20,.55); }
    .booking-page select, .booking-page input {
        background-color: #ffffff;
        border-color: rgba(20,20,20,.14);
        color: #141414;
    }
    .booking-fixed-place { border-color: rgba(20,20,20,.12); background: rgba(20,20,20,.02); }
    .booking-page .booking-fixed-place small { color: rgba(20,20,20,.45); }
    .booking-page .booking-fixed-place strong { color: #141414; }
    /* ==== Cobertura padrão + chamada para orçamento personalizado (passo 03) ==== */
    .booking-coverage-note {
        display: flex;
        gap: .8rem;
        align-items: flex-start;
        border: 1px solid rgba(161,132,63,.45);
        background: rgba(161,132,63,.08);
        border-radius: .75rem;
        padding: .9rem 1rem;
    }
    .booking-page .booking-coverage-note strong { color: #6d5420; }
    .booking-page .booking-coverage-note small { color: rgba(20,20,20,.55); }
    .booking-coverage-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        width: 2.1rem;
        height: 2.1rem;
        border-radius: 9999px;
        background: rgba(161,132,63,.16);
        font-size: .95rem;
    }
    .booking-out-of-area {
        display: flex;
        gap: .8rem;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        border: 1px dashed rgba(20,20,20,.25);
        border-radius: .75rem;
        padding: .9rem 1rem;
    }
    .booking-page .booking-out-of-area strong { color: #141414; }
    .booking-page .booking-out-of-area small { color: rgba(20,20,20,.5); }
    .booking-out-of-area-link {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        flex: 0 0 auto;
        border: 1px solid #a1843f;
        border-radius: 9999px;
        padding: .5rem .95rem;
        font-size: .813rem;
        font-weight: 600;
        color: #a1843f;
    }
    .booking-out-of-area-link:hover { background: rgba(161,132,63,.12); }
    .booking-how-it-works span { color: rgba(20,20,20,.35); }
    .booking-how-it-works b { color: rgba(20,20,20,.75); }
    .booking-how-it-works small { color: rgba(20,20,20,.4); }
    .booking-summary { border-color: rgba(20,20,20,.1); background: #ffffff; }
    .booking-page .booking-summary-inner > h2 { color: #141414; }
    .booking-page .booking-summary-line { border-top-color: rgba(20,20,20,.07); color: rgba(20,20,20,.45); }
    .booking-page .booking-summary-line strong { color: rgba(20,20,20,.8); }
    .booking-summary-total { border-top-color: rgba(20,20,20,.12); }
    .booking-page .booking-summary-total div { color: rgba(20,20,20,.5); }
    .booking-page .booking-summary-total strong { color: #141414; }
    .booking-payment-split div { border-color: rgba(20,20,20,.1); background: rgba(20,20,20,.02); }
    .booking-page .booking-payment-split small, .booking-page .booking-payment-split span { color: rgba(20,20,20,.4); }
    .booking-page .booking-payment-split strong { color: #141414; }
    .booking-warning { color: #8a6d1f; }
    .booking-submit {
        background: #a1843f;
        color: #faf9f7;
        box-shadow: none;
    }
    .booking-submit:hover { background: #8a7034; box-shadow: 0 10px 24px -14px rgba(161,132,63,.6); }
    .booking-page .booking-secure-note { color: rgba(20,20,20,.4); }

    /* Grelha de pills de horário (passo 02) — construída localmente em JS;
       o admin e a MiniSession continuam a usar a barra partilhada do site.js */
    .slot-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(20,20,20,.16);
        background: #ffffff;
        color: rgba(20,20,20,.85);
        border-radius: 9999px;
        padding: .65rem .25rem;
        font-size: .813rem;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
        box-shadow: none;
    }
    .slot-pill:hover:not(:disabled):not(.sel) {
        border-color: #a1843f;
        color: #a1843f;
        background: rgba(161,132,63,.08);
    }
    .slot-pill.sel {
        border-color: #a1843f;
        background: #a1843f;
        color: #faf9f7;
        box-shadow: 0 10px 24px -14px rgba(161,132,63,.6);
    }
    /* Ocupado: sem interação — opacity-40, cursor-not-allowed, bg-neutral-800 */
    .slot-pill:disabled,
    .slot-pill[disabled] {
        opacity: .4;
        cursor: not-allowed;
        background: #262626;
        border-color: #262626;
        color: #a3a3a3;
    }
</style>

@section Scripts {
<script>
(function () {
    const form = document.getElementById('booking-form');
    // Visitantes sem sessão não perdem tempo com o POST: o clique em
    // "Confirmar marcação" vai direto ao login; ao voltar da sessão,
    // regressam a esta página exata (mês escolhido incluído). O servidor
    // continua a defender o fluxo (302 para o login) para quem tem JS desligado.
    const authed = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(User.Identity?.IsAuthenticated ?? false));
    if (!authed) {
        const loginUrl = '/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname + window.location.search);
        form.addEventListener('submit', function (event) {
            event.preventDefault();
            window.location.href = loginUrl;
        });
    }
    const typeId = form.dataset.sessionTypeId;
    const dateInput = document.getElementById('Date');
    const timeInput = document.getElementById('TimeSlot');
    const slots = document.getElementById('slots');
    const timeSection = document.getElementById('time-section');
    const locationSection = document.getElementById('location-section');
    const locationInput = document.getElementById('Location');
    const summaryDate = document.getElementById('summary-date');
    const summaryTime = document.getElementById('summary-time');
    const summaryLocation = document.getElementById('summary-location');
    const cities = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Cities.Select(c => new { c.Name, c.Region, c.Lat, c.Lon })));
    const baseLat = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Travel.BaseLat));
    const baseLon = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Travel.BaseLon));
    const freeKm = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Travel.FreeKm));
    const pricePerKm = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Travel.PricePerKm));
    const sessionPrice = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SessionType.Price));

    function norm(value) { return (value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim(); }
    function money(value) { return Number(value).toLocaleString('pt-PT', { style: 'currency', currency: 'EUR' }); }
    function localDateLabel(value) { return new Date(value + 'T12:00:00').toLocaleDateString('pt-PT', { weekday: 'long', day: 'numeric', month: 'long' }); }
    function distanceKm(a, b, c, d) {
        const rad = Math.PI / 180, x = (c - a) * rad, y = (d - b) * rad;
        const q = Math.sin(x / 2) ** 2 + Math.cos(a * rad) * Math.cos(c * rad) * Math.sin(y / 2) ** 2;
        return 2 * 6371 * Math.asin(Math.min(1, Math.sqrt(q)));
    }
    function updateTotals() {
        const city = cities.find(item => norm(item.Name) === norm(locationInput.value));
        let fee = 0;
        if (city) {
            const km = Math.round(distanceKm(baseLat, baseLon, city.Lat, city.Lon));
            fee = km > freeKm ? Math.round((km - freeKm) * pricePerKm * 100) / 100 : 0;
            document.getElementById('travel-note').classList.add('hidden');
        } else {
            document.getElementById('travel-note').classList.toggle('hidden', !locationInput.value);
        }
        const total = sessionPrice + fee;
        const deposit = Math.round(total * 50) / 100;
        document.getElementById('sum-travel').textContent = money(fee);
        document.getElementById('sum-total').textContent = money(total);
        document.getElementById('sum-deposit').textContent = money(deposit);
        document.getElementById('sum-balance').textContent = money(total - deposit);
        document.getElementById('submit-deposit').textContent = money(deposit);
    }
    // Zona fixa definida pelo fotógrafo no calendário — apenas informativa;
    // o cliente escreve livremente o local da sessão.
    function showZoneInfo(button) {
        const zone = button.dataset.zone || '';
        document.getElementById('zone-fixed').classList.toggle('hidden', !zone);
        if (zone) document.getElementById('zone-fixed-name').textContent = zone;
    }
    function markStep(step) {
        document.querySelectorAll('.booking-step').forEach(section => section.classList.toggle('complete', Number(section.dataset.step) < step));
    }
    function refreshSubmit() {
        const ready = !!dateInput.value && !!timeInput.value && !!locationInput.value.trim();
        document.getElementById('submit-btn').disabled = !ready;
    }
    // Grelha de pills de horário (página de marcação do cliente). LOCAL a esta
    // página — o admin e a MiniSession continuam a usar SBM.buildSlotBar.
    function buildSlotGrid(options, opts) {
        opts = opts || {};
        const list = (options || [])
            .map(s => ({ time: s.time || s.Time, taken: !!(s.taken || s.Taken) }))
            .sort((a, b) => a.time.localeCompare(b.time));
        let selected = opts.selected || '';
        slots.className = 'grid grid-cols-3 gap-2.5 sm:grid-cols-4';
        slots.innerHTML = '';
        list.forEach(slot => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.textContent = slot.time;
            btn.className = 'slot-pill';
            if (slot.taken) {
                btn.disabled = true;
                btn.title = 'Ocupado';
                btn.setAttribute('aria-disabled', 'true');
            } else {
                btn.title = 'Livre';
                if (slot.time === selected) btn.classList.add('sel');
                btn.addEventListener('click', () => {
                    slots.querySelectorAll('.slot-pill.sel').forEach(item => item.classList.remove('sel'));
                    btn.classList.add('sel');
                    opts.onSelect && opts.onSelect(slot.time);
                });
            }
            slots.appendChild(btn);
        });
        if (list.some(item => item.taken)) {
            const note = document.createElement('p');
            note.className = 'col-span-full pt-1.5 text-xs text-black/50';
            note.textContent = 'As horas apagadas já estão ocupadas.';
            slots.appendChild(note);
        }
    }
    async function loadSlots(button) {
        const date = button.dataset.date;
        dateInput.value = date;
        timeInput.value = '';
        summaryDate.textContent = localDateLabel(date);
        summaryTime.textContent = 'Por escolher';
        refreshSubmit();
        summaryLocation.textContent = 'Por escolher';
        timeSection.classList.remove('hidden');
        locationSection.classList.add('hidden');
        document.querySelectorAll('[data-cal-day]').forEach(item => item.classList.remove('selected'));
        button.classList.add('selected');
        markStep(2);
        slots.innerHTML = '<p class="booking-loading">A verificar horários...</p>';
        document.getElementById('no-slots').classList.add('hidden');
        const response = await fetch('/Bookings/Available?sessionTypeId=' + typeId + '&date=' + date);
        const options = await response.json();
        const free = options.filter(item => !(item.taken || item.Taken));
        if (!free.length) {
            slots.innerHTML = '';
            document.getElementById('no-slots').classList.remove('hidden');
            return;
        }
        buildSlotGrid(options, {
            selected: '',
            onSelect: function (time) {
                timeInput.value = time;
                summaryTime.textContent = time;
                locationSection.classList.remove('hidden');
                showZoneInfo(button);
                markStep(3);
                refreshSubmit();
            }
        });
    }
    document.querySelectorAll('[data-cal-day][data-available="true"]').forEach(button => button.addEventListener('click', () => loadSlots(button)));
    locationInput.addEventListener('input', () => { summaryLocation.textContent = locationInput.value.trim() || 'Por escolher'; updateTotals(); refreshSubmit(); });
    updateTotals();
    refreshSubmit();
})();
</script>
}
