@model ShotsByMarques.Web.ViewModels.MiniSessionBookingViewModel
@{
    ViewData["Title"] = SharedLocalizer["MiniSessionBook"];
    var ptPT = System.Globalization.CultureInfo.GetCultureInfo("pt-PT");
    var open = Model.Remaining > 0;
    var scheduleable = open && Model.HasSchedule;
}

<!-- ============ CABEÇALHO — banda editorial do evento ============ -->
<section class="px-5 pb-10 pt-24 sm:px-8 sm:pt-32 lg:px-12">
    <div class="rv max-w-4xl">
        <p class="inline-flex items-center gap-3 text-[11px] font-medium uppercase tracking-[0.4em] text-black/50">
            <span class="rule inline-block h-px w-10"></span>
            Mini Sessões · Shots By Marques
        </p>
        <h1 class="rv rv-d1 mt-5 font-display text-[clamp(2.4rem,6vw,4.6rem)] font-bold leading-[0.95] tracking-[-0.04em] text-[#141414]">
            @Model.EventTitle
        </h1>

        <div class="rv rv-d2 mt-8 grid grid-cols-2 gap-x-8 gap-y-6 sm:grid-cols-4">
            <div>
                <span class="block text-[10px] font-medium uppercase tracking-[0.3em] text-black/40">@SharedLocalizer["Date"]</span>
                <span class="mt-1 block font-semibold text-[#141414]"><span class="capitalize">@Model.Date.ToString("dddd", ptPT)</span></span>
                <span class="block text-sm text-black/50">@Model.Date.ToString("dd MMMM yyyy", ptPT)</span>
            </div>
            <div>
                <span class="block text-[10px] font-medium uppercase tracking-[0.3em] text-black/40">@SharedLocalizer["Location"]</span>
                <span class="mt-1 block font-semibold text-[#141414]">@Model.Zone@(string.IsNullOrEmpty(Model.Location) ? "" : $" — {Model.Location}")</span>
            </div>
            <div>
                <span class="block text-[10px] font-medium uppercase tracking-[0.3em] text-black/40">@SharedLocalizer["Price"]</span>
                <span class="mt-1 block font-display text-xl font-bold text-[#a1843f]">@Model.Price.ToString("N0", ptPT) €</span>
            </div>
            <div>
                <span class="block text-[10px] font-medium uppercase tracking-[0.3em] text-black/40">@SharedLocalizer["Status"]</span>
                @if (open)
                {
                    <span class="mt-1 block font-semibold text-[#141414]">@String.Format(ptPT, SharedLocalizer["MiniSessionSlotsLeft"].ToString()!, Model.Remaining, Model.MaxMiniSessions)</span>
                }
                else
                {
                    <span class="mt-1 block font-semibold text-black/40">@SharedLocalizer["MiniSessionSoldOut"]</span>
                }
            </div>
        </div>

        <p class="rv rv-d2 mt-6 max-w-xl text-sm leading-relaxed text-black/55">@SharedLocalizer["MiniSessionDesc"]</p>
    </div>
</section>

<!-- ============ MARCAÇÃO ============ -->
<section class="px-5 pb-28 sm:px-8 lg:px-12">
    <div class="rv max-w-4xl">
        @if (!User.Identity!.IsAuthenticated)
        {
            <div class="border border-[#a1843f]/35 bg-[#a1843f]/10 px-5 py-4 text-sm text-[#141414]">
                Inicia sessão para concluir a reserva
                <a asp-controller="Account" asp-action="Login"
                   asp-route-returnUrl="@Url.Action("MiniSession", "Bookings", new { date = Model.Date.ToString("yyyy-MM-dd") })"
                   class="ml-1 font-semibold text-[#a1843f] underline underline-offset-4">@SharedLocalizer["NavLogin"] →</a>
            </div>
        }

        @if (!open)
        {
            <div class="mt-10 border-t border-black/10 py-14">
                <p class="font-display text-2xl font-bold text-black/45">@SharedLocalizer["MiniSessionSoldOut"]</p>
                <p class="mt-2 text-sm text-black/45">@SharedLocalizer["MiniSessionFull"]</p>
            </div>
        }
        else if (!Model.HasSchedule)
        {
            <div class="mt-10 border-t border-black/10 py-14">
                <p class="font-display text-2xl font-bold text-black/45">@SharedLocalizer["MiniSessionNoSchedule"]</p>
                <p class="mt-2 text-sm text-black/45">@SharedLocalizer["MiniSessionNoScheduleHint"]</p>
            </div>
        }
        else
        {
            <form asp-action="MiniSession" method="post" class="mt-2 border-t border-black/10 pt-8">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-red-700"></div>

                <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.3em] text-black/45">@SharedLocalizer["ChooseTime"]</p>
                <div id="mini-slots" data-hint="@SharedLocalizer["SlotBarHint"]"></div>
                @if (!Model.SlotOptions.Any(o => !o.Taken))
                {
                    <p class="mt-3 text-sm text-black/45">@SharedLocalizer["NoSlots"]</p>
                }
                <input type="hidden" asp-for="TimeSlot" id="TimeSlot" />
                <span asp-validation-for="TimeSlot" class="block mt-2 text-xs text-red-700"></span>

                <div class="mt-8 border-t border-black/10 pt-5">
                    <div class="flex justify-between text-sm"><span class="text-black/50">@SharedLocalizer["Price"]</span><span class="font-medium text-[#141414]">@Model.Price.ToString("N2", ptPT) €</span></div>
                    <div class="mt-3 flex justify-between border-t border-black/10 pt-3 font-semibold"><span class="text-[#141414]">@SharedLocalizer["TotalPrice"]</span><span class="text-[#a1843f]">@Model.Price.ToString("N2", ptPT) €</span></div>
                    <div class="mt-3 flex justify-between text-xs"><span class="text-black/50">@SharedLocalizer["Deposit"]</span><span class="text-black/60">@Model.DepositAmount.ToString("N2", ptPT) €</span></div>
                    <div class="mt-2 flex justify-between text-xs"><span class="text-black/50">@SharedLocalizer["Balance"]</span><span class="text-black/60">@Model.BalanceAmount.ToString("N2", ptPT) €</span></div>
                </div>

                <button type="submit" class="mt-8 inline-flex items-center justify-center gap-3 bg-[#a1843f] px-8 py-4 text-[11px] font-semibold uppercase tracking-[0.25em] text-[#faf9f7] transition hover:bg-[#8a7034]">
                    @SharedLocalizer["MiniSessionBook"] <span class="opacity-60">·</span> @SharedLocalizer["Deposit"] <span id="submit-deposit">@Model.DepositAmount.ToString("N2", ptPT) €</span>
                </button>
            </form>
        }
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var timeInput = document.getElementById("TimeSlot");
            var wrap = document.getElementById("mini-slots");
            var options = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.SlotOptions.Select(o => new { o.Time, o.Taken })));
            if (window.SBM && wrap && options.length > 0) {
                // Admin-style time bar: click a segment to pick the hour.
                window.SBM.buildSlotBar(wrap, options, {
                    selected: timeInput.value || "",
                    hint: wrap.dataset.hint || "",
                    onSelect: function (t) { timeInput.value = t; }
                });
            }
        })();
    </script>
}

<style>
    /* SBM slot-bar em tema claro (o JS partilha base escura com o admin) */
    #mini-slots.rounded-xl {
        background: #ffffff;
        border-color: rgba(20, 20, 20, 0.1);
    }
    #mini-slots > div:first-child > span:first-child {
        color: rgba(20, 20, 20, 0.5);
    }
    #mini-slots .text-accent {
        color: #a1843f;
    }
    #mini-slots > div:first-child > span:first-child > span:last-child {
        color: rgba(20, 20, 20, 0.4);
    }
    #mini-slots .slot-bar-seg {
        border-color: rgba(20, 20, 20, 0.14);
        background: rgba(20, 20, 20, 0.03);
        color: rgba(20, 20, 20, 0.8);
    }
    #mini-slots .slot-bar-seg.night {
        background: rgba(20, 20, 20, 0.05);
        border-color: rgba(20, 20, 20, 0.2);
        color: rgba(20, 20, 20, 0.7);
    }
    #mini-slots .slot-bar-seg:hover:not(:disabled) {
        background: #a1843f;
        border-color: #a1843f;
        color: #faf9f7;
    }
    #mini-slots .slot-bar-seg.sel,
    #mini-slots .slot-bar-seg.sel.night-sel {
        background: #a1843f;
        border-color: #a1843f;
        color: #faf9f7;
        box-shadow: none;
    }
</style>
