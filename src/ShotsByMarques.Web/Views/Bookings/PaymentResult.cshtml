@{
    ViewData["Title"] = ViewData["Title"] as string ?? "Pagamento";
    var state = ViewData["State"] as string ?? "unpaid";
    var isBalance = (ViewData["Title"] as string) == "Saldo";
    var metaRefresh = ViewData["MetaRefresh"] as string;
}

@if (!string.IsNullOrEmpty(metaRefresh))
{
    <meta http-equiv="refresh" content="@metaRefresh" />
}

<section class="max-w-xl mx-auto px-6 py-24 text-center">
    @if (state == "paid")
    {
        <div class="w-20 h-20 mx-auto rounded-full flex items-center justify-center mb-8"
             style="background: rgba(52,211,153,0.12); border: 1px solid rgba(52,211,153,0.4);">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
        </div>
        @if (isBalance)
        {
            <h1 class="font-display text-4xl">Saldo pago!</h1>
            <p class="text-white/60 mt-4">O saldo foi pago — as fotos da tua sessão já estão disponíveis para descarregar.</p>
            <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
                <a href="/downloads" class="btn-primary">@SharedLocalizer["GoDownloads"]</a>
                <a href="/as-minhas-marcacoes" class="btn-outline">@SharedLocalizer["NavMyBookings"]</a>
            </div>
        }
        else
        {
            <h1 class="font-display text-4xl">Depósito pago!</h1>
            <p class="text-white/60 mt-4">O depósito (50%) foi pago — a tua marcação está confirmada. O restante (50%) é pago na entrega das fotos.</p>
            <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
                <a href="/as-minhas-marcacoes" class="btn-primary">@SharedLocalizer["NavMyBookings"]</a>
                <a href="/portfolio" class="btn-outline">@SharedLocalizer["GoHome"]</a>
            </div>
        }
    }
    else if (state == "processing")
    {
        <div class="w-20 h-20 mx-auto rounded-full flex items-center justify-center mb-8"
             style="background: rgba(216,169,91,0.1); border: 1px solid rgba(216,169,91,0.4);">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-accent animate-spin" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
            </svg>
        </div>
        <h1 class="font-display text-4xl">Pagamento em processamento</h1>
        <p class="text-white/60 mt-4">Aprova o pagamento na app MB Way. Assim que for confirmado, fica registado na tua conta (pode demorar alguns segundos — recarrega a página).</p>
        <a href="/as-minhas-marcacoes" class="btn-primary mt-10 inline-block">@SharedLocalizer["NavMyBookings"]</a>
    }
    else
    {
        <div class="w-20 h-20 mx-auto rounded-full flex items-center justify-center mb-8"
             style="background: rgba(216,169,91,0.1); border: 1px solid rgba(216,169,91,0.4);">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
            </svg>
        </div>
        <h1 class="font-display text-4xl">Pagamento não confirmado</h1>
        <p class="text-white/60 mt-4">Não recebemos a confirmação do pagamento. Se já pagaste e isto é um erro, tenta novamente a partir de "As minhas marcações" ou contacta-nos.</p>
        <a href="/as-minhas-marcacoes" class="btn-primary mt-10 inline-block">@SharedLocalizer["NavMyBookings"]</a>
    }
</section>
