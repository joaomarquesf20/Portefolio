@model ShotsByMarques.Web.ViewModels.BookingMineViewModel
@{
    ViewData["Title"] = SharedLocalizer["NavMyBookings"];
    string StatusLabel(ShotsByMarques.Web.Models.BookingStatus s) => s switch
    {
        ShotsByMarques.Web.Models.BookingStatus.Confirmed => SharedLocalizer["BookingStatusConfirmed"],
        ShotsByMarques.Web.Models.BookingStatus.Cancelled => SharedLocalizer["BookingStatusCancelled"],
        ShotsByMarques.Web.Models.BookingStatus.Completed => SharedLocalizer["BookingStatusCompleted"],
        _ => SharedLocalizer["BookingStatusPending"]
    };
    string StatusColor(ShotsByMarques.Web.Models.BookingStatus s) => s switch
    {
        ShotsByMarques.Web.Models.BookingStatus.Confirmed => "bg-emerald-500/15 text-emerald-300",
        ShotsByMarques.Web.Models.BookingStatus.Cancelled => "bg-red-500/15 text-red-300",
        ShotsByMarques.Web.Models.BookingStatus.Completed => "bg-sky-500/15 text-sky-300",
        _ => "bg-yellow-500/15 text-yellow-300"
    };
}

<section class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <h1 class="font-display text-4xl mb-8 fade-up">@SharedLocalizer["NavMyBookings"]</h1>

    @if (Model.Bookings.Count == 0)
    {
        <p class="text-white/60">Ainda não tens marcações.</p>
        <a href="/sessoes" class="btn-primary mt-6 inline-block">@SharedLocalizer["BookNow"]</a>
    }

    @if (Model.Galleries.Count > 0)
    {
        <h2 class="font-display text-2xl mt-12 mb-5 fade-up">As minhas galerias de sessão 🔒</h2>
        <p class="text-white/40 text-sm mb-6 fade-up">Estas galerias são privadas — só tu consegues ver e comprar as fotos da tua sessão.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            @foreach (var gallery in Model.Galleries)
            {
                <a href="/galeria/@gallery.Id" class="card overflow-hidden group fade-up">
                    <img src="@gallery.CoverPath" alt="@gallery.Title" class="h-36 w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" />
                    <div class="p-5">
                        <h3 class="font-semibold">@gallery.Title</h3>
                        <p class="text-white/40 text-sm mt-1">@gallery.Photos.Count fotos</p>
                        <span class="inline-block mt-3 text-accent text-sm font-medium">Ver galeria →</span>
                    </div>
                </a>
            }
        </div>
    }

    <div class="space-y-4">
        @foreach (var booking in Model.Bookings)
        {
            <div class="card p-6 flex flex-wrap items-center justify-between gap-4 fade-up">
                <div>
                    <p class="font-semibold">@booking.SessionType?.Name</p>
                    <p class="text-white/40 text-sm mt-1">@booking.Start.ToLocalTime().ToString("dddd, dd 'de' MMMM yyyy 'às' HH:mm", new System.Globalization.CultureInfo("pt-PT"))</p>
                    @if (!string.IsNullOrEmpty(booking.Notes))
                    {
                        <p class="text-white/40 text-xs mt-1">“@booking.Notes”</p>
                    }
                </div>
                <div class="text-right">
                    <span class="text-xs font-semibold px-3 py-1 rounded-full @StatusColor(booking.Status)">@StatusLabel(booking.Status)</span>
                    <p class="text-accent font-semibold mt-2">@booking.Price.ToString("C", new System.Globalization.CultureInfo("pt-PT"))</p>
                </div>
            </div>
        }
    </div>
</section>
