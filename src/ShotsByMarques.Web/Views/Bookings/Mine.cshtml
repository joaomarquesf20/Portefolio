@model ShotsByMarques.Web.ViewModels.BookingMineViewModel
@{
    ViewData["Title"] = SharedLocalizer["NavMyBookings"];
    var pt = new System.Globalization.CultureInfo("pt-PT");
    string StatusLabel(ShotsByMarques.Web.Models.BookingStatus s) => s switch
    {
        ShotsByMarques.Web.Models.BookingStatus.Confirmed => SharedLocalizer["BookingStatusConfirmed"],
        ShotsByMarques.Web.Models.BookingStatus.Cancelled => SharedLocalizer["BookingStatusCancelled"],
        ShotsByMarques.Web.Models.BookingStatus.Completed => SharedLocalizer["BookingStatusCompleted"],
        _ => SharedLocalizer["BookingStatusPending"]
    };
    string StatusColor(ShotsByMarques.Web.Models.BookingStatus s) => s switch
    {
        ShotsByMarques.Web.Models.BookingStatus.Confirmed => "bg-emerald-500/15 text-emerald-300",
        ShotsByMarques.Web.Models.BookingStatus.Cancelled => "bg-red-500/15 text-red-300",
        ShotsByMarques.Web.Models.BookingStatus.Completed => "bg-sky-500/15 text-sky-300",
        _ => "bg-yellow-500/15 text-yellow-300"
    };
}

<section class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <h1 class="font-display text-4xl mb-8 fade-up">@SharedLocalizer["NavMyBookings"]</h1>

    @if (Model.Bookings.Count == 0)
    {
        <p class="text-white/60">Ainda não tens marcações.</p>
        <a href="/sessoes" class="btn-primary mt-6 inline-block">@SharedLocalizer["BookNow"]</a>
    }

    @if (Model.Galleries.Count > 0)
    {
        <h2 class="font-display text-2xl mt-12 mb-5 fade-up">As minhas galerias de sessão 🔒</h2>
        <p class="text-white/40 text-sm mb-6 fade-up">Estas galerias são privadas — só tu consegues ver e comprar as fotos da tua sessão.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            @foreach (var gallery in Model.Galleries)
            {
                <a href="/galeria/@gallery.Id" class="card overflow-hidden group fade-up">
                    <img src="@gallery.CoverUrl()" alt="@gallery.Title" class="h-36 w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" />
                    <div class="p-5">
                        <h3 class="font-semibold">@gallery.Title</h3>
                        <p class="text-white/40 text-sm mt-1">@gallery.Photos.Count fotos</p>
                        <span class="inline-block mt-3 text-accent text-sm font-medium">Ver galeria →</span>
                    </div>
                </a>
            }
        </div>
    }

    <div class="space-y-4">
        @foreach (var booking in Model.Bookings)
        {
            var isMini = booking.SessionType?.IsMiniSessionType == true;
            <div class="card p-6 fade-up">
                <div class="flex flex-wrap items-center justify-between gap-4">
                    <div>
                        <p class="font-semibold">@(isMini ? "🎪 " : "")@booking.SessionType?.Name</p>
                        <p class="text-white/40 text-sm mt-1">@ShotsByMarques.Web.Services.PortugalTime.FromUtc(booking.Start).ToString("dddd, dd 'de' MMMM yyyy 'às' HH:mm", pt)</p>
                        @if (!string.IsNullOrEmpty(booking.Location))
                        {
                            <p class="text-white/40 text-sm mt-0.5">📍 @booking.Location@(booking.TravelFee > 0 ? $" (+{booking.TravelFee.ToString("C", pt)} deslocação)" : "")</p>
                        }
                        @if (!string.IsNullOrEmpty(booking.Notes))
                        {
                            <p class="text-white/40 text-xs mt-1">“@booking.Notes”</p>
                        }
                    </div>
                    <div class="text-right">
                        <span class="text-xs font-semibold px-3 py-1 rounded-full @StatusColor(booking.Status)">@StatusLabel(booking.Status)</span>
                        <p class="text-accent font-semibold mt-2">@booking.Price.ToString("C", pt)</p>
                        @if (!isMini)
                        {
                            <p class="text-xs text-white/40 mt-0.5">@SharedLocalizer["Deposit"]: @booking.DepositAmount.ToString("C", pt) · @SharedLocalizer["Balance"]: @booking.BalanceAmount.ToString("C", pt)</p>
                        }
                    </div>
                </div>

                <div class="booking-calendar-actions mt-4 pt-4 border-t border-[color:var(--border)]">
                    <span class="booking-calendar-label">Adicionar ao calendário</span>
                    <a href="/sessoes/calendario/google/@booking.Id" class="booking-calendar-link" target="_blank" rel="noopener">Google Calendar</a>
                    <a href="/sessoes/calendario/ficheiro/@booking.Id" class="booking-calendar-link">iPhone / Android (.ics)</a>
                </div>

                @if (!isMini)
                {
                    <div class="flex flex-wrap items-center gap-3 mt-4 pt-4 border-t border-[color:var(--border)] text-sm">
                        @if (booking.DepositPaid)
                        {
                            <span class="text-xs font-semibold px-3 py-1.5 rounded-full bg-emerald-500/15 text-emerald-300">✓ @SharedLocalizer["DepositPaid"]</span>
                        }
                        else
                        {
                            <form asp-action="PayDeposit" asp-route-id="@booking.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button class="btn-primary !py-2 !px-4 !text-xs">@SharedLocalizer["PayDeposit"] — @booking.DepositAmount.ToString("C", pt)</button>
                            </form>
                        }

                        @if (booking.BalancePaid)
                        {
                            <span class="text-xs font-semibold px-3 py-1.5 rounded-full bg-emerald-500/15 text-emerald-300">✓ @SharedLocalizer["BalancePaid"]</span>
                        }
                        else if (booking.DepositPaid)
                        {
                            <form asp-action="PayBalance" asp-route-id="@booking.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button class="btn-outline !py-2 !px-4 !text-xs">@SharedLocalizer["PayBalance"] — @booking.BalanceAmount.ToString("C", pt)</button>
                            </form>
                        }
                        else
                        {
                            <span class="text-white/40 text-xs">@SharedLocalizer["BookingNeedsDeposit"]</span>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>
