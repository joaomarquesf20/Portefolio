@model ShotsByMarques.Web.ViewModels.AvailabilityCalendarViewModel
@using ShotsByMarques.Web.Models
@{
    ViewData["Title"] = SharedLocalizer["Availability"];
    var culture = System.Globalization.CultureInfo.CurrentCulture;
    var first = new DateTime(Model.Year, Model.Month, 1);
    var previous = first.AddMonths(-1);
    var next = first.AddMonths(1);
    var timeOptions = Enumerable.Range(0, 48)
        .Select(i => TimeSpan.FromMinutes(i * 30))
        .ToList();
    var localities = ShotsByMarques.Web.Services.PortugalCities.All
        .GroupBy(c => c.Region)
        .Select(group => new { Region = group.Key, Cities = group.Select(c => c.Name).ToList() });
}

@functions {
    string DayClass(CalendarDay day)
    {
        if (!day.InMonth) return "availability-day is-outside";
        if (day.IsPast) return "availability-day is-past";
        return day.Status switch
        {
            DayStatus.Available => "availability-day is-available",
            DayStatus.Unavailable => "availability-day is-unavailable",
            DayStatus.Maybe => "availability-day is-maybe",
            DayStatus.Event => "availability-day is-event",
            _ => "availability-day is-open"
        };
    }

    string StatusText(CalendarDay day)
    {
        return day.Status switch
        {
            DayStatus.Available => "Disponível",
            DayStatus.Unavailable => "Indisponível",
            DayStatus.Maybe => "Talvez",
            DayStatus.Event => "Evento",
            _ => "Sem definição"
        };
    }

    string TimeText(TimeSpan? time) => time?.ToString(@"hh\:mm") ?? "";
}

<section class="admin-availability-page max-w-7xl mx-auto px-4 sm:px-6 py-10">
    <a href="/admin" class="admin-back-link">← @SharedLocalizer["BackToDashboard"]</a>

    <header class="availability-header mt-6">
        <div>
            <p class="admin-section-eyebrow">Agenda</p>
            <h1 class="font-display text-4xl">Disponibilidade</h1>
            <p class="availability-intro">Marca no calendário os dias em que aceitas sessões. Cada dia pode ter horários próprios.</p>
        </div>
        <div class="availability-summary">
            <span><b>@Model.Days.Count(d => d.InMonth && d.Status == DayStatus.Available)</b> disponíveis</span>
            <span><b>@Model.Days.Count(d => d.InMonth && d.Status == DayStatus.Event)</b> eventos</span>
        </div>
    </header>

    <div class="availability-guide">
        <span class="guide-item"><i class="guide-dot available"></i><b>Disponível</b><small>aceita sessões</small></span>
        <span class="guide-item"><i class="guide-dot maybe"></i><b>Talvez</b><small>não aceita reservas</small></span>
        <span class="guide-item"><i class="guide-dot event"></i><b>Evento</b><small>mini sessões no local</small></span>
        <span class="guide-item"><i class="guide-dot unavailable"></i><b>Indisponível</b><small>dia bloqueado</small></span>
        <span class="guide-item"><i class="guide-dot open"></i><b>Sem definição</b><small>não aparece ao cliente</small></span>
    </div>

    <div class="availability-layout">
        <section class="availability-calendar-panel">
            <div class="availability-calendar-toolbar">
                <a href="/AdminAvailability?year=@previous.Year&month=@previous.Month" class="calendar-nav-button" aria-label="Mês anterior">‹</a>
                <div class="text-center">
                    <h2 class="font-display text-2xl capitalize">@culture.DateTimeFormat.GetMonthName(Model.Month) @Model.Year</h2>
                    <p class="text-xs text-white/35 mt-1">Clica num dia para o editar</p>
                </div>
                <a href="/AdminAvailability?year=@next.Year&month=@next.Month" class="calendar-nav-button" aria-label="Mês seguinte">›</a>
            </div>

            <div class="availability-weekdays">
                @foreach (var name in new[] { "Seg", "Ter", "Qua", "Qui", "Sex", "Sáb", "Dom" })
                {
                    <span>@name</span>
                }
            </div>
            <div class="availability-grid">
                @foreach (var day in Model.Days)
                {
                    <button type="button"
                            class="@DayClass(day)"
                            data-availability-day
                            data-date="@day.Date.ToString("yyyy-MM-dd")"
                            data-status="@((int?)day.Status ?? 0)"
                            data-title="@(day.EventTitle ?? "")"
                            data-zone="@(day.Zone ?? "")"
                            data-location="@(day.Location ?? "")"
                            data-max="@(day.MaxMiniSessions ?? 4)"
                            data-window-start="@TimeText(day.WindowStart)"
                            data-window-end="@TimeText(day.WindowEnd)"
                            data-mini-start="@TimeText(day.MiniStart)"
                            data-mini-end="@TimeText(day.MiniEnd)"
                            data-in-month="@(day.InMonth ? "true" : "false")"
                            data-past="@(day.IsPast ? "true" : "false")"
                            @if (!day.InMonth || day.IsPast)
                            {
                                <text>disabled</text>
                            }>
                        <span class="availability-day-top"><b>@day.Date.Day</b><em>@(day.Status is null ? "" : StatusText(day))</em></span>
                        @if (day.InMonth && !day.IsPast)
                        {
                            if (day.Status == DayStatus.Available || day.Status == DayStatus.Maybe)
                            {
                                <span class="availability-day-detail">@(day.WindowStart is not null ? $"{TimeText(day.WindowStart)} – {TimeText(day.WindowEnd)}" : "09:00 – 20:00")</span>
                                <span class="availability-day-place">@(day.Zone ?? "Qualquer zona")@(day.BookedCount > 0 ? $" · {day.BookedCount} reserva(s)" : "")</span>
                            }
                            else if (day.Status == DayStatus.Event)
                            {
                                <span class="availability-day-detail">@(day.Zone ?? "Local por definir")</span>
                                <span class="availability-day-place">@(day.MiniStart is not null ? $"{TimeText(day.MiniStart)} – {TimeText(day.MiniEnd)}" : "Horário por definir") · @day.MiniBooked/@(day.MaxMiniSessions ?? 4)</span>
                            }
                            else if (day.Status == DayStatus.Unavailable)
                            {
                                <span class="availability-day-detail">Dia bloqueado</span>
                            }
                            else
                            {
                                <span class="availability-day-detail muted">Ainda não marcado</span>
                            }
                        }
                    </button>
                }
            </div>

            <div class="availability-calendar-footer">
                <button type="button" id="bulk-open" class="btn-outline">☑ Selecionar vários dias</button>
                <span class="text-xs text-white/35">Os dias passados não podem ser alterados.</span>
            </div>
        </section>

        <aside id="bulk-panel" class="availability-bulk-panel hidden">
            <div class="panel-heading">
                <div><p class="admin-section-eyebrow">Ação em lote</p><h2 class="font-display text-xl"><span id="bulk-count">0</span> dias selecionados</h2></div>
                <button type="button" id="bulk-close" class="icon-close" aria-label="Fechar">×</button>
            </div>
            <p class="text-sm text-white/50">Seleciona os dias no calendário e aplica o mesmo estado e horário a todos.</p>
            <div class="bulk-status-grid">
                <button type="button" data-bulk-status="1" class="bulk-choice available">✓ Disponível</button>
                <button type="button" data-bulk-status="3" class="bulk-choice maybe">? Talvez</button>
                <button type="button" data-bulk-status="2" class="bulk-choice unavailable">× Indisponível</button>
                <button type="button" data-bulk-status="0" class="bulk-choice clear">− Limpar</button>
            </div>
            <div id="bulk-hours" class="space-y-3">
                <div class="time-select-row">
                    <label>Das<select id="bulk-start"><option value="">Escolhe</option>@foreach (var time in timeOptions) { <option value="@TimeText(time)">@TimeText(time)</option> }</select></label>
                    <span>até</span>
                    <label>Às<select id="bulk-end"><option value="">Escolhe</option>@foreach (var time in timeOptions) { <option value="@TimeText(time)">@TimeText(time)</option> }</select></label>
                </div>
            </div>
            <button type="button" id="bulk-apply" class="btn-primary w-full" disabled>Aplicar aos dias selecionados</button>
        </aside>
    </div>
</section>

<div id="availability-modal" class="availability-modal hidden" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="availability-modal-card">
        <div class="panel-heading">
            <div><p class="admin-section-eyebrow">Configurar dia</p><h2 id="modal-title" class="font-display text-2xl"></h2></div>
            <button type="button" id="modal-close" class="icon-close" aria-label="Fechar">×</button>
        </div>
        <form method="post" action="/AdminAvailability/SetStatus" id="availability-form" class="space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" name="date" id="modal-date" />
            <div>
                <p class="field-label">Como está este dia?</p>
                <div class="status-radio-grid">
                    <label><input type="radio" name="status" value="1" /><span class="status-radio available">✓<b>Disponível</b><small>aceitar sessões</small></span></label>
                    <label><input type="radio" name="status" value="3" /><span class="status-radio maybe">?<b>Talvez</b><small>não reservar</small></span></label>
                    <label><input type="radio" name="status" value="2" /><span class="status-radio unavailable">×<b>Indisponível</b><small>bloquear o dia</small></span></label>
                    <label><input type="radio" name="status" value="4" /><span class="status-radio event">★<b>Evento</b><small>mini sessões</small></span></label>
                    <label class="status-clear"><input type="radio" name="status" value="" /><span class="status-radio clear"><b>Limpar marcação</b><small>o dia fica sem definição</small></span></label>
                </div>
            </div>

            <div id="regular-fields" class="availability-fields hidden">
                <div class="field-section-heading"><b>Horário para sessões</b><small>Este horário substitui o padrão 09:00 – 20:00 apenas neste dia.</small></div>
                <div class="time-select-row">
                    <label>Das<select name="dayStart" id="day-start"><option value="">Padrão (09:00)</option>@foreach (var time in timeOptions) { <option value="@TimeText(time)">@TimeText(time)</option> }</select></label>
                    <span>até</span>
                    <label>Às<select name="dayEnd" id="day-end"><option value="">Padrão (20:00)</option>@foreach (var time in timeOptions) { <option value="@TimeText(time)">@TimeText(time)</option> }</select></label>
                </div>
                <div>
                    <label class="field-label" for="day-zone">Zona onde estarás <span>(opcional)</span></label>
                    <select name="zone" id="day-zone"><option value="">Qualquer zona</option>@foreach (var region in Model.Regions) { <option value="@region">@region</option> }</select>
                    <small class="field-hint">Se definires uma zona, o cliente só poderá escolher uma localidade dessa zona.</small>
                </div>
            </div>

            <div id="event-fields" class="availability-fields hidden">
                <div class="field-section-heading"><b>Dados do evento</b><small>O cliente vê este local e não pode alterá-lo.</small></div>
                <label class="field-label" for="event-title">Nome do evento <span>(opcional)</span></label>
                <input name="title" id="event-title" maxlength="200" placeholder="Ex.: Encontro de carros clássicos" />
                <label class="field-label" for="event-zone">Zona e local do evento</label>
                <div class="form-grid-2">
                    <select name="zone" id="event-zone"><option value="">Escolher zona</option>@foreach (var region in Model.Regions) { <option value="@region">@region</option> }</select>
                    <select name="location" id="event-location" disabled><option value="">Escolher localidade</option></select>
                </div>
                <label class="field-label" for="max-mini">Lugares de mini sessão</label>
                <select name="maxMiniSessions" id="max-mini">@for (var i = 1; i <= 10; i++) { <option value="@i">@i lugares</option> }</select>
                <div class="field-section-heading"><b>Horário das mini sessões</b><small>Define quando os clientes podem escolher um horário.</small></div>
                <div class="time-select-row">
                    <label>Das<select name="miniStart" id="mini-start"><option value="">Escolher</option>@foreach (var time in timeOptions) { <option value="@TimeText(time)">@TimeText(time)</option> }</select></label>
                    <span>até</span>
                    <label>Às<select name="miniEnd" id="mini-end"><option value="">Escolher</option>@foreach (var time in timeOptions) { <option value="@TimeText(time)">@TimeText(time)</option> }</select></label>
                </div>
            </div>

            <div class="modal-actions"><button type="button" id="modal-cancel" class="btn-outline">Cancelar</button><button type="submit" class="btn-primary">Guardar dia</button></div>
        </form>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const modal = document.getElementById('availability-modal');
    const form = document.getElementById('availability-form');
    const bulkPanel = document.getElementById('bulk-panel');
    const dayButtons = Array.from(document.querySelectorAll('[data-availability-day]'));
    const radios = Array.from(document.querySelectorAll('input[name="status"]'));
    const regularFields = document.getElementById('regular-fields');
    const eventFields = document.getElementById('event-fields');
    const dayZone = document.getElementById('day-zone');
    const eventZone = document.getElementById('event-zone');
    const eventLocation = document.getElementById('event-location');
    const localities = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(localities));
    let multiSelect = false;
    let selectedDates = new Set();
    let bulkStatus = '1';

    function fillEventLocations(keep) {
        eventLocation.innerHTML = '<option value="">Escolher localidade</option>';
        const group = localities.find(item => item.Region === eventZone.value);
        (group ? group.Cities : []).forEach(name => {
            const option = document.createElement('option'); option.value = name; option.textContent = name; eventLocation.appendChild(option);
        });
        eventLocation.disabled = !eventZone.value;
        if (keep && Array.from(eventLocation.options).some(option => option.value === keep)) eventLocation.value = keep;
    }
    eventZone.addEventListener('change', () => fillEventLocations(''));

    function setFields() {
        const checked = radios.find(radio => radio.checked);
        const status = checked ? checked.value : '';
        regularFields.classList.toggle('hidden', status !== '1' && status !== '3');
        eventFields.classList.toggle('hidden', status !== '4');
        dayZone.disabled = status !== '1' && status !== '3';
        eventZone.disabled = status !== '4';
        eventLocation.disabled = status !== '4' || !eventZone.value;
    }
    radios.forEach(radio => radio.addEventListener('change', setFields));

    function openDay(button) {
        const data = button.dataset;
        document.getElementById('modal-title').textContent = new Date(data.date + 'T12:00:00').toLocaleDateString('pt-PT', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
        document.getElementById('modal-date').value = data.date;
        radios.forEach(radio => { radio.checked = (radio.value === (data.status === '0' ? '' : data.status)); });
        document.getElementById('event-title').value = data.title || '';
        document.getElementById('max-mini').value = data.max || '4';
        document.getElementById('day-start').value = data.windowStart || '';
        document.getElementById('day-end').value = data.windowEnd || '';
        document.getElementById('mini-start').value = data.miniStart || '';
        document.getElementById('mini-end').value = data.miniEnd || '';
        dayZone.value = data.zone || '';
        eventZone.value = data.zone || '';
        fillEventLocations(data.location || '');
        setFields();
        modal.classList.remove('hidden');
    }

    function updateBulk() {
        document.getElementById('bulk-count').textContent = selectedDates.size;
        document.getElementById('bulk-apply').disabled = selectedDates.size === 0;
        dayButtons.forEach(button => button.classList.toggle('is-selected', selectedDates.has(button.dataset.date)));
    }
    dayButtons.forEach(button => button.addEventListener('click', () => {
        if (!multiSelect) { openDay(button); return; }
        const date = button.dataset.date;
        if (selectedDates.has(date)) selectedDates.delete(date); else selectedDates.add(date);
        updateBulk();
    }));

    document.getElementById('bulk-open').addEventListener('click', () => {
        multiSelect = true; selectedDates.clear(); bulkPanel.classList.remove('hidden'); updateBulk();
    });
    function closeBulk() {
        multiSelect = false; selectedDates.clear(); bulkPanel.classList.add('hidden'); updateBulk();
    }
    document.getElementById('bulk-close').addEventListener('click', closeBulk);
    document.querySelectorAll('[data-bulk-status]').forEach(button => button.addEventListener('click', () => {
        bulkStatus = button.dataset.bulkStatus;
        document.querySelectorAll('[data-bulk-status]').forEach(item => item.classList.toggle('is-active', item.dataset.bulkStatus === bulkStatus));
        document.getElementById('bulk-hours').classList.toggle('hidden', bulkStatus !== '1' && bulkStatus !== '3');
    }));
    document.getElementById('bulk-apply').addEventListener('click', () => {
        if (!selectedDates.size) return;
        const post = document.createElement('form'); post.method = 'post'; post.action = '/AdminAvailability/BulkSet';
        const add = (name, value) => { const input = document.createElement('input'); input.type = 'hidden'; input.name = name; input.value = value || ''; post.appendChild(input); };
        add('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
        selectedDates.forEach(date => add('dates', date)); add('status', bulkStatus); add('dayStart', document.getElementById('bulk-start').value); add('dayEnd', document.getElementById('bulk-end').value); add('year', '@Model.Year'); add('month', '@Model.Month');
        document.body.appendChild(post); post.submit();
    });
    document.getElementById('modal-close').addEventListener('click', () => modal.classList.add('hidden'));
    document.getElementById('modal-cancel').addEventListener('click', () => modal.classList.add('hidden'));
    modal.addEventListener('click', event => { if (event.target === modal) modal.classList.add('hidden'); });
    document.querySelector('[data-bulk-status="1"]').classList.add('is-active');
    document.getElementById('bulk-start').value = '09:00'; document.getElementById('bulk-end').value = '20:00';
})();
</script>
}