@model ShotsByMarques.Web.ViewModels.AvailabilityCalendarViewModel
@{
    ViewData["Title"] = SharedLocalizer["Availability"];
    var fmt = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat;
    var first = new DateTime(Model.Year, Model.Month, 1);
    var prev = first.AddMonths(-1);
    var next = first.AddMonths(1);
    var regions = Model.Days.Select(d => d.Zone).Where(z => !string.IsNullOrEmpty(z)).Distinct().OrderBy(z => z).ToList();
}

@functions {
    string CellBg(ShotsByMarques.Web.ViewModels.CalendarDay d)
    {
        if (!d.InMonth) return "bg-transparent border-white/5";
        if (d.IsPast) return "bg-white/[0.02] border-white/5";
        if (d.Status == ShotsByMarques.Web.Models.DayStatus.Available) return "bg-emerald-500/15 border-emerald-400/40";
        if (d.Status == ShotsByMarques.Web.Models.DayStatus.Unavailable) return "bg-red-500/10 border-red-400/40";
        if (d.Status == ShotsByMarques.Web.Models.DayStatus.Maybe) return "bg-amber-500/15 border-amber-400/40";
        if (d.Status == ShotsByMarques.Web.Models.DayStatus.Event) return "bg-violet-500/15 border-violet-400/40";
        return "bg-white/[0.03] border-white/10";
    }

    string CellGlyph(ShotsByMarques.Web.ViewModels.CalendarDay d)
    {
        if (d.Status == ShotsByMarques.Web.Models.DayStatus.Available) return "✓";
        if (d.Status == ShotsByMarques.Web.Models.DayStatus.Unavailable) return "✕";
        if (d.Status == ShotsByMarques.Web.Models.DayStatus.Maybe) return "?";
        if (d.Status == ShotsByMarques.Web.Models.DayStatus.Event) return "🎪";
        return "";
    }

    string GlyphClass(ShotsByMarques.Web.ViewModels.CalendarDay d)
    {
        if (d.Status == ShotsByMarques.Web.Models.DayStatus.Available) return "text-emerald-300";
        if (d.Status == ShotsByMarques.Web.Models.DayStatus.Unavailable) return "text-red-300";
        if (d.Status == ShotsByMarques.Web.Models.DayStatus.Maybe) return "text-amber-300";
        if (d.Status == ShotsByMarques.Web.Models.DayStatus.Event) return "text-violet-300";
        return "text-white/25";
    }
}

<section class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <a href="/admin" class="text-white/50 hover:text-accent text-sm transition inline-flex items-center gap-2 mb-6">← @SharedLocalizer["BackToDashboard"]</a>
    <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
        <div>
            <h1 class="font-display text-4xl fade-up">@SharedLocalizer["AvailabilityCalendar"]</h1>
            <p class="text-white/50 text-sm mt-3 max-w-2xl fade-up">@SharedLocalizer["AvailabilityCalendarHint"]</p>
        </div>
    </div>

    <div class="card p-6 mb-12 fade-up">
        <div class="flex items-center justify-between mb-6">
            <a href="/AdminAvailability?year=@prev.Year&month=@prev.Month" class="btn-outline !px-4 !py-2" aria-label="Mês anterior">←</a>
            <h2 class="font-display text-2xl">@fmt.GetMonthName(Model.Month) @Model.Year</h2>
            <div class="flex items-center gap-2">
                <a href="/AdminAvailability?year=@next.Year&month=@next.Month" class="btn-outline !px-4 !py-2" aria-label="Mês seguinte">→</a>
                <button type="button" id="bulk-toggle" class="btn-outline !px-3 !py-2 !text-xs">☑ @SharedLocalizer["BulkToggle"]</button>
            </div>
        </div>

        @* Bulk marking panel: select several days, set one status + shared hours *@
        <div id="bulk-panel" class="hidden rounded-xl border border-accent/40 bg-accent/5 p-4 mb-4">
            <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
                <p class="text-sm font-semibold text-accent">☑ <span id="bulk-count">0</span> @SharedLocalizer["DaysSelected"]</p>
                <button type="button" id="bulk-cancel" class="text-xs text-white/50 hover:text-white transition">✕ @SharedLocalizer["BulkCancel"]</button>
            </div>
            <div class="flex flex-wrap gap-2">
                <button type="button" data-bulk-status="1" class="bulk-status on">✓ @SharedLocalizer["StatusAvailable"]</button>
                <button type="button" data-bulk-status="3" class="bulk-status">? @SharedLocalizer["StatusMaybe"]</button>
                <button type="button" data-bulk-status="2" class="bulk-status">✕ @SharedLocalizer["StatusUnavailable"]</button>
                <button type="button" data-bulk-status="0" class="bulk-status">— @SharedLocalizer["BulkClearMark"]</button>
            </div>
            <div id="bulk-hours-wrap" class="mt-3">
                <div class="rounded-xl border border-white/10 bg-[color:var(--bg)] p-3"
                     data-hour-bar data-start-input="bulk-start" data-end-input="bulk-end"></div>
                <input type="hidden" id="bulk-start" name="bulkStart" />
                <input type="hidden" id="bulk-end" name="bulkEnd" />
            </div>
            <button type="button" id="bulk-apply" class="btn-primary w-full mt-3 !py-2.5" disabled>@SharedLocalizer["BulkApply"]</button>
        </div>

        <div class="grid grid-cols-7 gap-1.5">
            @for (int i = 1; i <= 7; i++)
            {
                <div class="text-center text-xs uppercase tracking-wide text-white/40 py-1">
                    @fmt.GetAbbreviatedDayName((System.DayOfWeek)(i % 7))
                </div>
            }
            @foreach (var d in Model.Days)
            {
                var dayHoursOverride = d.InMonth && !d.IsPast && d.WindowStart is not null && d.WindowEnd is not null
                    ? $"{d.WindowStart:hh\\:mm}–{d.WindowEnd:hh\\:mm}" : null;
                <button type="button"
                        data-calendar-day
                        data-date="@d.Date.ToString("yyyy-MM-dd")"
                        data-status="@((int?)d.Status ?? 0)"
                        data-max="@(d.MaxMiniSessions ?? 4)"
                        data-title="@(d.EventTitle ?? "")"
                        data-zone="@(d.Zone ?? "")"
                        data-location="@(d.Location ?? "")"
                        data-mini-start="@(d.MiniStart?.ToString(@"hh\:mm") ?? "")"
                        data-mini-end="@(d.MiniEnd?.ToString(@"hh\:mm") ?? "")"
                        data-day-start="@(d.WindowStart?.ToString(@"hh\:mm") ?? "")"
                        data-day-end="@(d.WindowEnd?.ToString(@"hh\:mm") ?? "")"
                        data-in-month="@(d.InMonth ? "true" : "false")"
                        data-past="@(d.IsPast ? "true" : "false")"
                        class="relative rounded-lg border p-1.5 sm:p-2 flex flex-col justify-between gap-1 min-h-[4.2rem] sm:min-h-[4.8rem] text-left transition
                               @CellBg(d)
                               @(d.InMonth && !d.IsPast ? "hover:scale-[1.03] hover:ring-2 hover:ring-accent/60 cursor-pointer" : "cursor-default")
                               @(d.InMonth ? "text-white/70" : "text-white/20")
                               @(d.Date == DateTime.Today ? "ring-2 ring-accent/70" : "")">
                    <span class="flex items-start justify-between w-full">
                        <span class="font-semibold leading-none text-sm">@d.Date.Day</span>
                        @if (d.InMonth && d.Status is not null)
                        {
                            <span class="text-[11px] leading-none @GlyphClass(d)">@CellGlyph(d)</span>
                        }
                    </span>
                    @if (d.InMonth && !d.IsPast)
                    {
                        <span class="text-[9px] sm:text-[10px] leading-tight space-y-0.5 block">
                            @if (d.Status == ShotsByMarques.Web.Models.DayStatus.Event)
                            {
                                <span class="block truncate @(d.Zone is null ? "text-violet-300" : "text-violet-200")">@(d.Zone ?? SharedLocalizer["StatusEvent"])</span>
                                <span class="block @(d.MiniStart is null ? "text-red-300/80" : "text-violet-200/70")">
                                    @if (d.MiniStart is not null && d.MiniEnd is not null)
                                    {
                                        <text>mini @d.MiniStart.Value.ToString(@"hh\:mm")–@d.MiniEnd.Value.ToString(@"hh\:mm")</text>
                                    }
                                    else
                                    {
                                        <text>@SharedLocalizer["NoMiniHours"]</text>
                                    }
                                </span>
                                <span class="block text-violet-200/80">@d.MiniBooked/@(d.MaxMiniSessions ?? 4) @SharedLocalizer["MiniShort"]</span>
                            }
                            else if (d.Status == ShotsByMarques.Web.Models.DayStatus.Unavailable)
                            {
                                <span class="block text-red-300/90">@SharedLocalizer["ClosedDay"]</span>
                            }
                            else
                            {
                                @if (dayHoursOverride is not null)
                                {
                                    <span class="block text-accent font-medium">⏱ @dayHoursOverride</span>
                                }
                                else if (d.Status is not null)
                                {
                                    // Marked day without explicit hours: standard 09:00–20:00 applies.
                                    <span class="block text-emerald-200/90">09:00–20:00</span>
                                }
                                else
                                {
                                    <span class="block text-white/30">@SharedLocalizer["NoWindowDay"]</span>
                                }
                                @if (!string.IsNullOrEmpty(d.Zone) || d.BookedCount > 0)
                                {
                                    <span class="block truncate text-white/55">
                                        @d.Zone@(d.BookedCount > 0 ? $" · {d.BookedCount} {SharedLocalizer["BookedShort"]}" : "")
                                    </span>
                                }
                            }
                        </span>
                    }
                </button>
            }
        </div>

        <div class="flex flex-wrap gap-x-5 gap-y-2 text-xs text-white/60 mt-5">
            <span class="flex items-center gap-1.5"><i class="inline-block w-3 h-3 rounded bg-white/[0.03] border border-white/10"></i> @SharedLocalizer["NoOverride"]</span>
            <span class="flex items-center gap-1.5"><i class="inline-block w-3 h-3 rounded bg-emerald-500/15 border border-emerald-400/40 text-emerald-300"></i> ✓ @SharedLocalizer["StatusAvailable"]</span>
            <span class="flex items-center gap-1.5"><i class="inline-block w-3 h-3 rounded bg-red-500/10 border border-red-400/40 text-red-300"></i> ✕ @SharedLocalizer["StatusUnavailable"]</span>
            <span class="flex items-center gap-1.5"><i class="inline-block w-3 h-3 rounded bg-amber-500/15 border border-amber-400/40 text-amber-300"></i> ? @SharedLocalizer["StatusMaybe"]</span>
            <span class="flex items-center gap-1.5"><i class="inline-block w-3 h-3 rounded bg-violet-500/15 border border-violet-400/40 text-violet-300"></i> 🎪 @SharedLocalizer["StatusEvent"]</span>
        </div>
    </div>
</section>

<!-- Day marking modal -->
<div id="day-modal" class="hidden fixed inset-0 z-50 flex items-start justify-center bg-black/70 backdrop-blur-sm p-4 pt-10">
    <div class="card w-full max-w-md p-6 fade-up max-h-[calc(100vh-5rem)] overflow-y-auto">
        <div class="flex items-center justify-between mb-5">
            <h3 class="font-display text-xl">@SharedLocalizer["MarkDay"] — <span id="modal-date-label" class="text-accent"></span></h3>
            <button type="button" id="modal-close" class="text-white/50 hover:text-white text-2xl leading-none transition">×</button>
        </div>
        <form method="post" action="/AdminAvailability/SetStatus" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="date" id="modal-date" />
            <div class="space-y-2.5 text-sm">
                <label class="flex items-center gap-3 rounded-xl border border-white/10 px-4 py-3 cursor-pointer hover:bg-white/5 transition">
                    <input type="radio" name="status" value="" class="accent-[#d9a441]" />
                    <span class="text-white/60">@SharedLocalizer["NoOverride"]</span>
                </label>
                <p id="no-mark-note" class="hidden text-xs text-white/55 rounded-xl border border-white/10 bg-white/5 px-4 py-2.5"></p>
                <label class="flex items-center gap-3 rounded-xl border border-emerald-400/30 px-4 py-3 cursor-pointer hover:bg-emerald-500/10 transition">
                    <input type="radio" name="status" value="1" class="accent-[#d9a441]" />
                    <span class="text-emerald-300">✓ @SharedLocalizer["StatusAvailable"]</span>
                </label>
                <label class="flex items-center gap-3 rounded-xl border border-red-400/30 px-4 py-3 cursor-pointer hover:bg-red-500/10 transition">
                    <input type="radio" name="status" value="2" class="accent-[#d9a441]" />
                    <span class="text-red-300">✕ @SharedLocalizer["StatusUnavailable"]</span>
                </label>
                <label class="flex items-center gap-3 rounded-xl border border-amber-400/30 px-4 py-3 cursor-pointer hover:bg-amber-500/10 transition">
                    <input type="radio" name="status" value="3" class="accent-[#d9a441]" />
                    <span class="text-amber-300">? @SharedLocalizer["StatusMaybe"]</span>
                </label>
                <label class="flex items-center gap-3 rounded-xl border border-violet-400/30 px-4 py-3 cursor-pointer hover:bg-violet-500/10 transition">
                    <input type="radio" name="status" value="4" class="accent-[#d9a441]" />
                    <span class="text-violet-300">🎪 @SharedLocalizer["StatusEvent"]</span>
                </label>
            </div>
            <div id="event-fields" class="hidden space-y-3 border-t border-white/10 pt-4">
                <div>
                    <label class="block text-sm font-medium mb-2">@SharedLocalizer["EventName"]</label>
                    <input id="event-title" name="title" maxlength="200" placeholder="Ex.: Night Run Lisboa"
                           class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 focus:outline-none focus:border-accent transition" />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-2">@SharedLocalizer["EventLocation"]</label>
                    <div class="grid grid-cols-2 gap-3">
                        <select id="event-zone" name="zone"
                                class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-3 focus:outline-none focus:border-accent transition">
                            <option value="">@SharedLocalizer["ChooseZone"]</option>
                            @foreach (var r in Model.Regions)
                            {
                                <option value="@r">@r</option>
                            }
                        </select>
                        <select id="event-locality" name="location" disabled
                                class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-3 focus:outline-none focus:border-accent transition disabled:opacity-50">
                            <option value="">@SharedLocalizer["ChooseLocality"]</option>
                        </select>
                    </div>
                    <p class="text-white/40 text-xs mt-1.5">@SharedLocalizer["EventLocationHint"]</p>
                </div>
                <div>
                    <label class="block text-sm font-medium mb-2">@SharedLocalizer["MaxMiniSessions"]</label>
                    <select id="max-mini" name="maxMiniSessions"
                            class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 focus:outline-none focus:border-accent transition">
                        @for (int i = 1; i <= 10; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium mb-2">@SharedLocalizer["MiniSessionHours"]</label>
                    <div class="rounded-xl border border-white/10 bg-[color:var(--bg)] p-3"
                         data-hour-bar data-start-input="mini-start" data-end-input="mini-end"></div>
                    <input type="hidden" id="mini-start" name="miniStart" />
                    <input type="hidden" id="mini-end" name="miniEnd" />
                    <p class="text-white/40 text-xs mt-2">@SharedLocalizer["MiniSessionHoursHint"]</p>
                </div>
            </div>
            <div id="zone-fields" class="hidden space-y-3 border-t border-white/10 pt-4">
                <div>
                    <label class="block text-sm font-medium mb-2">@SharedLocalizer["DayZone"]</label>
                    <select id="day-zone" name="zone"
                            class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 focus:outline-none focus:border-accent transition">
                        <option value="">@SharedLocalizer["DayZoneAny"]</option>
                        @foreach (var r in Model.Regions)
                        {
                            <option value="@r">@r</option>
                        }
                    </select>
                    <p class="text-white/40 text-xs mt-1.5">@SharedLocalizer["DayZoneHint"]</p>
                </div>
            </div>
            <div id="day-hours-fields" class="hidden space-y-3 border-t border-white/10 pt-4">
                <div>
                    <label class="block text-sm font-medium mb-2">@SharedLocalizer["DayHours"]</label>
                    <div class="rounded-xl border border-white/10 bg-[color:var(--bg)] p-3"
                         data-hour-bar data-start-input="day-start" data-end-input="day-end"></div>
                    <input type="hidden" id="day-start" name="dayStart" />
                    <input type="hidden" id="day-end" name="dayEnd" />
                    <p class="text-white/40 text-xs mt-2">@SharedLocalizer["DayHoursHint"]</p>
                </div>
            </div>
            <button class="btn-primary w-full">@SharedLocalizer["Save"]</button>
        </form>
    </div>
</div>

@section Scripts {        <script>
        (function () {
            var modal = document.getElementById('day-modal');
            var modalDate = document.getElementById('modal-date');
            var modalDateLabel = document.getElementById('modal-date-label');
            var eventTitle = document.getElementById('event-title');
            var noMarkNote = document.getElementById('no-mark-note');
            var maxMini = document.getElementById('max-mini');
            var miniStart = document.getElementById('mini-start');
            var miniEnd = document.getElementById('mini-end');
            var eventFields = document.getElementById('event-fields');
            var zoneFields = document.getElementById('zone-fields');
            var dayHoursFields = document.getElementById('day-hours-fields');
            var dayStart = document.getElementById('day-start');
            var dayEnd = document.getElementById('day-end');
            var eventZone = document.getElementById('event-zone');
            var eventLocality = document.getElementById('event-locality');
            var dayZone = document.getElementById('day-zone');
            var radios = document.querySelectorAll('input[name="status"]');
            var localities = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.Regions.Select(r => new
                {
                    Region = r,
                    Cities = ShotsByMarques.Web.Services.PortugalCities.All
                        .Where(c => c.Region == r)
                        .Select(c => c.Name)
                        .ToList()
                })));

            function fillLocalities(zoneSelect, locSelect, keep) {
                locSelect.innerHTML = '';
                var ph = document.createElement('option');
                ph.value = '';
                ph.textContent = '@SharedLocalizer["ChooseLocality"]';
                locSelect.appendChild(ph);
                if (!zoneSelect.value) { locSelect.disabled = true; return; }
                var group = localities.find(function (g) { return g.Region === zoneSelect.value; });
                (group ? group.Cities : []).forEach(function (name) {
                    var o = document.createElement('option');
                    o.value = name;
                    o.textContent = name;
                    locSelect.appendChild(o);
                });
                locSelect.disabled = false;
                if (keep && Array.from(locSelect.options).some(function (o) { return o.value === keep; })) {
                    locSelect.value = keep;
                }
            }
            eventZone.addEventListener('change', function () { fillLocalities(eventZone, eventLocality, ''); });

            // ---- Hour range bar: drag on the 24h strip or tap a preset ----
            var HOUR_PRESETS = [
                { range: '09:00-20:00', label: '☀️ @Html.Raw(SharedLocalizer["PresetFullDay"])' },
                { range: '09:00-13:00', label: '🌅 @Html.Raw(SharedLocalizer["PresetMorning"])' },
                { range: '14:00-19:00', label: '🌤 @Html.Raw(SharedLocalizer["PresetAfternoon"])' },
                { range: '20:00-23:00', label: '🌙 @Html.Raw(SharedLocalizer["PresetNight"])' }
            ];

            function initHourBar(el) {
                var startInput = document.getElementById(el.dataset.startInput);
                var endInput = document.getElementById(el.dataset.endInput);
                var HOURS = 24;

                var header = document.createElement('div');
                header.className = 'flex items-center justify-between mb-2 text-xs gap-2';
                var labelWrap = document.createElement('span');
                labelWrap.className = 'text-white/60 flex items-center gap-2 min-w-0';
                var rangeLabel = document.createElement('span');
                rangeLabel.className = 'text-accent font-semibold whitespace-nowrap';
                rangeLabel.setAttribute('data-range-label', '');
                rangeLabel.textContent = '—';
                var dragHint = document.createElement('span');
                dragHint.className = 'text-white/35 hidden sm:inline truncate';
                dragHint.textContent = '@SharedLocalizer["DragHoursHint"]';
                labelWrap.append(rangeLabel, dragHint);
                var clearBtn = document.createElement('button');
                clearBtn.type = 'button';
                clearBtn.setAttribute('data-clear', '');
                clearBtn.className = 'text-white/40 hover:text-white transition whitespace-nowrap';
                clearBtn.textContent = '✕ @SharedLocalizer["ClearHours"]';
                header.append(labelWrap, clearBtn);

                var track = document.createElement('div');
                track.setAttribute('data-track', '');
                track.className = 'flex items-stretch gap-[3px]';
                var cells = [];
                for (var h = 0; h < HOURS; h++) {
                    var cell = document.createElement('div');
                    cell.className = 'hour-cell' + (h >= 20 || h < 6 ? ' night' : '');
                    cell.dataset.hour = h;
                    track.appendChild(cell);
                    cells.push(cell);
                }

                var ticks = document.createElement('div');
                ticks.className = 'flex justify-between text-[10px] text-white/35 mt-1.5 px-0.5';
                [0, 3, 6, 9, 12, 15, 18, 21, 24].forEach(function (t) {
                    var s = document.createElement('span');
                    s.textContent = String(t).padStart(2, '0');
                    ticks.appendChild(s);
                });

                var presets = document.createElement('div');
                presets.className = 'flex flex-wrap gap-2 mt-3';
                var presetBtns = [];
                HOUR_PRESETS.forEach(function (p) {
                    var b = document.createElement('button');
                    b.type = 'button';
                    b.className = 'hour-preset';
                    b.textContent = p.label;
                    b.dataset.range = p.range;
                    presets.appendChild(b);
                    presetBtns.push(b);
                });

                el.append(header, track, ticks, presets);

                var start = null, end = null, drag = null;

                function fmt(h) {
                    var m = Math.round(h * 60);
                    return String(Math.floor(m / 60)).padStart(2, '0') + ':' + String(m % 60).padStart(2, '0');
                }
                function parse(v) {
                    if (!v) return null;
                    var p = v.split(':');
                    return Number(p[0]) + Number(p[1] || 0) / 60;
                }
                function render() {
                    for (var i = 0; i < HOURS; i++) {
                        var c = cells[i];
                        var selected = start !== null && i >= start && i <= end;
                        c.classList.toggle('sel', selected);
                        c.classList.toggle('night-sel', selected && (i >= 20 || i < 6));
                        c.classList.toggle('edge', selected && (i === start || i === end));
                        c.innerHTML = '';
                        if (selected && (i === start || i === end)) {
                            var grip = document.createElement('span');
                            grip.className = 'absolute inset-y-1 left-1/2 -translate-x-1/2 w-[3px] rounded bg-white/90';
                            c.appendChild(grip);
                        }
                    }
                    rangeLabel.textContent = start === null ? '—' : fmt(start) + ' – ' + fmt(end);
                    startInput.value = start === null ? '' : fmt(start);
                    endInput.value = end === null ? '' : fmt(end);
                    presetBtns.forEach(function (b) {
                        var r = b.dataset.range.split('-');
                        b.classList.toggle('on', start !== null && fmt(start) === r[0] && fmt(end) === r[1]);
                    });
                }
                function idxAt(e) {
                    var rect = track.getBoundingClientRect();
                    var w = rect.width / HOURS;
                    return Math.max(0, Math.min(HOURS - 1, Math.floor((e.clientX - rect.left) / w)));
                }
                track.addEventListener('pointerdown', function (e) {
                    e.preventDefault();
                    var i = idxAt(e);
                    if (start === null) { start = i; end = i; drag = 'end'; }
                    else if (i < start) { start = i; drag = 'start'; }
                    else if (i > end) { end = i; drag = 'end'; }
                    else if (i - start < end - i) { start = i; drag = 'start'; }
                    else { end = i; drag = 'end'; }
                    render();
                    try { track.setPointerCapture(e.pointerId); } catch (_) { }
                });
                track.addEventListener('pointermove', function (e) {
                    if (drag === null) return;
                    var i = idxAt(e);
                    if (drag === 'start') {
                        if (i > end) { start = end; end = i; drag = 'end'; } else { start = i; }
                    } else {
                        if (i < start) { end = start; start = i; drag = 'start'; } else { end = i; }
                    }
                    render();
                });
                ['pointerup', 'pointercancel'].forEach(function (ev) {
                    track.addEventListener(ev, function () { drag = null; });
                });
                clearBtn.addEventListener('click', function () { start = null; end = null; render(); });
                presetBtns.forEach(function (b) {
                    b.addEventListener('click', function () {
                        var r = b.dataset.range.split('-');
                        start = parse(r[0]); end = parse(r[1]);
                        render();
                    });
                });
                function readInputs() {
                    start = parse(startInput.value);
                    end = parse(endInput.value);
                    if (start !== null && end !== null && end < start) { var t = start; start = end; end = t; }
                    render();
                }
                readInputs();
                return { readInputs: readInputs };
            }

            var hourBars = [];
            document.querySelectorAll('[data-hour-bar]').forEach(function (el) {
                hourBars.push(initHourBar(el));
            });
            function refreshHourBars() {
                hourBars.forEach(function (b) { b.readInputs(); });
            }

            // ---- Bulk marking: select several days, apply one status + shared hours ----
            var bulkToggle = document.getElementById('bulk-toggle');
            var bulkPanel = document.getElementById('bulk-panel');
            var bulkCount = document.getElementById('bulk-count');
            var bulkApply = document.getElementById('bulk-apply');
            var bulkCancel = document.getElementById('bulk-cancel');
            var bulkStatusBtns = document.querySelectorAll('.bulk-status');
            var bulkHoursWrap = document.getElementById('bulk-hours-wrap');
            var bulkStart = document.getElementById('bulk-start');
            var bulkEnd = document.getElementById('bulk-end');
            var multi = false;
            var selectedDates = new Set();
            var bulkStatus = '1';

            function updateBulk() {
                bulkCount.textContent = selectedDates.size;
                bulkApply.disabled = selectedDates.size === 0;
                bulkApply.textContent = '@SharedLocalizer["BulkApply"]' + (selectedDates.size ? ' (' + selectedDates.size + ')' : '');
            }
            function toggleSelect(btn) {
                var date = btn.dataset.date;
                if (selectedDates.has(date)) {
                    selectedDates.delete(date);
                    btn.classList.remove('cal-sel');
                    var chk = btn.querySelector('.sel-check');
                    if (chk) chk.remove();
                } else {
                    selectedDates.add(date);
                    btn.classList.add('cal-sel');
                    var chk = document.createElement('span');
                    chk.className = 'sel-check absolute -top-1 -right-1 w-4 h-4 rounded-full bg-accent text-black text-[10px] font-bold flex items-center justify-center';
                    chk.textContent = '✓';
                    btn.appendChild(chk);
                }
                updateBulk();
            }
            function setBulkStatus(v) {
                bulkStatus = v;
                bulkStatusBtns.forEach(function (b) { b.classList.toggle('on', b.dataset.bulkStatus === v); });
                var needsHours = v === '1' || v === '3';
                bulkHoursWrap.classList.toggle('hidden', !needsHours);
                if (needsHours && !bulkStart.value && !bulkEnd.value) {
                    bulkStart.value = '09:00';
                    bulkEnd.value = '20:00';
                    refreshHourBars();
                }
            }
            function exitBulk() {
                multi = false;
                bulkToggle.classList.remove('!border-accent', '!text-accent');
                bulkPanel.classList.add('hidden');
                selectedDates.forEach(function (d) {
                    var btn = Array.from(document.querySelectorAll('[data-calendar-day]'))
                        .find(function (b) { return b.dataset.date === d; });
                    if (btn) {
                        btn.classList.remove('cal-sel');
                        var chk = btn.querySelector('.sel-check');
                        if (chk) chk.remove();
                    }
                });
                selectedDates.clear();
                updateBulk();
            }
            bulkToggle.addEventListener('click', function () {
                multi = !multi;
                if (multi) {
                    bulkToggle.classList.add('!border-accent', '!text-accent');
                    bulkPanel.classList.remove('hidden');
                    setBulkStatus(bulkStatus);
                    refreshHourBars();
                } else {
                    exitBulk();
                }
            });
            bulkCancel.addEventListener('click', exitBulk);
            bulkStatusBtns.forEach(function (b) {
                b.addEventListener('click', function () { setBulkStatus(b.dataset.bulkStatus); });
            });
            bulkApply.addEventListener('click', function () {
                if (selectedDates.size === 0) return;
                var form = document.createElement('form');
                form.method = 'post';
                form.action = '/AdminAvailability/BulkSet';
                function add(name, value) {
                    var i = document.createElement('input');
                    i.type = 'hidden';
                    i.name = name;
                    i.value = value;
                    form.appendChild(i);
                }
                var token = document.querySelector('input[name="__RequestVerificationToken"]');
                if (token) add('__RequestVerificationToken', token.value);
                selectedDates.forEach(function (d) { add('dates', d); });
                add('status', bulkStatus);
                add('dayStart', document.getElementById('bulk-start').value);
                add('dayEnd', document.getElementById('bulk-end').value);
                add('year', @Model.Year);
                add('month', @Model.Month);
                document.body.appendChild(form);
                form.submit();
            });

            function toggleEventFields() {
                var checked = document.querySelector('input[name="status"]:checked');
                var isEvent = checked && checked.value === '4';
                var isAvail = checked && (checked.value === '1' || checked.value === '3');
                var isNoMark = checked && checked.value === '';
                eventFields.classList.toggle('hidden', !isEvent);
                zoneFields.classList.toggle('hidden', !isAvail);
                dayHoursFields.classList.toggle('hidden', !isAvail);
                noMarkNote.classList.toggle('hidden', !isNoMark);
                if (isNoMark) {
                    noMarkNote.textContent = '💡 @Html.Raw(SharedLocalizer["NoMarkFollows"])';
                }
                // Only one of the two zone selects may be submitted (same name="zone").
                eventZone.disabled = !isEvent;
                eventLocality.disabled = !isEvent;
                dayZone.disabled = !isAvail;
                // Marking a day Available/Talvez opens it with the standard hours
                // (adjustable in the bar); empty would mean a closed day.
                if (isAvail && !dayStart.value && !dayEnd.value) {
                    dayStart.value = '09:00';
                    dayEnd.value = '20:00';
                    refreshHourBars();
                }
            }
            radios.forEach(function (r) { r.addEventListener('change', toggleEventFields); });

            document.querySelectorAll('[data-calendar-day]').forEach(function (btn) {
                // Only days of the current month that are not in the past can be marked.
                if (btn.dataset.inMonth === 'false' || btn.dataset.past === 'true') return;
                btn.addEventListener('click', function () {
                    if (multi) { toggleSelect(btn); return; }
                    modalDate.value = btn.dataset.date;
                    modalDateLabel.textContent = btn.dataset.date;
                    var status = btn.dataset.status; // "0" = no marking
                    radios.forEach(function (r) {
                        r.checked = (r.value === status) || (status === '0' && r.value === '');
                    });
                    eventTitle.value = btn.dataset.title || '';
                    maxMini.value = btn.dataset.max || '4';
                    // Default the mini-session hours to the standard 09:00–20:00;
                    // keep saved values when the event already has a window.
                    miniStart.value = btn.dataset.miniStart || (btn.dataset.status === '4' ? '09:00' : '');
                    miniEnd.value = btn.dataset.miniEnd || (btn.dataset.status === '4' ? '20:00' : '');
                    eventZone.value = btn.dataset.zone || '';
                    fillLocalities(eventZone, eventLocality, btn.dataset.location || '');
                    dayZone.value = btn.dataset.zone || '';
                    dayStart.value = btn.dataset.dayStart || '';
                    dayEnd.value = btn.dataset.dayEnd || '';
                    toggleEventFields();
                    refreshHourBars();
                    modal.classList.remove('hidden');
                });
            });

            document.getElementById('modal-close').addEventListener('click', function () {
                modal.classList.add('hidden');
            });
            modal.addEventListener('click', function (e) {
                if (e.target === modal) modal.classList.add('hidden');
            });
        })();
    </script>
}
