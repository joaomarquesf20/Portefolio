@model List<ShotsByMarques.Web.Models.Order>
@{
    ViewData["Title"] = SharedLocalizer["Orders"];
}

<section class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <h1 class="font-display text-4xl mb-8 fade-up">@SharedLocalizer["Orders"]</h1>

    <div class="space-y-4">
        @foreach (var order in Model)
        {
            <div class="card p-6 fade-up">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div>
                        <p class="font-semibold">@order.OrderNumber</p>
                        <p class="text-white/40 text-sm mt-1">@order.ClientUser?.FullName · @order.ClientUser?.Email</p>
                        <p class="text-white/40 text-xs mt-0.5">@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                    <div class="text-right">
                        @if (order.DiscountAmount > 0)
                        {
                            <p class="text-white/40 text-xs">@order.Subtotal.ToString("C", new System.Globalization.CultureInfo("pt-PT"))
                                <span class="text-emerald-300">− @order.PackName</span></p>
                        }
                        <p class="text-accent font-semibold">@order.Total.ToString("C", new System.Globalization.CultureInfo("pt-PT"))</p>
                        <span class="inline-block mt-1 text-xs font-semibold px-3 py-1 rounded-full @(order.Status == ShotsByMarques.Web.Models.OrderStatus.Paid ? "bg-emerald-500/15 text-emerald-300" : "bg-yellow-500/15 text-yellow-300")">@order.Status</span>
                    </div>
                </div>
                @if (order.Items.Count > 0)
                {
                    <div class="flex flex-wrap gap-2 mt-4 pt-4 border-t border-[color:var(--border)]">
                        @foreach (var item in order.Items.Take(8))
                        {
                            <img src="/Photos/Preview/@item.PhotoId" alt="@item.Title" title="@item.Title — @item.Price.ToString("C", new System.Globalization.CultureInfo("pt-PT"))"
                                 class="w-14 h-10 object-cover rounded-md" loading="lazy" />
                        }
                        @if (order.Items.Count > 8)
                        {
                            <span class="text-white/40 text-sm self-center">+@(order.Items.Count - 8)</span>
                        }
                    </div>
                }
            </div>
        }
    </div>

    @if (Model.Count == 0)
    {
        <p class="text-white/40 text-center py-16">Sem encomendas.</p>
    }
</section>
