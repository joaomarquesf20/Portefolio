@model ShotsByMarques.Web.Models.Gallery
@{
    ViewData["Title"] = SharedLocalizer["Edit"];
}

<section class="max-w-2xl mx-auto px-4 sm:px-6 py-12">
    <a href="/AdminGalleries" class="text-white/50 hover:text-accent text-sm transition">← @SharedLocalizer["Back"]</a>
    <h1 class="font-display text-4xl mt-3 mb-8 fade-up">@SharedLocalizer["Edit"] — @Model.Title</h1>

    <form asp-action="Edit" method="post" class="card p-8 space-y-5 fade-up">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CoverPath" />
        <input type="hidden" asp-for="CreatedAt" />
        <div asp-validation-summary="ModelOnly" class="text-red-400 text-sm"></div>

        <div>
            <label class="block text-sm font-medium mb-2">@SharedLocalizer["GalleryType"]</label>
            <div class="grid grid-cols-2 gap-3">
                <label class="card p-4 cursor-pointer transition hover:border-accent @(!Model.IsSession ? "ring-2 ring-[color:var(--accent)]" : "") has-[:checked]:ring-2 has-[:checked]:ring-[color:var(--accent)]">
                    <input type="radio" name="IsSession" value="false" @(!Model.IsSession ? "checked" : "") class="sr-only" />
                    <p class="font-semibold">📷 @SharedLocalizer["GalleryTypeEvent"]</p>
                    <p class="text-white/50 text-xs mt-1">@SharedLocalizer["GalleryTypeEventHint"]</p>
                </label>
                <label class="card p-4 cursor-pointer transition hover:border-accent @(Model.IsSession ? "ring-2 ring-[color:var(--accent)]" : "") has-[:checked]:ring-2 has-[:checked]:ring-[color:var(--accent)]">
                    <input type="radio" name="IsSession" value="true" @(Model.IsSession ? "checked" : "") class="sr-only" />
                    <p class="font-semibold">🚗 @SharedLocalizer["GalleryTypeSession"]</p>
                    <p class="text-white/50 text-xs mt-1">@SharedLocalizer["GalleryTypeSessionHint"]</p>
                </label>
            </div>
        </div>

        <div>
            <label asp-for="Title" class="block text-sm font-medium mb-2"></label>
            <input asp-for="Title" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 focus:outline-none focus:border-accent transition" />
            <span asp-validation-for="Title" class="text-red-400 text-xs"></span>
        </div>

        <div>
            <label asp-for="Subtitle" class="block text-sm font-medium mb-2"></label>
            <input asp-for="Subtitle" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 focus:outline-none focus:border-accent transition" />
        </div>

        <div>
            <label asp-for="Description" class="block text-sm font-medium mb-2"></label>
            <textarea asp-for="Description" rows="3" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 focus:outline-none focus:border-accent transition"></textarea>
        </div>

        <div>
            <label asp-for="EventDate" class="block text-sm font-medium mb-2"></label>
            <input asp-for="EventDate" type="date" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 focus:outline-none focus:border-accent transition" />
        </div>

        <div class="flex items-center gap-3">
            <input asp-for="IsPublished" class="accent-[color:var(--accent)]" />
            <label asp-for="IsPublished" class="text-sm"></label>
        </div>

        <div class="rounded-xl border border-[color:var(--border)] p-5 space-y-4">
            <label class="flex items-center gap-3">
                <input asp-for="IsPrivate" class="accent-[color:var(--accent)]" />
                <span class="text-sm">🔒 Galeria privada — fotos da sessão entregues a um cliente específico</span>
            </label>
            <div>
                <label asp-for="BookingId" class="block text-sm font-medium mb-2">Marcação associada (cliente)</label>
                <select asp-for="BookingId" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 focus:outline-none focus:border-accent transition">
                    <option value="">— Nenhuma (galeria pública de portefólio) —</option>
                    @foreach (var b in ViewData["Bookings"] as List<ShotsByMarques.Web.Models.Booking> ?? new())
                    {
                        <option value="@b.Id">@b.SessionType?.Name — @b.ClientUser?.FullName — @b.Start.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</option>
                    }
                </select>
            </div>
            <p class="text-xs text-white/40">Ao escolheres uma marcação, a galeria passa a ser privada: só esse cliente vê e compra as fotos.</p>
        </div>

        <button type="submit" class="btn-primary">@SharedLocalizer["Save"]</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
