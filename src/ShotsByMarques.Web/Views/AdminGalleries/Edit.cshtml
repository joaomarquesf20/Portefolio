@model ShotsByMarques.Web.Models.Gallery
@{
    ViewData["Title"] = SharedLocalizer["Edit"];
}

<section class="px-6 py-12 sm:px-10">
    <div class="w-full max-w-[46rem]">
        <a href="/AdminGalleries" class="inline-flex items-center gap-2 text-sm text-black/50 transition hover:text-[#a1843f]">← @SharedLocalizer["Back"]</a>

        <div class="rv mt-4 mb-10">
            <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-[#a1843f]">Detalhe da galeria</p>
            <h1 class="mt-2 font-display text-4xl font-bold tracking-[-0.03em] text-[#141414]">@SharedLocalizer["Edit"] — @Model.Title</h1>
        </div>

        <form asp-action="Edit" method="post" class="rv rv-d1 card space-y-8 p-8">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CoverPath" />
            <input type="hidden" asp-for="CreatedAt" />
            @* Campos descontinuados no formulário: preservados invisíveis para
               o model binder não nular valores existentes ao guardar. *@
            <input type="hidden" asp-for="Subtitle" />
            <input type="hidden" asp-for="Description" />
            <input type="hidden" asp-for="EventDate" />
            <div asp-validation-summary="ModelOnly" class="text-red-700 text-sm"></div>

            <!-- ======== 1. Título ======== -->
            <div>
                <label for="Title" class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.14em] text-black/50">Título da galeria</label>
                <input asp-for="Title" class="w-full rounded-md border border-black/15 bg-white px-4 py-3 text-sm text-[#141414] outline-none transition placeholder:text-black/25 focus:border-[#a1843f] focus:shadow-[0_0_0_3px_rgba(161,132,63,0.12)]" />
                <span asp-validation-for="Title" class="text-red-700 text-xs"></span>
            </div>

            <!-- ======== 2. Tipo ======== -->
            <div>
                <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-black/50">@SharedLocalizer["GalleryType"]</p>
                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                    <label class="cursor-pointer rounded-lg border border-black/10 bg-white p-4 transition has-[:checked]:border-[#a1843f]/50 has-[:checked]:bg-[#a1843f]/[0.04] hover:border-black/30">
                        <input type="radio" name="IsSession" value="false" @(!Model.IsSession ? "checked" : "") class="sr-only" />
                        <p class="font-semibold text-sm text-[#141414]">@SharedLocalizer["GalleryTypeEvent"]</p>
                        <p class="text-black/45 text-xs mt-1">@SharedLocalizer["GalleryTypeEventHint"]</p>
                    </label>
                    <label class="cursor-pointer rounded-lg border border-black/10 bg-white p-4 transition has-[:checked]:border-[#a1843f]/50 has-[:checked]:bg-[#a1843f]/[0.04] hover:border-black/30">
                        <input type="radio" name="IsSession" value="true" @(Model.IsSession ? "checked" : "") class="sr-only" />
                        <p class="font-semibold text-sm text-[#141414]">@SharedLocalizer["GalleryTypeSession"]</p>
                        <p class="text-black/45 text-xs mt-1">@SharedLocalizer["GalleryTypeSessionHint"]</p>
                    </label>
                </div>
            </div>

            <!-- ======== 3. Publicação ======== -->
            <div class="border border-black/10 bg-black/[0.015] p-5">
                <label class="flex cursor-pointer items-center gap-4">
                    <input asp-for="IsPublished" class="peer sr-only" />
                    <span class="relative h-6 w-11 shrink-0 rounded-full border border-black/15 bg-black/[0.06] transition-all after:absolute after:left-[2px] after:top-1/2 after:h-5 after:w-5 after:-translate-y-1/2 after:rounded-full after:bg-black/40 after:transition-all peer-checked:border-[#a1843f]/45 peer-checked:bg-[#a1843f]/20 peer-checked:after:left-[calc(100%-1.375rem)] peer-checked:after:bg-[#a1843f]"></span>
                    <span>
                        <span class="block text-sm font-semibold text-[#141414]">Publicar galeria <span class="font-normal text-black/45">(visível no site)</span></span>
                        <span class="block text-black/40 text-xs mt-0.5">A galeria aparece no portefólio e nas coleções públicas do site.</span>
                    </span>
                </label>
            </div>

            <!-- ======== 4. Associação a cliente (opcional) ======== -->
            <div class="rounded-lg border border-dashed border-black/20 p-5">
                <div class="flex items-center justify-between gap-4">
                    <p class="text-sm font-semibold text-[#141414]">Associação a Cliente <span class="font-normal text-black/40">(Opcional)</span></p>
                    <span id="assoc-status" class="hidden shrink-0 rounded-full border border-[#a1843f]/35 bg-[#a1843f]/10 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-[#8a7034]">Privada · cliente ligado</span>
                </div>
                <div class="mt-3">
                    <label asp-for="BookingId" class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.14em] text-black/50">Marcação associada</label>
                    <select asp-for="BookingId" id="assoc-select" class="w-full rounded-md border border-black/15 bg-white px-4 py-3 text-sm text-[#141414] outline-none transition focus:border-[#a1843f] focus:shadow-[0_0_0_3px_rgba(161,132,63,0.12)]">
                        <option value="">— Nenhuma (galeria pública de portefólio) —</option>
                        @foreach (var b in ViewData["Bookings"] as List<ShotsByMarques.Web.Models.Booking> ?? new())
                        {
                            <option value="@b.Id">@b.SessionType?.Name — @b.ClientUser?.FullName — @b.Start.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</option>
                        }
                    </select>
                </div>
                <p class="text-black/40 text-xs mt-2.5">Se escolheres uma marcação, a galeria fica automaticamente <span class="font-semibold text-[#8a7034]">privada</span> e as fotos deixam de ser vendidas à parte. Sem marcação, a galeria é pública de portefólio.</p>
            </div>

            <div class="border-t border-black/10 pt-6">
                <button type="submit" class="btn-primary">@SharedLocalizer["Save"]</button>
            </div>
        </form>

        <!-- ======== Capa a partir das fotos ======== -->
        @if (Model.Photos.Count > 0)
        {
            <div class="rv mt-6 card p-8">
                <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
                    <h2 class="font-display font-semibold text-lg text-[#141414]">Capa a partir das fotos <span class="text-black/35 font-normal">(@Model.Photos.Count)</span></h2>
                    <p class="text-sm text-black/45">Clica numa foto para a tornar capa da galeria.</p>
                </div>
                <div class="grid grid-cols-3 sm:grid-cols-5 md:grid-cols-6 gap-3">
                    @foreach (var photo in Model.Photos)
                    {
                        <div class="relative">
                            <form asp-action="SetCover" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@photo.Id" />
                                <input type="hidden" name="from" value="edit" />
                                <button type="submit" class="block w-full rounded-lg overflow-hidden border-2 transition @(Model.CoverPath == photo.PreviewPath ? "border-[#a1843f]" : "border-transparent hover:border-black/30")">
                                    <img src="@photo.PreviewUrl()" alt="@photo.Title" class="aspect-[3/2] w-full object-cover" />
                                </button>
                            </form>
                            @if (Model.CoverPath == photo.PreviewPath)
                            {
                                <span class="absolute top-1.5 right-1.5 rounded-full border border-[#a1843f]/40 bg-[#a1843f]/15 px-2 py-0.5 text-[10px] font-bold text-[#8a7034]">★ Capa</span>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        @if (Model.Photos.Count == 0)
        {
            <p class="mt-4 text-sm text-black/45">Sem fotos para escolher como capa — carrega-as no passo seguinte: Galerias → Fotos.</p>
        }
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var sel = document.getElementById("assoc-select");
            var chip = document.getElementById("assoc-status");
            if (!sel || !chip) return;
            var update = function () {
                if (sel.value) {
                    chip.classList.remove("hidden");
                } else {
                    chip.classList.add("hidden");
                }
            };
            sel.addEventListener("change", update);
            update();
        })();
    </script>
}
