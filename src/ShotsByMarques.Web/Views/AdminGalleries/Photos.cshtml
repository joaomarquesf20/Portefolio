@model ShotsByMarques.Web.Models.Gallery
@{
    ViewData["Title"] = Model.Title;
    var samplePhotos = Model.Photos.Where(p => p.FilePath.StartsWith("/sample-photos/")).Count();
    var isEvent = !Model.IsSession && !Model.BookingId.HasValue;
    var notForSale = Model.Photos.Count(p => !p.IsForSale);
}

<section class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <a href="/AdminGalleries" class="text-white/50 hover:text-accent text-sm transition">← @SharedLocalizer["Back"]</a>
    <h1 class="font-display text-4xl mt-3 mb-8 fade-up">@Model.Title — @SharedLocalizer["Photos"]</h1>

    @if (Model.IsPrivate && Model.Booking?.ClientUser != null)
    {
        <div class="rounded-xl border border-accent/40 bg-[color:var(--accent-soft)] px-5 py-4 text-sm mb-8 fade-up">
            🔒 Galeria privada da sessão — visível apenas por <b>@Model.Booking.ClientUser.FullName</b> (@Model.Booking.ClientUser.Email).
            A sessão já foi paga, por isso as fotos aqui carregadas ficam <b>incluídas (sem custo)</b> — o cliente descarrega-as sem marca de água em "Downloads".
        </div>
    }

    @if (samplePhotos > 0)
    {
        <div class="card p-5 mb-6 flex flex-wrap items-center gap-4 fade-up">
            <p class="flex-1 min-w-[200px] text-sm text-white/70">
                Esta galeria ainda tem <b>@samplePhotos foto(s) de exemplo</b> (SVGs de demonstração).
                Aparecem aos clientes até carregares as tuas fotos reais — os uploads novos removem-nas automaticamente.
            </p>
            <form asp-action="RemoveSamples" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button class="btn-outline !py-2 !px-4 !text-sm">🗑️ Remover fotos de exemplo</button>
            </form>
        </div>
    }

    @* ----- Gallery settings (type, title, description, cover) — merged into this page *@
    <div class="card p-6 mb-10 fade-up">
        <h2 class="font-semibold mb-4">@SharedLocalizer["GalleryType"]</h2>
        <form asp-action="Edit" method="post" enctype="multipart/form-data" class="space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CoverPath" />
            <input type="hidden" asp-for="CreatedAt" />

            <div class="grid grid-cols-2 gap-3">
                <label class="card p-4 cursor-pointer transition hover:border-accent has-[:checked]:ring-2 has-[:checked]:ring-[color:var(--accent)]">
                    <input type="radio" name="IsSession" value="false" @(!Model.IsSession ? "checked" : "") class="sr-only" />
                    <p class="font-semibold">📷 @SharedLocalizer["GalleryTypeEvent"]</p>
                    <p class="text-white/50 text-xs mt-1">@SharedLocalizer["GalleryTypeEventHint"]</p>
                </label>
                <label class="card p-4 cursor-pointer transition hover:border-accent has-[:checked]:ring-2 has-[:checked]:ring-[color:var(--accent)]">
                    <input type="radio" name="IsSession" value="true" @(Model.IsSession ? "checked" : "") class="sr-only" />
                    <p class="font-semibold">🚗 @SharedLocalizer["GalleryTypeSession"]</p>
                    <p class="text-white/50 text-xs mt-1">@SharedLocalizer["GalleryTypeSessionHint"]</p>
                </label>
            </div>

            <div class="grid sm:grid-cols-2 gap-5">
                <div>
                    <label asp-for="Title" class="block text-sm font-medium mb-2"></label>
                    <input asp-for="Title" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 focus:outline-none focus:border-accent transition" />
                    <span asp-validation-for="Title" class="text-red-400 text-xs"></span>
                </div>
                <div>
                    <label asp-for="Subtitle" class="block text-sm font-medium mb-2"></label>
                    <input asp-for="Subtitle" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 focus:outline-none focus:border-accent transition" />
                </div>
            </div>

            <div>
                <label asp-for="Description" class="block text-sm font-medium mb-2"></label>
                <textarea asp-for="Description" rows="2" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 focus:outline-none focus:border-accent transition"></textarea>
            </div>

            <div class="flex flex-wrap items-center gap-6">
                <div>
                    <label asp-for="EventDate" class="block text-sm font-medium mb-2"></label>
                    <input asp-for="EventDate" type="date" class="rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 focus:outline-none focus:border-accent transition" />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-2">Capa (ficheiro — opcional)</label>
                    <input type="file" name="cover" accept="image/*" class="text-sm text-white/60" />
                    <p class="text-white/40 text-xs mt-1">Dica: carrega as fotos e depois usa “★ Definir capa” em qualquer foto — nem precisas de ficheiro extra.</p>
                </div>
                <div class="pt-6">
                    <label class="flex items-center gap-3 text-sm cursor-pointer">
                        <input asp-for="IsPublished" class="accent-[color:var(--accent)]" />
                        <span>@SharedLocalizer["Publish"]</span>
                    </label>
                </div>
            </div>

            <div class="rounded-xl border border-[color:var(--border)] p-5 space-y-4">
                <label class="flex items-center gap-3">
                    <input asp-for="IsPrivate" class="accent-[color:var(--accent)]" />
                    <span class="text-sm">🔒 Galeria privada — fotos da sessão entregues a um cliente específico</span>
                </label>
                <div>
                    <label asp-for="BookingId" class="block text-sm font-medium mb-2">Marcação associada (cliente)</label>
                    <select asp-for="BookingId" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 focus:outline-none focus:border-accent transition">
                        <option value="">— Nenhuma (galeria pública de portefólio) —</option>
                        @foreach (var b in ViewData["Bookings"] as List<ShotsByMarques.Web.Models.Booking> ?? new())
                        {
                            <option value="@b.Id">@b.SessionType?.Name — @b.ClientUser?.FullName — @b.Start.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</option>
                        }
                    </select>
                </div>
            </div>

            <button type="submit" class="btn-primary">@SharedLocalizer["Save"]</button>
        </form>
    </div>

    @* ----- Upload + price ----- *@
    <div class="card p-6 mb-10 fade-up">
        <h2 class="font-semibold mb-4">@SharedLocalizer["UploadPhotos"]</h2>
        <form asp-action="UploadPhotos" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="flex flex-wrap items-end gap-4">
                <div class="flex-1 min-w-[220px]">
                    <label class="block text-sm font-medium mb-2">Ficheiros ou pasta inteira</label>
                    <div class="flex flex-wrap items-center gap-3">
                        <label class="btn-outline !py-2 !px-4 !text-sm cursor-pointer">
                            🖼️ Escolher fotos
                            <input type="file" name="files" id="upload-files" accept="image/jpeg,image/png,image/webp" multiple class="hidden" />
                        </label>
                        <label class="btn-outline !py-2 !px-4 !text-sm cursor-pointer">
                            📁 Escolher pasta
                            <input type="file" name="files" id="upload-folder" accept="image/jpeg,image/png,image/webp" multiple webkitdirectory directory class="hidden" />
                        </label>
                        <span id="upload-count" class="text-sm text-white/50"></span>
                    </div>
                </div>
                @if (isEvent)
                {
                    <div data-price-section>
                        <label class="block text-sm font-medium mb-2">@SharedLocalizer["Price"] (€)</label>
                        <input type="number" name="price" step="0.01" min="0" value="10"
                               class="w-28 rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-2.5 focus:outline-none focus:border-accent transition" />
                    </div>
                    <div data-price-section class="pb-2.5">
                        <label class="block text-sm font-medium mb-2">Venda</label>
                        <label class="flex items-center gap-2 text-sm text-white/70 cursor-pointer select-none">
                            <input type="checkbox" name="forSale" value="true" checked
                                   class="w-4 h-4 rounded accent-[color:var(--accent)]" />
                            <input type="hidden" name="forSale" value="false" />
                            Fotos à venda (com preço)
                        </label>
                        <p class="text-white/40 text-xs mt-1">Desmarca para sessões — fotos incluídas no preço.</p>
                    </div>
                    <p data-session-note class="hidden text-sm text-emerald-300 bg-emerald-500/10 border border-emerald-500/30 rounded-xl px-4 py-2.5 w-full sm:w-auto">
                        Galeria de sessão — as fotos ficam <b>incluídas no preço da sessão</b> (sem custo para o cliente).
                    </p>
                }
                else
                {
                    <p data-session-note class="text-sm text-emerald-300 bg-emerald-500/10 border border-emerald-500/30 rounded-xl px-4 py-2.5 w-full sm:w-auto">
                        Galeria de sessão — as fotos ficam <b>incluídas no preço da sessão</b> (sem custo para o cliente).
                    </p>
                }
                <button class="btn-primary">@SharedLocalizer["UploadPhotos"]</button>
            </div>
        </form>
        <p class="text-white/40 text-xs mt-3">✅ Cada upload gera automaticamente a prévia com marca de água (© Shots By Marques) — o cliente só recebe o ficheiro original depois de pagar.</p>

        @if (isEvent && Model.Photos.Count > 0)
        {
            <div data-price-section class="border-t border-[color:var(--border)] mt-5 pt-5">
                <div class="flex flex-wrap items-center justify-between gap-4">
                    <div>
                        <p class="text-sm font-medium">Fotos já carregadas (@Model.Photos.Count)</p>
                        @if (notForSale > 0)
                        {
                            <p class="text-white/50 text-xs mt-1">@notForSale foto(s) ainda sem preço — aplica o preço acima a todas de uma vez:</p>
                        }
                        else
                        {
                            <p class="text-white/50 text-xs mt-1">Todas já têm preço — podes atualizar o preço de todas de uma vez:</p>
                        }
                    </div>
                    <form asp-action="ApplyPriceToAll" method="post" id="apply-all-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="price" id="apply-all-price" value="10" />
                        @if (isEvent)
                        {
                            <input type="hidden" name="forSale" id="apply-all-forsale" value="true" />
                        }
                        <button type="submit" class="btn-primary">
                            @(notForSale > 0 ? "Aplicar este preço a todas" : "Atualizar preço de todas")
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>

    @* ----- Photos grid with per-photo selection ----- *@
    @if (Model.Photos.Count > 0)
    {
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6 fade-up">
            <h2 class="font-display text-2xl">@SharedLocalizer["Photos"] (@Model.Photos.Count)</h2>
        </div>

        @if (isEvent)
        {
            <div id="photo-bulk-bar" data-price-section class="hidden card p-4 mb-6 flex flex-wrap items-center gap-4 text-sm fade-up">
                <label class="flex items-center gap-2 text-white/70 cursor-pointer">
                    <input type="checkbox" id="photo-select-all" class="accent-[color:var(--accent)] w-4 h-4" />
                    <span id="photo-select-all-label">@SharedLocalizer["SelectAll"]</span>
                </label>
                <span class="text-white/40" id="photo-selected-count">0</span>
                <div class="flex-1"></div>
                <form asp-action="ApplyPriceToSelected" method="post" class="inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ids" id="photo-bulk-ids" value="" />
                    <input type="number" name="price" id="photo-bulk-price" step="0.01" min="0" value="10"
                           class="w-24 rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 focus:outline-none focus:border-accent transition" />
                    €
                    <input type="hidden" name="forSale" id="photo-bulk-forsale" value="true" />
                    <button type="submit" id="photo-bulk-apply" class="btn-outline !px-4 !py-2" disabled
                            onclick="return photoBulkSubmit('true')">Aplicar preço às selecionadas</button>
                    <button type="submit" id="photo-bulk-free" class="btn-outline !px-4 !py-2" disabled
                            onclick="return photoBulkSubmit('false')">Marcar sem preço</button>
                </form>
            </div>
        }

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
            @foreach (var photo in Model.Photos)
            {
                <div class="card overflow-hidden fade-up photo-item" data-photo-id="@photo.Id">
                    <div class="relative">
                        @if (isEvent)
                        {
                            <input type="checkbox" data-price-section class="photo-check accent-[color:var(--accent)] w-4 h-4 absolute top-2 left-2 z-10" value="@photo.Id"
                                   aria-label="@photo.Title" />
                        }
                        <img src="@photo.PreviewUrl()" alt="@photo.Title" class="aspect-[3/2] w-full object-cover" />
                        @if (Model.CoverPath == photo.PreviewPath)
                        {
                            <span class="absolute top-2 right-2 z-10 text-[11px] font-semibold bg-accent text-black rounded-full px-2.5 py-0.5">★ Capa</span>
                        }
                    </div>
                    <div class="p-4">
                        <p class="text-sm font-medium truncate">@photo.Title</p>
                        <div data-price-section>
                            @if (photo.IsForSale)
                            {
                                <p class="text-accent text-sm font-semibold mt-1">@photo.Price.ToString("C", new System.Globalization.CultureInfo("pt-PT"))</p>
                                <span class="inline-block mt-1 text-[11px] font-semibold text-emerald-300 bg-emerald-500/15 rounded-full px-2 py-0.5">@SharedLocalizer["ForSale"]</span>
                            }
                            else
                            {
                                <p class="text-white/50 text-xs mt-1">@SharedLocalizer["IncludedInSession"]</p>
                            }
                        </div>
                        <div class="flex items-center gap-3 mt-3">
                            @if (isEvent)
                            {
                                <form asp-action="ToggleSale" method="post" data-price-section>
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@photo.Id" />
                                    <button class="text-xs text-white/60 hover:text-accent transition">@(photo.IsForSale ? "Incluir na sessão" : "Marcar à venda")</button>
                                </form>
                            }
                            <form asp-action="SetCover" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@photo.Id" />
                                <input type="hidden" name="from" value="photos" />
                                <button class="text-xs @(Model.CoverPath == photo.PreviewPath ? "text-accent" : "text-white/60 hover:text-accent") transition">
                                    @(Model.CoverPath == photo.PreviewPath ? "★ É a capa" : "★ Definir capa")
                                </button>
                            </form>
                            <form asp-action="DeletePhoto" method="post" onsubmit="return confirm('@SharedLocalizer["ConfirmDelete"]')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@photo.Id" />
                                <button class="text-xs text-red-400 hover:text-red-300 transition">@SharedLocalizer["Delete"]</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (Model.Photos.Count == 0)
    {
        <p class="text-white/40 text-center py-10">Esta galeria ainda não tem fotos.</p>
    }
</section>

<style>
    /* Hides the price/sale parts of the page while the gallery is private —
       overrides the bulk bar's own `hidden` toggle without conflicts. */
    .price-hidden { display: none !important; }
</style>
<script>
    (function () {
        // Live privacy state: a private/session gallery never sells photos, so
        // the price UI disappears the moment it becomes private — no save needed.
        var privateBox = document.getElementById('IsPrivate');
        var bookingSelect = document.getElementById('BookingId');
        var sessionRadio = document.querySelector('input[name="IsSession"][value="true"]');
        var eventRadio = document.querySelector('input[name="IsSession"][value="false"]');
        var priceSections = Array.from(document.querySelectorAll('[data-price-section]'));
        var sessionNotes = Array.from(document.querySelectorAll('[data-session-note]'));

        function isPrivateLike() {
            return (privateBox && privateBox.checked) ||
                   (bookingSelect && bookingSelect.value !== '') ||
                   (sessionRadio && sessionRadio.checked);
        }

        function update() {
            var hide = isPrivateLike();
            priceSections.forEach(function (el) { el.classList.toggle('price-hidden', hide); });
            sessionNotes.forEach(function (el) { el.classList.toggle('hidden', !hide); });
        }

        if (privateBox) {
            privateBox.addEventListener('change', function () {
                // A private gallery needs a client — unchecking private while a
                // booking is selected clears it, otherwise the server would
                // reject the save (and force private back on).
                if (!privateBox.checked && bookingSelect && bookingSelect.value !== '') {
                    bookingSelect.value = '';
                }
                update();
            });
        }
        if (bookingSelect) {
            bookingSelect.addEventListener('change', function () {
                if (!privateBox) { update(); return; }
                if (bookingSelect.value !== '') {
                    // Choosing a booking makes the gallery private automatically.
                    privateBox.checked = true;
                } else {
                    // "— Nenhuma —" (public portfolio gallery): private off too.
                    privateBox.checked = false;
                }
                update();
            });
        }
        if (sessionRadio) sessionRadio.addEventListener('change', update);
        if (eventRadio) eventRadio.addEventListener('change', update);

        update();
    })();
</script>

<script>
    (function () {
        // ----- Folder / multi-file upload UX -----
        // Two pickers feed the same `files` form field: plain photos or an
        // entire folder (webkitdirectory). Non-image files (DS_Store, Thumbs.db…)
        // are filtered out client-side; the two pickers are mutually exclusive.
        // Picking a folder also pre-fills the gallery Title with the folder's
        // name — the field stays fully editable for manual tweaks.
        var filesIn = document.getElementById('upload-files');
        var folderIn = document.getElementById('upload-folder');
        var countEl = document.getElementById('upload-count');
        var titleIn = document.getElementById('Title');
        if (!filesIn && !folderIn) return;

        var IMAGE_EXT = /\.(jpe?g|png|webp|avif)$/i;

        function pickFolder(input) {
            if (!input.files || input.files.length === 0) return null;
            var dt = new DataTransfer();
            var folder = null;
            Array.from(input.files).forEach(function (f) {
                if (IMAGE_EXT.test(f.name)) {
                    dt.items.add(f);
                    if (!folder && f.webkitRelativePath) folder = f.webkitRelativePath.split('/')[0];
                }
            });
            input.files = dt.files;
            return folder;
        }

        function update(input) {
            var folder = pickFolder(input);
            var other = input === filesIn ? folderIn : filesIn;
            if (other && input.files.length > 0 && other.files.length > 0) other.value = '';
            // Folder pick -> gallery name: the root folder of webkitRelativePath
            // becomes the Title so the admin doesn't retype it. Only the folder
            // picker triggers this; plain multi-file picks never touch the title.
            if (input === folderIn && folder && titleIn) titleIn.value = folder;
            if (!countEl) return;
            if (!input.files.length) { countEl.textContent = ''; return; }
            var label = input === folderIn && folder ? ' (pasta "' + folder + '")' : '';
            countEl.textContent = input.files.length + (input.files.length === 1 ? ' foto selecionada' : ' fotos selecionadas') + label;
        }

        [filesIn, folderIn].forEach(function (el) {
            if (el) el.addEventListener('change', function () { update(el); });
        });
    })();
</script>

@if (!Model.IsSession && !Model.BookingId.HasValue)
{
    <script>
        (function () {
            // Keep the "apply to all" form in sync with the price and the
            // "for sale" toggle of the upload form — one single place to set them.
            var uploadPrice = document.querySelector('form[action*="UploadPhotos"] input[name="price"]');
            var uploadForSale = document.querySelector('form[action*="UploadPhotos"] input[type="checkbox"][name="forSale"]');
            var applyPrice = document.getElementById('apply-all-price');
            var applyForSale = document.getElementById('apply-all-forsale');
            if (uploadPrice && applyPrice) {
                uploadPrice.addEventListener('input', function () { applyPrice.value = uploadPrice.value; });
            }
            if (uploadForSale && applyForSale) {
                uploadForSale.addEventListener('change', function () { applyForSale.value = uploadForSale.checked ? 'true' : 'false'; });
            }

            // ----- Per-photo selection: apply price to the selected photos only -----
            var checks = Array.from(document.querySelectorAll('.photo-check'));
            var selectAll = document.getElementById('photo-select-all');
            var bulkBar = document.getElementById('photo-bulk-bar');
            var countEl = document.getElementById('photo-selected-count');
            var bulkIds = document.getElementById('photo-bulk-ids');
            var bulkApply = document.getElementById('photo-bulk-apply');
            var bulkFree = document.getElementById('photo-bulk-free');
            var selectAllLabel = document.getElementById('photo-select-all-label');

            function refresh() {
                var selected = checks.filter(function (c) { return c.checked; }).map(function (c) { return c.value; });
                bulkIds.value = selected.join(',');
                countEl.textContent = selected.length > 0 ? selected.length : '';
                bulkBar.classList.toggle('hidden', selected.length === 0);
                bulkApply.disabled = selected.length === 0;
                bulkFree.disabled = selected.length === 0;
                selectAll.checked = checks.length > 0 && checks.every(function (c) { return c.checked; });
                selectAllLabel.textContent = selectAll.checked
                    ? "@SharedLocalizer["DeselectAll"]"
                    : "@SharedLocalizer["SelectAll"]";
            }
            checks.forEach(function (c) { c.addEventListener('change', refresh); });
            if (selectAll) {
                selectAll.addEventListener('change', function () {
                    checks.forEach(function (c) { c.checked = selectAll.checked; });
                    refresh();
                });
            }

            window.photoBulkSubmit = function (forSale) {
                bulkIds.value = checks.filter(function (c) { return c.checked; })
                    .map(function (c) { return c.value; }).join(',');
                document.getElementById('photo-bulk-forsale').value = forSale;
                return true;
            };
            refresh();
        })();
    </script>
}
